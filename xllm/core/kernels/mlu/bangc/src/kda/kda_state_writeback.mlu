#include <bang.h>
#include <cnrt.h>

#include <cstdint>

#include "kernels/mlu/bangc/src/kda/launch.h"

namespace xllm::kernel::mlu::bangc {
namespace {
constexpr int32_t kBlock = 32768;
constexpr int32_t kWritebackBlock = 32768;

__mlu_global__ void kda_state_writeback_fp32_bf16_kernel(const float* source,
                                                         bfloat16_t* cache,
                                                         const int32_t* indices,
                                                         int64_t rows,
                                                         int64_t width,
                                                         int64_t source_stride,
                                                         int64_t cache_stride,
                                                         int64_t cache_rows) {
  if (__is_mpu()) {
    return;
  }
  constexpr int32_t kIndexRows = 1024;
  __nram__ int32_t row_indices[kIndexRows];
  __nram__ float source_nram[2][kWritebackBlock];
  __nram__ bfloat16_t output_nram[2][kWritebackBlock];
  const int64_t tiles_per_row = (width + kWritebackBlock - 1) / kWritebackBlock;
  for (int64_t row_base = 0; row_base < rows; row_base += kIndexRows) {
    const int64_t chunk_rows =
        rows - row_base < kIndexRows ? rows - row_base : kIndexRows;
    __memcpy(row_indices,
             indices + row_base,
             chunk_rows * sizeof(int32_t),
             GDRAM2NRAM);
    __sync_io();
    const int64_t total_tiles = chunk_rows * tiles_per_row;
    int64_t tile = taskId;
    if (tile >= total_tiles) {
      continue;
    }
    int32_t current = 0;
    int64_t row = row_base + tile / tiles_per_row;
    int64_t start = (tile % tiles_per_row) * kWritebackBlock;
    int32_t size = static_cast<int32_t>(
        width - start < kWritebackBlock ? width - start : kWritebackBlock);
    if (row_indices[tile / tiles_per_row] > 0) {
      __memcpy_io1_async(source_nram[current],
                         source + row * source_stride + start,
                         size * sizeof(float),
                         GDRAM2NRAM);
    }
    __sync();
    for (; tile < total_tiles; tile += taskDim) {
      row = row_base + tile / tiles_per_row;
      start = (tile % tiles_per_row) * kWritebackBlock;
      size = static_cast<int32_t>(
          width - start < kWritebackBlock ? width - start : kWritebackBlock);
      const int32_t slot = row_indices[tile / tiles_per_row];
      const int64_t next_tile = tile + taskDim;
      if (next_tile < total_tiles &&
          row_indices[next_tile / tiles_per_row] > 0) {
        const int64_t next_row = row_base + next_tile / tiles_per_row;
        const int64_t next_start =
            (next_tile % tiles_per_row) * kWritebackBlock;
        const int32_t next_size = static_cast<int32_t>(
            width - next_start < kWritebackBlock ? width - next_start
                                                 : kWritebackBlock);
        __memcpy_io1_async(source_nram[current ^ 1],
                           source + next_row * source_stride + next_start,
                           next_size * sizeof(float),
                           GDRAM2NRAM);
      }
      // Slot 0 is the padding sentinel and a slot outside [1, cache_rows)
      // would address rows past the cache, so neither is written back.
      const bool writable = slot > 0 && slot < cache_rows;
      if (writable) {
        __bang_float2bfloat16_rn(
            output_nram[current], source_nram[current], size);
      }
      __sync();
      if (writable) {
        __memcpy_io0_async(
            cache + static_cast<int64_t>(slot) * cache_stride + start,
            output_nram[current],
            size * sizeof(bfloat16_t),
            NRAM2GDRAM);
      }
      current ^= 1;
    }
    __sync();
  }
}

__mlu_global__ void kda_state_writeback_kernel(const void* source,
                                               void* cache,
                                               const int32_t* indices,
                                               int64_t rows,
                                               int64_t width,
                                               int64_t source_stride,
                                               int64_t cache_stride,
                                               int64_t cache_rows,
                                               int32_t source_dtype,
                                               int32_t cache_dtype,
                                               int32_t tile_size) {
  if (__is_mpu()) {
    return;
  }
  __nram__ int32_t index;
  __nram__ uint32_t source_raw[kBlock];
  __nram__ uint32_t cache_raw[kBlock];
  __nram__ float source_float[kBlock];
  const int64_t tiles_per_row = (width + tile_size - 1) / tile_size;
  const int64_t total_tiles = rows * tiles_per_row;
  for (int64_t tile = taskId; tile < total_tiles; tile += taskDim) {
    const int64_t row = tile / tiles_per_row;
    __memcpy(&index, indices + row, sizeof(int32_t), GDRAM2NRAM);
    __sync_io();
    const int32_t slot = index;
    // Slot 0 is the padding sentinel; a slot outside [1, cache_rows) would
    // write past the cache.
    if (slot <= 0 || slot >= cache_rows) {
      continue;
    }
    const int64_t start = (tile % tiles_per_row) * tile_size;
    const int32_t size = static_cast<int32_t>(
        width - start < tile_size ? width - start : tile_size);
    const int32_t source_bytes = size * (source_dtype == kKdaFloat32 ? 4 : 2);
    const int32_t cache_bytes = size * (cache_dtype == kKdaFloat32 ? 4 : 2);
    const auto* source_tile =
        static_cast<const uint8_t*>(source) +
        (row * source_stride + start) * (source_dtype == kKdaFloat32 ? 4 : 2);
    auto* cache_tile = static_cast<uint8_t*>(cache) +
                       (static_cast<int64_t>(slot) * cache_stride + start) *
                           (cache_dtype == kKdaFloat32 ? 4 : 2);
    __memcpy(source_raw, source_tile, source_bytes, GDRAM2NRAM);
    __sync_io();
    if (source_dtype == cache_dtype) {
      __memcpy(cache_tile, source_raw, cache_bytes, NRAM2GDRAM);
    } else {
      if (source_dtype == kKdaFloat32) {
        __bang_float2bfloat16_rn(reinterpret_cast<bfloat16_t*>(cache_raw),
                                 reinterpret_cast<const float*>(source_raw),
                                 size);
      } else {
        __bang_bfloat162float(source_float,
                              reinterpret_cast<const bfloat16_t*>(source_raw),
                              size);
        __memcpy(cache_raw, source_float, size * sizeof(float), NRAM2NRAM);
      }
      __sync_compute();
      __memcpy(cache_tile, cache_raw, cache_bytes, NRAM2GDRAM);
    }
    __sync_io();
  }
}

int32_t cluster_count() {
  int32_t device = 0;
  int32_t clusters = 0;
  if (cnrtGetDevice(&device) != cnrtSuccess ||
      cnrtDeviceGetAttribute(&clusters, cnrtAttrClusterCount, device) !=
          cnrtSuccess ||
      clusters <= 0) {
    return 0;
  }
  return clusters;
}

int32_t active_clusters(int64_t work_items, int32_t available_clusters) {
  const int64_t needed = (work_items + 3) / 4;
  return static_cast<int32_t>(needed < available_clusters ? needed
                                                          : available_clusters);
}

}  // namespace

cnrtRet_t launch_kda_state_writeback(const void* source,
                                     void* cache,
                                     const int32_t* indices,
                                     int64_t rows,
                                     int64_t width,
                                     int64_t source_stride,
                                     int64_t cache_stride,
                                     int64_t cache_rows,
                                     int32_t source_dtype,
                                     int32_t cache_dtype,
                                     cnrtQueue_t queue) {
  const int32_t clusters = cluster_count();
  if (clusters == 0) {
    return cnrtErrorNoDevice;
  }
  if (rows == 0 || width == 0) {
    return cnrtSuccess;
  }
  if (source_dtype == kKdaFloat32 && cache_dtype == kKdaBFloat16) {
    const int32_t grid_clusters = active_clusters(
        rows * ((width + kWritebackBlock - 1) / kWritebackBlock), clusters);
    const cnrtDim3_t dim = {1, static_cast<uint32_t>(grid_clusters * 4), 1};
    kda_state_writeback_fp32_bf16_kernel<<<dim, cnrtFuncTypeBlock, queue>>>(
        static_cast<const float*>(source),
        static_cast<bfloat16_t*>(cache),
        indices,
        rows,
        width,
        source_stride,
        cache_stride,
        cache_rows);
    return cnrtGetLastError();
  }
  int32_t tile_size = kBlock;
  while (tile_size > 4096 &&
         rows * ((width + tile_size - 1) / tile_size) < clusters * 4) {
    tile_size /= 2;
  }
  const int32_t grid_clusters =
      active_clusters(rows * ((width + tile_size - 1) / tile_size), clusters);
  if (grid_clusters == 0) {
    return cnrtErrorNoDevice;
  }
  const cnrtDim3_t dim = {4, static_cast<uint32_t>(grid_clusters), 1};
  kda_state_writeback_kernel<<<dim, cnrtFuncTypeUnion1, queue>>>(source,
                                                                 cache,
                                                                 indices,
                                                                 rows,
                                                                 width,
                                                                 source_stride,
                                                                 cache_stride,
                                                                 cache_rows,
                                                                 source_dtype,
                                                                 cache_dtype,
                                                                 tile_size);
  return cnrtGetLastError();
}

}  // namespace xllm::kernel::mlu::bangc
