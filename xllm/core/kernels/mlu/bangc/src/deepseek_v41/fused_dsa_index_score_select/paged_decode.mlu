#pragma bang walign(16)
#include <bang.h>

#include <cstdlib>

#include "kernels/mlu/bangc/src/deepseek_v41/fused_dsa_index_score_select/compute_map16.h"
#include "kernels/mlu/bangc/src/deepseek_v41/fused_dsa_index_score_select/index_score_select.h"

namespace xllm::kernel::mlu::bangc::score_select {
namespace {

#define CARVE_FROM(cur, type, name, count)   \
  type* name = reinterpret_cast<type*>(cur); \
  cur += (((count) * sizeof(type)) + 63) / 64 * 64

constexpr int32_t kMaxPositionSentinel = 1 << 24;
constexpr int kSegTokCap = kPartCap;  // 1024
constexpr int kDecodeRowCacheCap = 256;
constexpr int kDecodeMaxFilterTeam = 16;

__mlu_func__ inline void InitIota64I(int32_t* p) {
  for (int i = 0; i < 16; ++i) p[i] = i;
  __sync_move();
  __bang_add_scalar(p + 16, p, 16, 16);
  __bang_add_scalar(p + 32, p, 32, 32);
}

__mlu_func__ inline void InitIota64F(float* p) {
  for (int i = 0; i < 16; ++i) p[i] = static_cast<float>(i);
  __sync_move();
  __bang_add_scalar(p + 16, p, 16.0f, 16);
  __bang_add_scalar(p + 32, p, 32.0f, 32);
}

__mlu_func__ inline void InitDecodeMetaConsts(float* c_iota64,
                                              float* c_pat64,
                                              int32_t* c_qbit16) {
  for (int i = 0; i < 16; ++i) {
    c_iota64[i] = static_cast<float>(i);
    c_pat64[i] = static_cast<float>(i & 7);
  }
  for (int q = 0; q < kDecodeSegQ; ++q) {
    c_qbit16[q] = 1 << q;
  }
  __sync_move();
  __bang_add_scalar(c_iota64 + 16, c_iota64, 16.0f, 16);
  __bang_add_scalar(c_iota64 + 32, c_iota64, 32.0f, 32);
  __bang_add_scalar(c_pat64 + 16, c_pat64, 0.0f, 16);
  __bang_add_scalar(c_pat64 + 32, c_pat64, 0.0f, 32);
}

__mlu_func__ int32_t FloatToKey(float f) {
  int32_t b = *reinterpret_cast<int32_t*>(&f);
  if ((b & 0x7fffffff) == 0) return 0;
  return b < 0 ? (b ^ 0x7fffffff) : b;
}

__mlu_func__ float KeyToFloat(int32_t k) {
  int32_t b = k < 0 ? (k ^ 0x7fffffff) : k;
  return *reinterpret_cast<float*>(&b);
}

struct Pool {
  float* val;
  int32_t* idx;
  int cnt;
  float tf;
  int k;
  int cap;
};

struct Scratch {
  float* m0;
  float* m1;
  float* m2;
  float* iota;
};

__mlu_func__ void PoolCompact(Pool& p,
                              const Scratch& s,
                              bool keep_vals = true) {
  __sync();
  const int n = p.cnt;
  __bang_argmin(s.m1, p.val, n);
  __bang_argmax(s.m2, p.val, n);
  __sync_compute();
  int64_t lo = FloatToKey(s.m1[0]);
  int64_t hi = static_cast<int64_t>(FloatToKey(s.m2[0])) + 1;
  bool exact_count = false;
  while (hi - lo > 1) {
    int64_t mid =
        lo + static_cast<int64_t>(static_cast<uint64_t>(hi - lo) >> 1);
    float t = KeyToFloat(static_cast<int32_t>(mid));
    __bang_ge_scalar(s.m0, p.val, t, n);
    const int count = static_cast<int>(__bang_count(s.m0, n));
    if (count >= p.k) {
      lo = mid;
      if (count == p.k) {
        exact_count = true;
        break;
      }
    } else {
      hi = mid;
    }
  }
  const float thr = KeyToFloat(static_cast<int32_t>(lo));
  if (!exact_count) {
    __bang_gt_scalar(s.m0, p.val, thr, n);
    const int greater = static_cast<int>(__bang_count(s.m0, n));
    const int need = p.k - greater;
    __bang_eq_scalar(s.m1, p.val, thr, n);
    __bang_filter(s.m2, s.iota, s.m1, n);
    __sync_compute();
    const float last_tie = s.m2[need - 1];
    __bang_le_scalar(s.m2, s.iota, last_tie, n);
    __bang_mul(s.m1, s.m1, s.m2, n);
    __bang_add(s.m0, s.m0, s.m1, n);
  }
  if (keep_vals) {
    __bang_filter(s.m1, p.val, s.m0, n);
    __bang_filter(reinterpret_cast<float*>(s.m2),
                  reinterpret_cast<float*>(p.idx),
                  s.m0,
                  n);
    __sync_compute();
    __bang_move(p.val, s.m1, p.k * sizeof(float));
    __bang_move(p.idx, s.m2, p.k * sizeof(int32_t));
    __sync();
  } else {
    __bang_filter(reinterpret_cast<float*>(s.m1),
                  reinterpret_cast<float*>(p.idx),
                  s.m0,
                  n);
    __sync_compute();
    __bang_move(p.idx, s.m1, p.k * sizeof(int32_t));
    __sync();
  }
  p.cnt = p.k;
  p.tf = thr;
}

__mlu_func__ void PoolOffer(Pool& p,
                            const float* score,
                            const int32_t* ids,
                            const float* reach,
                            int n,
                            float* mask,
                            const Scratch& s) {
  __bang_gt_scalar(mask, score, p.tf, n);
  if (reach != nullptr) __bang_mul(mask, mask, reach, n);
  if (p.cnt + n <= p.cap) {
    const int c =
        static_cast<int>(__bang_filter(p.val + p.cnt, score, mask, n));
    if (c > 0) {
      __bang_filter(reinterpret_cast<float*>(p.idx + p.cnt),
                    reinterpret_cast<const float*>(ids),
                    mask,
                    n);
      p.cnt += c;
    }
    return;
  }
  int c = static_cast<int>(__bang_count(mask, n));
  if (c == 0) return;
  if (p.cnt + c > p.cap) {
    PoolCompact(p, s);
    __bang_gt_scalar(mask, score, p.tf, n);
    if (reach != nullptr) __bang_mul(mask, mask, reach, n);
    c = static_cast<int>(__bang_count(mask, n));
    if (c == 0) return;
  }
  __bang_filter(p.val + p.cnt, score, mask, n);
  __bang_filter(reinterpret_cast<float*>(p.idx + p.cnt),
                reinterpret_cast<const float*>(ids),
                mask,
                n);
  p.cnt += c;
}

__mlu_func__ void MakeIotaF(float* p, int n) {
  if (n < 64) {
    for (int i = 0; i < n; ++i) p[i] = static_cast<float>(i);
    __sync();
    return;
  }
  InitIota64F(p);
  for (int len = 64; len < n; len *= 2) {
    const int step = (n - len) < len ? (n - len) : len;
    __bang_add_scalar(p + len, p, static_cast<float>(len), step);
  }
  __sync_compute();
}

__mlu_func__ void RowSums(float* dst, const float* src, int rows, int width) {
  for (int r = 0; r < rows; ++r) {
    dst[r] = __bang_sum(src + static_cast<int64_t>(r) * width, width);
  }
}

__mlu_func__ int32_t ReadableCount(int64_t qpos, int32_t hist_len, int ratio) {
  if (hist_len <= 0 || qpos < 0) return 0;
  const int64_t qp1 = qpos + 1;
  if (qp1 < ratio) return 0;
  const int64_t by_pos = (ratio == 2) ? (qp1 >> 1) : qp1;
  return by_pos < hist_len ? static_cast<int32_t>(by_pos) : hist_len;
}

__mlu_func__ int64_t CoreLo(int64_t total, int core, int cores) {
  if (total < (int64_t{1} << 24)) {
    return static_cast<int64_t>(
        (static_cast<uint32_t>(total) * static_cast<uint32_t>(core)) /
        static_cast<uint32_t>(cores));
  }
  return total * core / cores;
}

__mlu_func__ int CoreOf(int64_t i, int64_t total, int cores) {
  int c = (total < (int64_t{1} << 24))
              ? static_cast<int>(
                    (static_cast<uint32_t>(i) * static_cast<uint32_t>(cores)) /
                    static_cast<uint32_t>(total))
              : static_cast<int>(i * cores / total);
  while (c + 1 < cores && CoreLo(total, c + 1, cores) <= i) ++c;
  while (c > 0 && CoreLo(total, c, cores) > i) --c;
  return c;
}

// Collaborative fill of `-1` across all cores for output row range [r_begin,
// r_end). Lazily initializes `neg_ones` ONLY on cores that own >= 1 row.
__mlu_func__ void FillOutputRowsNegOne(const DecodeParams& params,
                                       int64_t r_begin,
                                       int64_t r_end,
                                       int32_t* neg_ones) {
  const int64_t count = r_end - r_begin;
  if (count <= 0) return;
  const int64_t lo = (count <= taskDim)
                         ? (taskId < count ? (r_begin + taskId) : r_end)
                         : (r_begin + CoreLo(count, taskId, taskDim));
  const int64_t hi = (count <= taskDim)
                         ? (taskId < count ? (r_begin + taskId + 1) : r_end)
                         : (r_begin + CoreLo(count, taskId + 1, taskDim));
  if (lo >= hi) return;
  const int neg_len = (params.mode == kSource) ? kBlocks : kTopk;
  __bang_write_value(neg_ones, neg_len, -1);
  __sync_compute();
  for (int64_t r = lo; r < hi; ++r) {
    __memcpy_async(params.topk_indices + r * kTopk,
                   neg_ones,
                   kTopk * sizeof(int32_t),
                   NRAM2GDRAM);
    if (params.mode == kSource) {
      __memcpy_async(params.candidate_ids_out + r * kBlocks,
                     neg_ones,
                     kBlocks * sizeof(int32_t),
                     NRAM2GDRAM);
    }
  }
  __sync_io();
}

struct PackedDecodeMetaBufs {
  int32_t* row_b;
  int32_t* row_n;
  int32_t* seg_b;
  int32_t* seg_min_n;
  int32_t* seg_max_n;
  int32_t* seg_row0;
  int32_t* seg_cum_nq;
  int32_t* seg_nq;
  DecodeSplitSeg* sp_nram;
  DecodeMergeHeader* hdr_stage;
  int32_t* meta_tmp;
  float* c_iota64;
  float* c_pat64;
  int32_t* c_qbit16;
  int num_segs;
  int max_seg_nq;
  int global_max_n;
  int total_tiles;
  int active_segs;
};

__mlu_func__ void CarvePackedDecodeMeta(int8_t* meta_base,
                                        PackedDecodeMetaBufs* out) {
  int8_t* cur = meta_base;
  CARVE_FROM(cur, int32_t, row_b, kDecodeRowCacheCap);
  CARVE_FROM(cur, int32_t, row_n, kDecodeRowCacheCap);
  CARVE_FROM(cur, int32_t, seg_b, kDecodeRowCacheCap);
  CARVE_FROM(cur, int32_t, seg_min_n, kDecodeRowCacheCap);
  CARVE_FROM(cur, int32_t, seg_max_n, kDecodeRowCacheCap);
  CARVE_FROM(cur, int32_t, seg_row0, kDecodeRowCacheCap);
  CARVE_FROM(cur, int32_t, seg_cum_nq, kDecodeRowCacheCap + 16);
  CARVE_FROM(cur, int32_t, seg_nq, kDecodeRowCacheCap);
  CARVE_FROM(cur, DecodeSplitSeg, sp_nram, 1);
  CARVE_FROM(cur, DecodeMergeHeader, hdr_stage, 1);
  CARVE_FROM(cur, int32_t, meta_tmp, 16);
  CARVE_FROM(cur, float, c_iota64, 64);
  CARVE_FROM(cur, float, c_pat64, 64);
  CARVE_FROM(cur, int32_t, c_qbit16, 16);
  *out = PackedDecodeMetaBufs{row_b,
                              row_n,
                              seg_b,
                              seg_min_n,
                              seg_max_n,
                              seg_row0,
                              seg_cum_nq,
                              seg_nq,
                              sp_nram,
                              hdr_stage,
                              meta_tmp,
                              c_iota64,
                              c_pat64,
                              c_qbit16,
                              0,
                              0,
                              0,
                              0,
                              0};
}

// Builds packed per-row and per-request segment metadata in NRAM for [0,
// v_rows) (0 < v_rows <= kDecodeRowCacheCap). Strictly reads ONLY
// query_batch_indices[0..v_rows-1], query_positions[0..v_rows-1], and
// history_lengths[b] for referenced request slots `b` (never touching >= v_rows
// or unreferenced request slots!).
__mlu_func__ inline int32_t ReadableCountFast32(int32_t qpos,
                                                int32_t hist_len,
                                                int ratio) {
  if (hist_len <= 0 || qpos < 0) return 0;
  const uint32_t qp1 = static_cast<uint32_t>(qpos) + 1u;
  if (qp1 < static_cast<uint32_t>(ratio)) return 0;
  const int32_t by_pos = static_cast<int32_t>((ratio == 2) ? (qp1 >> 1) : qp1);
  return by_pos < hist_len ? by_pos : hist_len;
}

__mlu_func__ void BuildPackedDecodeMeta(const DecodeParams& params,
                                        int v_rows,
                                        int tq,
                                        int32_t* scratch,
                                        PackedDecodeMetaBufs* meta,
                                        const float* prebuilt_iota256 = nullptr,
                                        bool preloaded_rows = false,
                                        bool preloaded_row_b = false) {
  if (!preloaded_rows && v_rows <= 28) {
    if (!preloaded_row_b) {
      __memcpy_async(meta->row_b,
                     params.query_batch_indices,
                     v_rows * sizeof(int32_t),
                     GDRAM2NRAM);
    }
    __memcpy_async(
        scratch, params.query_positions, v_rows * sizeof(int32_t), GDRAM2NRAM);
    __sync_io();
    preloaded_rows = true;
  }

  // Tier 1: Ultra-lean scalar fast path for tiny batches (v_rows <= 10) and
  // small multi-query / varlen runs (v_rows <= 28 with S >= 2 or varlen;
  // v_rows > 28 uses 64-wide vectorized Tier 2a/2b).
  if (v_rows <= 10 || (v_rows <= 28 && (v_rows > params.bcap ||
                                        meta->row_b[1] == meta->row_b[0]))) {
    int32_t* qpos_s = scratch;
    int32_t* hl_s = scratch + 64;
    int32_t* uniq_b = scratch + 128;
    int32_t* uniq_hl = scratch + 192;

    if (v_rows <= 10) {
      bool id_s1 = true;
      for (int r = 0; r < v_rows; ++r) {
        if (meta->row_b[r] != r) {
          id_s1 = false;
          break;
        }
      }
      if (id_s1) {
        __memcpy(uniq_hl,
                 params.history_lengths,
                 v_rows * sizeof(int32_t),
                 GDRAM2NRAM);
        __sync_io();
        int global_max_n = 0;
        int total_tiles = 0;
        int active_segs = 0;
        for (int r = 0; r < v_rows; ++r) {
          const int32_t nr =
              ReadableCountFast32(qpos_s[r], uniq_hl[r], params.ratio);
          meta->row_n[r] = nr;
          meta->seg_b[r] = r;
          meta->seg_row0[r] = r;
          meta->seg_nq[r] = 1;
          meta->seg_min_n[r] = nr;
          meta->seg_max_n[r] = nr;
          meta->seg_cum_nq[r] = r;
          if (nr > global_max_n) global_max_n = nr;
          if (nr > 0) {
            total_tiles += (nr + kTileSlots - 1) >> 8;
            ++active_segs;
          }
        }
        meta->seg_cum_nq[v_rows] = v_rows;
        meta->num_segs = v_rows;
        meta->max_seg_nq = 1;
        meta->global_max_n = global_max_n;
        meta->total_tiles = total_tiles;
        meta->active_segs = active_segs;
        __sync();
        return;
      }
    }

    int s0_u = 0;
    if (meta->row_b[0] == 0) {
      s0_u = 1;
      while (s0_u < v_rows && s0_u <= tq && meta->row_b[s0_u] == 0) ++s0_u;
    }
    if (s0_u >= 2 && s0_u <= tq && (v_rows % s0_u) == 0) {
      const int b_act = v_rows / s0_u;
      bool is_unif = true;
      for (int sg = 1; sg < b_act && is_unif; ++sg) {
        const int r0 = sg * s0_u;
        for (int q = 0; q < s0_u; ++q) {
          if (meta->row_b[r0 + q] != sg) {
            is_unif = false;
            break;
          }
        }
      }
      if (is_unif) {
        __memcpy_async(
            hl_s, params.history_lengths, b_act * sizeof(int32_t), GDRAM2NRAM);
        for (int sg = 0; sg < b_act; ++sg) {
          const int r0 = sg * s0_u;
          meta->seg_b[sg] = sg;
          meta->seg_row0[sg] = r0;
          meta->seg_nq[sg] = s0_u;
          meta->seg_cum_nq[sg] = r0;
        }
        meta->seg_cum_nq[b_act] = v_rows;
        __sync_io();
        int global_max_n = 0;
        int total_tiles = 0;
        int active_segs = 0;
        for (int sg = 0; sg < b_act; ++sg) {
          const int r0 = sg * s0_u;
          const int32_t hl = hl_s[sg];
          int32_t mn = 1 << 30;
          int32_t mx = 0;
          for (int q = 0; q < s0_u; ++q) {
            const int32_t nr =
                ReadableCountFast32(qpos_s[r0 + q], hl, params.ratio);
            meta->row_n[r0 + q] = nr;
            if (nr < mn) mn = nr;
            if (nr > mx) mx = nr;
          }
          meta->seg_min_n[sg] = mn;
          meta->seg_max_n[sg] = mx;
          if (mx > global_max_n) global_max_n = mx;
          if (mx > 0) {
            total_tiles += (mx + kTileSlots - 1) >> 8;
            ++active_segs;
          }
        }
        meta->num_segs = b_act;
        meta->max_seg_nq = s0_u;
        meta->global_max_n = global_max_n;
        meta->total_tiles = total_tiles;
        meta->active_segs = active_segs;
        __sync();
        return;
      }
    }

    int num_segs = 0;
    int max_seg_nq = 0;
    int uniq_cnt = 0;
    int32_t b_min = meta->row_b[0];
    int32_t b_max = b_min - 1;
    bool mono_contig = true;
    int32_t cum_q = 0;
    int r = 0;
    while (r < v_rows) {
      const int32_t b = meta->row_b[r];
      int u_idx = -1;
      if (b > b_max) {
        if (uniq_cnt > 0 && b != b_max + 1) mono_contig = false;
        b_max = b;
        u_idx = uniq_cnt++;
        uniq_b[u_idx] = b;
      } else {
        mono_contig = false;
        if (b < b_min) b_min = b;
        for (int u = 0; u < uniq_cnt; ++u) {
          if (uniq_b[u] == b) {
            u_idx = u;
            break;
          }
        }
        if (u_idx < 0) {
          u_idx = uniq_cnt++;
          uniq_b[u_idx] = b;
        }
      }
      int r_end = r + 1;
      while (r_end < v_rows && (r_end - r) < tq && meta->row_b[r_end] == b) {
        ++r_end;
      }
      const int nq = r_end - r;
      if (nq > max_seg_nq) max_seg_nq = nq;
      meta->seg_b[num_segs] = b;
      meta->seg_row0[num_segs] = r;
      meta->seg_nq[num_segs] = nq;
      meta->seg_min_n[num_segs] = u_idx;
      meta->seg_cum_nq[num_segs] = cum_q;
      cum_q += nq;
      ++num_segs;
      r = r_end;
    }
    meta->seg_cum_nq[num_segs] = cum_q;

    const int64_t b_span =
        static_cast<int64_t>(b_max) - static_cast<int64_t>(b_min) + 1;
    const int32_t* uhl = uniq_hl;
    if (b_span == uniq_cnt) {
      __memcpy(hl_s,
               params.history_lengths + b_min,
               uniq_cnt * sizeof(int32_t),
               GDRAM2NRAM);
      __sync_io();
      if (mono_contig) {
        uhl = hl_s;
      } else {
        for (int u = 0; u < uniq_cnt; ++u) {
          uniq_hl[u] = hl_s[uniq_b[u] - b_min];
        }
      }
    } else {
      for (int u = 0; u < uniq_cnt; ++u) {
        __memcpy_async(uniq_hl + u,
                       params.history_lengths + uniq_b[u],
                       sizeof(int32_t),
                       GDRAM2NRAM);
      }
      __sync_io();
    }

    int global_max_n = 0;
    int total_tiles = 0;
    int active_segs = 0;
    for (int sg = 0; sg < num_segs; ++sg) {
      const int r0 = meta->seg_row0[sg];
      const int nq = meta->seg_nq[sg];
      const int32_t hl = uhl[meta->seg_min_n[sg]];
      int32_t mn = 1 << 30;
      int32_t mx = 0;
      for (int q = 0; q < nq; ++q) {
        const int32_t nr =
            ReadableCountFast32(qpos_s[r0 + q], hl, params.ratio);
        meta->row_n[r0 + q] = nr;
        if (nr < mn) mn = nr;
        if (nr > mx) mx = nr;
      }
      meta->seg_min_n[sg] = mn;
      meta->seg_max_n[sg] = mx;
      if (mx > global_max_n) global_max_n = mx;
      if (mx > 0) {
        total_tiles += (mx + kTileSlots - 1) >> 8;
        ++active_segs;
      }
    }
    meta->num_segs = num_segs;
    meta->max_seg_nq = max_seg_nq;
    meta->global_max_n = global_max_n;
    meta->total_tiles = total_tiles;
    meta->active_segs = active_segs;
    __sync();
    return;
  }

  constexpr int kCap = kDecodeRowCacheCap;  // 256
  constexpr int kFastSlotSpan = 1024;
  const int vr64 = (v_rows + 63) / 64 * 64;

  int8_t* cur = reinterpret_cast<int8_t*>(scratch);
  CARVE_FROM(cur, int32_t, qpos_i, kCap);
  CARVE_FROM(cur, int32_t, qp1_i, kCap);
  CARVE_FROM(cur, int32_t, odd_i, kCap);
  CARVE_FROM(cur, int32_t, hl_row_i, kCap);
  CARVE_FROM(cur, int32_t, boff_row_i, kCap);
  CARVE_FROM(cur, int32_t, chg_i, kCap);
  CARVE_FROM(cur, int32_t, uniq_b, kCap);
  CARVE_FROM(cur, int32_t, uniq_hl, kCap);
  CARVE_FROM(cur, uint32_t, boff_b, kCap);
  CARVE_FROM(cur, int32_t, b_seen, kFastSlotSpan);
  CARVE_FROM(cur, int32_t, hl_span, kFastSlotSpan);
  CARVE_FROM(cur, float, qbf, kCap);
  CARVE_FROM(cur, float, qbf_next, kCap);
  CARVE_FROM(cur, float, diff_f, kCap);
  CARVE_FROM(cur, float, mask_f, kCap);
  CARVE_FROM(cur, float, iota_local_f, kCap);
  CARVE_FROM(cur, float, chg_f, kCap);
  CARVE_FROM(cur, float, hl_f, kCap);
  CARVE_FROM(cur, float, nf, kCap);
  CARVE_FROM(cur, float, zero_f, kCap);
  CARVE_FROM(cur, float, cap_f, kCap);

  if (!preloaded_rows) {
    if (!preloaded_row_b) {
      __memcpy_async(meta->row_b,
                     params.query_batch_indices,
                     v_rows * sizeof(int32_t),
                     GDRAM2NRAM);
    }
    __memcpy_async(
        qpos_i, params.query_positions, v_rows * sizeof(int32_t), GDRAM2NRAM);
  }

  const float* iota_f = prebuilt_iota256;
  if (iota_f == nullptr) {
    __memcpy(iota_local_f, meta->c_iota64, 64 * sizeof(float), NRAM2NRAM);
    __sync_move();
    if (vr64 > 64)
      __bang_add_scalar(iota_local_f + 64, iota_local_f, 64.0f, 64);
    if (vr64 > 128)
      __bang_add_scalar(iota_local_f + 128, iota_local_f, 128.0f, 128);
    iota_f = iota_local_f;
  }
  __bang_write_value(zero_f, vr64, 0.0f);
  __bang_write_value(cap_f, vr64, static_cast<float>(kMaxPositionSentinel));
  if (!preloaded_rows) {
    __sync_io();
  }

  const int32_t last_b = meta->row_b[v_rows - 1];
  const bool can_try_s1 = (v_rows <= params.bcap);
  for (int i = v_rows; i < vr64; ++i) {
    meta->row_b[i] = can_try_s1 ? i : last_b;
    qpos_i[i] = -1;
  }
  __sync();

  __bang_int322float(qbf, meta->row_b, vr64, 0);

  // Tier 2a: Identity S = 1 fast path (only possible when v_rows <= bcap)
  if (can_try_s1) {
    __bang_ne(diff_f, qbf, const_cast<float*>(iota_f), vr64);
    if (static_cast<int>(__bang_count(diff_f, vr64)) == 0) {
      __memcpy_async(hl_row_i,
                     params.history_lengths,
                     v_rows * sizeof(int32_t),
                     GDRAM2NRAM);
      for (int i = v_rows; i < vr64; ++i) hl_row_i[i] = 0;
      __sync();

      __bang_int322float(hl_f, hl_row_i, vr64, 0);
      __bang_minimum(hl_f, hl_f, cap_f, vr64);
      __bang_maximum(hl_f, hl_f, zero_f, vr64);
      __bang_add_scalar(qp1_i, qpos_i, 1, vr64);
      if (params.ratio == 2) {
        __bang_band_scalar(odd_i, qp1_i, 1, vr64);
        __bang_sub(qp1_i, qp1_i, odd_i, vr64);
        __bang_int322float(nf, qp1_i, vr64, 0);
        __bang_mul_scalar(nf, nf, 0.5f, vr64);
      } else {
        __bang_int322float(nf, qp1_i, vr64, 0);
      }
      __bang_minimum(nf, nf, hl_f, vr64);
      __bang_maximum(nf, nf, zero_f, vr64);
      __bang_float2int32(meta->row_n, nf, vr64, 0);
      __bang_float2int32(meta->seg_row0, const_cast<float*>(iota_f), vr64, 0);
      __bang_write_value(meta->seg_nq, vr64, 1);
      __bang_argmax(mask_f, nf, vr64);
      __bang_add_scalar(qp1_i, meta->row_n, kTileSlots - 1, vr64);
      __bang_band_scalar(qp1_i, qp1_i, ~(kTileSlots - 1), vr64);
      __bang_int322float(qbf, qp1_i, vr64, 0);
      __bang_mul_scalar(qbf, qbf, 1.0f / static_cast<float>(kTileSlots), vr64);
      __bang_gt_scalar(diff_f, qbf, 0.5f, vr64);
      const int active_segs = static_cast<int>(__bang_count(diff_f, vr64));
      const int total_tiles = static_cast<int>(__bang_sum(qbf, vr64));
      __sync_compute();

      __memcpy_async(
          meta->seg_b, meta->row_b, v_rows * sizeof(int32_t), NRAM2NRAM);
      __memcpy_async(
          meta->seg_min_n, meta->row_n, v_rows * sizeof(int32_t), NRAM2NRAM);
      __memcpy_async(
          meta->seg_max_n, meta->row_n, v_rows * sizeof(int32_t), NRAM2NRAM);
      __memcpy_async(meta->seg_cum_nq,
                     meta->seg_row0,
                     v_rows * sizeof(int32_t),
                     NRAM2NRAM);
      meta->seg_cum_nq[v_rows] = v_rows;
      meta->num_segs = v_rows;
      meta->max_seg_nq = 1;
      meta->global_max_n = static_cast<int>(mask_f[0]);
      meta->total_tiles = total_tiles;
      meta->active_segs = active_segs;
      __sync_move();
      return;
    }
  }

  // Tier 2b: Uniform contiguous [b_act, s0] fast path (2 <= s0 <= tq)
  int s0 = 0;
  if (meta->row_b[0] == 0) {
    s0 = 1;
    while (s0 < v_rows && s0 <= tq && meta->row_b[s0] == 0) ++s0;
  }
  if (s0 >= 2 && s0 <= tq && (v_rows % s0) == 0) {
    const int rem_len = v_rows - s0;
    bool uniform_s0 = true;
    if (rem_len > 0) {
      const int rem64 = (rem_len + 63) / 64 * 64;
      __memcpy(qbf_next, qbf + s0, rem_len * sizeof(float), NRAM2NRAM);
      for (int i = rem_len; i < rem64; ++i) {
        qbf_next[i] = qbf[i] + 1.0f;
      }
      __sync();
      __bang_sub(diff_f, qbf_next, qbf, rem64);
      __bang_ne_scalar(diff_f, diff_f, 1.0f, rem64);
      uniform_s0 = (static_cast<int>(__bang_count(diff_f, rem64)) == 0);
    }
    if (uniform_s0) {
      const int b_act = v_rows / s0;
      __memcpy(
          hl_span, params.history_lengths, b_act * sizeof(int32_t), GDRAM2NRAM);
      __sync_io();
      for (int sg = 0; sg < b_act; ++sg) {
        const int32_t hl_b = hl_span[sg];
        const int r0 = sg * s0;
        for (int q = 0; q < s0; ++q) hl_row_i[r0 + q] = hl_b;
      }
      for (int i = v_rows; i < vr64; ++i) hl_row_i[i] = 0;
      __sync();

      __bang_int322float(hl_f, hl_row_i, vr64, 0);
      __bang_minimum(hl_f, hl_f, cap_f, vr64);
      __bang_maximum(hl_f, hl_f, zero_f, vr64);
      __bang_add_scalar(qp1_i, qpos_i, 1, vr64);
      if (params.ratio == 2) {
        __bang_band_scalar(odd_i, qp1_i, 1, vr64);
        __bang_sub(qp1_i, qp1_i, odd_i, vr64);
        __bang_int322float(nf, qp1_i, vr64, 0);
        __bang_mul_scalar(nf, nf, 0.5f, vr64);
      } else {
        __bang_int322float(nf, qp1_i, vr64, 0);
      }
      __bang_minimum(nf, nf, hl_f, vr64);
      __bang_maximum(nf, nf, zero_f, vr64);
      __bang_float2int32(meta->row_n, nf, vr64, 0);
      __bang_argmax(mask_f, nf, vr64);
      __sync_compute();

      int total_tiles = 0;
      int active_segs = 0;
      for (int sg = 0; sg < b_act; ++sg) {
        const int r0 = sg * s0;
        int32_t mn = meta->row_n[r0];
        int32_t mx = meta->row_n[r0 + s0 - 1];
        if (mn > mx) {
          const int32_t t = mn;
          mn = mx;
          mx = t;
        }
        for (int q = 1; q + 1 < s0; ++q) {
          const int32_t v = meta->row_n[r0 + q];
          if (v < mn) mn = v;
          if (v > mx) mx = v;
        }
        meta->seg_b[sg] = sg;
        meta->seg_row0[sg] = r0;
        meta->seg_nq[sg] = s0;
        meta->seg_min_n[sg] = mn;
        meta->seg_max_n[sg] = mx;
        meta->seg_cum_nq[sg] = r0;
        if (mx > 0) {
          total_tiles += (mx + kTileSlots - 1) >> 8;
          ++active_segs;
        }
      }
      meta->seg_cum_nq[b_act] = v_rows;
      meta->num_segs = b_act;
      meta->max_seg_nq = s0;
      meta->global_max_n = static_cast<int>(mask_f[0]);
      meta->total_tiles = total_tiles;
      meta->active_segs = active_segs;
      __sync();
      return;
    }
  }

  // Tier 2c: Lean scalar varlen segment builder for medium varlen batches
  // (v_rows <= 96, e.g. B=8..16 varlen) avoiding Tier 3 gather/scatter!
  if (v_rows <= 96) {
    int num_segs = 0;
    int max_seg_nq = 0;
    int uniq_cnt = 0;
    int32_t b_min = meta->row_b[0];
    int32_t b_max = b_min - 1;
    bool mono_contig = true;
    int32_t cum_q = 0;
    int r = 0;
    while (r < v_rows) {
      const int32_t b = meta->row_b[r];
      int u_idx = -1;
      if (b > b_max) {
        if (uniq_cnt > 0 && b != b_max + 1) mono_contig = false;
        b_max = b;
        u_idx = uniq_cnt++;
        uniq_b[u_idx] = b;
      } else {
        mono_contig = false;
        if (b < b_min) b_min = b;
        for (int u = 0; u < uniq_cnt; ++u) {
          if (uniq_b[u] == b) {
            u_idx = u;
            break;
          }
        }
        if (u_idx < 0) {
          u_idx = uniq_cnt++;
          uniq_b[u_idx] = b;
        }
      }
      int r_end = r + 1;
      while (r_end < v_rows && (r_end - r) < tq && meta->row_b[r_end] == b) {
        ++r_end;
      }
      const int nq = r_end - r;
      if (nq > max_seg_nq) max_seg_nq = nq;
      meta->seg_b[num_segs] = b;
      meta->seg_row0[num_segs] = r;
      meta->seg_nq[num_segs] = nq;
      meta->seg_min_n[num_segs] = u_idx;
      meta->seg_cum_nq[num_segs] = cum_q;
      cum_q += nq;
      ++num_segs;
      r = r_end;
    }
    meta->seg_cum_nq[num_segs] = cum_q;

    const int64_t b_span =
        static_cast<int64_t>(b_max) - static_cast<int64_t>(b_min) + 1;
    const int32_t* uhl = uniq_hl;
    if (b_span == uniq_cnt) {
      __memcpy(hl_span,
               params.history_lengths + b_min,
               uniq_cnt * sizeof(int32_t),
               GDRAM2NRAM);
      __sync_io();
      if (mono_contig) {
        uhl = hl_span;
      } else {
        for (int u = 0; u < uniq_cnt; ++u) {
          uniq_hl[u] = hl_span[uniq_b[u] - b_min];
        }
      }
    } else {
      for (int u = 0; u < uniq_cnt; ++u) {
        __memcpy_async(uniq_hl + u,
                       params.history_lengths + uniq_b[u],
                       sizeof(int32_t),
                       GDRAM2NRAM);
      }
      __sync_io();
    }

    int global_max_n = 0;
    int total_tiles = 0;
    int active_segs = 0;
    for (int sg = 0; sg < num_segs; ++sg) {
      const int r0 = meta->seg_row0[sg];
      const int nq = meta->seg_nq[sg];
      const int32_t hl = uhl[meta->seg_min_n[sg]];
      int32_t mn = 1 << 30;
      int32_t mx = 0;
      for (int q = 0; q < nq; ++q) {
        const int32_t nr =
            ReadableCountFast32(qpos_i[r0 + q], hl, params.ratio);
        meta->row_n[r0 + q] = nr;
        if (nr < mn) mn = nr;
        if (nr > mx) mx = nr;
      }
      meta->seg_min_n[sg] = mn;
      meta->seg_max_n[sg] = mx;
      if (mx > global_max_n) global_max_n = mx;
      if (mx > 0) {
        total_tiles += (mx + kTileSlots - 1) >> 8;
        ++active_segs;
      }
    }
    meta->num_segs = num_segs;
    meta->max_seg_nq = max_seg_nq;
    meta->global_max_n = global_max_n;
    meta->total_tiles = total_tiles;
    meta->active_segs = active_segs;
    __sync();
    return;
  }

  if (can_try_s1 && vr64 > v_rows) {
    for (int i = v_rows; i < vr64; ++i) {
      meta->row_b[i] = last_b;
    }
    __sync();
    __bang_int322float(qbf, meta->row_b, vr64, 0);
  }

  // Tier 3: General vectorized varlen / multi-query segment builder
  __sync_compute();
  __memcpy(qbf_next, qbf + 1, (v_rows - 1) * sizeof(float), NRAM2NRAM);
  for (int i = v_rows - 1; i < vr64; ++i) qbf_next[i] = qbf[v_rows - 1];
  __sync();
  __bang_ne(diff_f, qbf_next, qbf, vr64);
  if (vr64 > v_rows) {
    __bang_lt_scalar(mask_f,
                     const_cast<float*>(iota_f),
                     static_cast<float>(v_rows - 1),
                     vr64);
    __bang_mul(diff_f, diff_f, mask_f, vr64);
  }
  const int n_chg = static_cast<int>(
      __bang_filter(chg_f, const_cast<float*>(iota_f), diff_f, vr64));
  if (n_chg > 0) {
    const int ncr = (n_chg + 63) / 64 * 64;
    __bang_float2int32(chg_i, chg_f, ncr, 0);
  }
  __sync_compute();

  int32_t b_min = meta->row_b[0];
  int32_t b_max = b_min;
  bool dense_0_to_k = (b_min == 0);
  if (n_chg > 0) {
    int ls = 0;
    for (int k = 0; k <= n_chg; ++k) {
      const int32_t b = meta->row_b[ls];
      if (b != k) dense_0_to_k = false;
      if (b < b_min) b_min = b;
      if (b > b_max) b_max = b;
      ls = (k < n_chg) ? (chg_i[k] + 1) : v_rows;
    }
  }
  const int64_t b_span =
      static_cast<int64_t>(b_max) - static_cast<int64_t>(b_min) + 1;
  const bool fast_span =
      (!dense_0_to_k && b_span > 0 && b_span <= kFastSlotSpan);
  if (fast_span) {
    const int span64 = (static_cast<int>(b_span) + 63) / 64 * 64;
    __bang_write_value(b_seen, span64, -1);
    __sync_compute();
  }

  int num_segs = 0;
  int max_seg_nq = 0;
  int uniq_cnt = dense_0_to_k ? (n_chg + 1) : 0;
  int32_t cum_q = 0;
  int ls = 0;
  for (int k = 0; k <= n_chg; ++k) {
    const int le = (k < n_chg) ? (chg_i[k] + 1) : v_rows;
    const int32_t b = meta->row_b[ls];
    int u_idx = k;
    if (!dense_0_to_k) {
      u_idx = -1;
      if (fast_span) {
        const int off = b - b_min;
        u_idx = b_seen[off];
        if (u_idx < 0) {
          u_idx = uniq_cnt++;
          b_seen[off] = u_idx;
          uniq_b[u_idx] = b;
        }
      } else {
        for (int u = 0; u < uniq_cnt; ++u) {
          if (uniq_b[u] == b) {
            u_idx = u;
            break;
          }
        }
        if (u_idx < 0) {
          u_idx = uniq_cnt++;
          uniq_b[u_idx] = b;
        }
      }
    }
    for (int r = ls; r < le; r += tq) {
      const int nq = (le - r) < tq ? (le - r) : tq;
      if (nq > max_seg_nq) max_seg_nq = nq;
      meta->seg_b[num_segs] = b;
      meta->seg_row0[num_segs] = r;
      meta->seg_nq[num_segs] = nq;
      meta->seg_min_n[num_segs] = u_idx;
      meta->seg_cum_nq[num_segs] = cum_q;
      cum_q += nq;
      ++num_segs;
    }
    ls = le;
  }
  meta->seg_cum_nq[num_segs] = cum_q;

  // Non-split FILTER union per-core early exit (e.g. hetero varlen B=32):
  // when 2 * num_segs > C, each core only ever executes s = taskId + k * C,
  // so populate only this core's own segment(s) and skip whole-batch vector
  // ops!
  if (params.mode == kFilter && params.plan.funion &&
      (params.plan.do_split == 0 || 2 * num_segs > params.plan.cores)) {
    meta->num_segs = num_segs;
    meta->max_seg_nq = max_seg_nq;
    if (taskId < params.plan.cores) {
      for (int sg = taskId; sg < num_segs; sg += params.plan.cores) {
        const int r0 = meta->seg_row0[sg];
        const int nq = meta->seg_nq[sg];
        const int b_sg = meta->seg_b[sg];
        __memcpy(uniq_hl,
                 params.history_lengths + b_sg,
                 sizeof(int32_t),
                 GDRAM2NRAM);
        __sync_io();
        const int32_t hl = uniq_hl[0];
        int32_t mn = 1 << 30;
        int32_t mx = 0;
        for (int q = 0; q < nq; ++q) {
          const int32_t nr =
              ReadableCountFast32(qpos_i[r0 + q], hl, params.ratio);
          meta->row_n[r0 + q] = nr;
          if (nr < mn) mn = nr;
          if (nr > mx) mx = nr;
        }
        meta->seg_min_n[sg] = mn;
        meta->seg_max_n[sg] = mx;
      }
    }
    __sync();
    return;
  }

  if (dense_0_to_k) {
    __memcpy_async(hl_span,
                   params.history_lengths,
                   uniq_cnt * sizeof(int32_t),
                   GDRAM2NRAM);
    __bang_mul_scalar(diff_f, qbf, static_cast<float>(sizeof(int32_t)), vr64);
    __bang_float2int32(boff_row_i, diff_f, vr64, 0);
    __sync();
    __gather(hl_row_i,
             hl_span,
             reinterpret_cast<uint32_t*>(boff_row_i),
             sizeof(int32_t),
             NRAM2NRAM,
             sizeof(int32_t),
             v_rows);
    for (int i = v_rows; i < vr64; ++i) hl_row_i[i] = 0;
    __sync();
  } else {
    if (b_span == uniq_cnt && fast_span) {
      __memcpy(hl_span,
               params.history_lengths + b_min,
               uniq_cnt * sizeof(int32_t),
               GDRAM2NRAM);
      __sync_io();
    } else {
      if (b_span * static_cast<int64_t>(sizeof(int32_t)) < (int64_t{1} << 31)) {
        for (int u = 0; u < uniq_cnt; ++u) {
          boff_b[u] =
              static_cast<uint32_t>(uniq_b[u] - b_min) * sizeof(int32_t);
        }
        __sync();
        __gather(uniq_hl,
                 params.history_lengths + b_min,
                 boff_b,
                 sizeof(int32_t),
                 GDRAM2NRAM,
                 sizeof(int32_t),
                 uniq_cnt);
        __sync_io();
      } else {
        for (int u = 0; u < uniq_cnt; ++u) {
          __memcpy_async(uniq_hl + u,
                         params.history_lengths + uniq_b[u],
                         sizeof(int32_t),
                         GDRAM2NRAM);
        }
        __sync_io();
      }
      if (fast_span) {
        for (int u = 0; u < uniq_cnt; ++u) {
          hl_span[uniq_b[u] - b_min] = uniq_hl[u];
        }
        __sync();
      }
    }

    if (fast_span) {
      __bang_sub_scalar(diff_f, qbf, static_cast<float>(b_min), vr64);
      __bang_mul_scalar(
          diff_f, diff_f, static_cast<float>(sizeof(int32_t)), vr64);
      __bang_float2int32(boff_row_i, diff_f, vr64, 0);
      __sync_compute();
      __gather(hl_row_i,
               hl_span,
               reinterpret_cast<uint32_t*>(boff_row_i),
               sizeof(int32_t),
               NRAM2NRAM,
               sizeof(int32_t),
               v_rows);
      for (int i = v_rows; i < vr64; ++i) hl_row_i[i] = 0;
      __sync();
    } else {
      for (int sg = 0; sg < num_segs; ++sg) {
        const int r0 = meta->seg_row0[sg];
        const int nq = meta->seg_nq[sg];
        const int32_t hv = uniq_hl[meta->seg_min_n[sg]];
        for (int q = 0; q < nq; ++q) hl_row_i[r0 + q] = hv;
      }
      for (int i = v_rows; i < vr64; ++i) hl_row_i[i] = 0;
      __sync();
    }
  }

  __bang_int322float(hl_f, hl_row_i, vr64, 0);
  __bang_minimum(hl_f, hl_f, cap_f, vr64);
  __bang_maximum(hl_f, hl_f, zero_f, vr64);
  __bang_add_scalar(qp1_i, qpos_i, 1, vr64);
  if (params.ratio == 2) {
    __bang_band_scalar(odd_i, qp1_i, 1, vr64);
    __bang_sub(qp1_i, qp1_i, odd_i, vr64);
    __bang_int322float(nf, qp1_i, vr64, 0);
    __bang_mul_scalar(nf, nf, 0.5f, vr64);
  } else {
    __bang_int322float(nf, qp1_i, vr64, 0);
  }
  __bang_minimum(nf, nf, hl_f, vr64);
  __bang_maximum(nf, nf, zero_f, vr64);
  __bang_float2int32(meta->row_n, nf, vr64, 0);
  __bang_argmax(mask_f, nf, vr64);
  __sync_compute();

  const int global_max_n = static_cast<int>(mask_f[0]);
  int total_tiles = 0;
  int active_segs = 0;
  for (int sg = 0; sg < num_segs; ++sg) {
    const int r0 = meta->seg_row0[sg];
    const int nq = meta->seg_nq[sg];
    int32_t mn = meta->row_n[r0];
    int32_t mx = mn;
    for (int q = 1; q < nq; ++q) {
      const int32_t nr = meta->row_n[r0 + q];
      if (nr < mn) mn = nr;
      if (nr > mx) mx = nr;
    }
    meta->seg_min_n[sg] = mn;
    meta->seg_max_n[sg] = mx;
    if (mx > 0) {
      total_tiles += (mx + kTileSlots - 1) >> 8;
      ++active_segs;
    }
  }
  meta->num_segs = num_segs;
  meta->max_seg_nq = max_seg_nq;
  meta->global_max_n = global_max_n;
  meta->total_tiles = total_tiles;
  meta->active_segs = active_segs;
}

struct DecodeSegBufs {
  bfloat16_t* kbf;     // [256 * 128]
  float* kf32;         // [256 * 128]
  float* ob;           // [256 * 64]
  float* tmp;          // [256 * 64]
  float* acc;          // [24 * 256] (scores + reach + sel)
  float* wv;           // [4 * 64]
  float* w_f32;        // [8 * 32]
  bfloat16_t* w_bf16;  // [8 * 32]
  int32_t* ids;        // [256]
  int32_t* iota_i;     // [256]
  float* iota_f256;    // [256]
  float* tfm;          // [8 * 256]
  float* rowc;         // [64]
  float* bm;           // [8 * 32]
  int32_t* blk_ids;    // [64]
  int32_t* blk_iota;   // [64]
  int32_t* page_tmp;   // [64]
  float* tok_val;      // [8 * 1024]
  int32_t* tok_idx;    // [8 * 1024]
  float* nram_bval;    // [4096] on-chip SOURCE block pool for nq == 1
  int32_t* nram_bidx;  // [4096] on-chip SOURCE block pool for nq == 1
  float* sc_iota;      // [4096]
  bfloat16_t* wram;    // Map16 WRAM
};

__mlu_func__ void LoadQueriesPairPacked(const bfloat16_t* query,
                                        const bfloat16_t* weights,
                                        int64_t row0,
                                        int nq,
                                        int logits_dtype,
                                        const DecodeSegBufs& m) {
  LoadQueriesMap16(m.wram, query + row0 * kHeads * kDim, nq, GDRAM2WRAM);
  __memcpy_async(m.w_bf16,
                 weights + row0 * kHeads,
                 nq * kHeads * sizeof(bfloat16_t),
                 GDRAM2NRAM);
  __sync_io();
  if (logits_dtype == kLogitsFp32) {
    __bang_bfloat162float(m.wv, m.w_bf16, nq * kHeads);
    __sync_compute();
  }
}

__mlu_func__ void ScoreDensePiece(const DecodeParams& params,
                                  const DecodeSegBufs& m,
                                  int b,
                                  int64_t row0,
                                  int nq,
                                  const int32_t* n_read_in,
                                  int seg_min_n,
                                  int seg_max_n,
                                  int tile_lo,
                                  int tile_hi,
                                  bool is_final,
                                  int slot_idx,
                                  int* defer_iota_cap = nullptr) {
  const auto& page = params.page;
  int32_t n_read[kDecodeSegQ];
  for (int q = 0; q < nq; ++q) {
    n_read[q] = n_read_in[q];
  }
  constexpr int N = kTileSlots;
  constexpr int kOnchipMultiBlkCap = kPagedBlkPoolCap / kDecodeSegQ;  // 512
  const int na = tile_hi - tile_lo;
  const bool source = params.mode == kSource;
  const bool onchip_source_blk = source && (nq == 1);
  const bool onchip_multi_blk =
      source && !onchip_source_blk && (na * 32 <= kOnchipMultiBlkCap);

  const bfloat16_t* query = static_cast<const bfloat16_t*>(params.query);
  const bfloat16_t* weights = static_cast<const bfloat16_t*>(params.weights);
  const bfloat16_t* paged_k = static_cast<const bfloat16_t*>(params.paged_k);
  const int32_t* table_b =
      params.paged_block_table + static_cast<int64_t>(b) * params.max_pages;

  const int piece_max_n = (tile_hi * N) < seg_max_n ? (tile_hi * N) : seg_max_n;
  const int max_piece_pages =
      (piece_max_n + page.rows - 1) >> (page.block_shift + 3);
  int cache_base = -1;
  int cache_end = -1;

  bfloat16_t* kbf0 = m.kbf;
  bfloat16_t* kbf1 = reinterpret_cast<bfloat16_t*>(m.kf32);
  float* qk_nram = m.kf32 + 16384;

  LoadQueriesMap16(m.wram, query + row0 * kHeads * kDim, nq, GDRAM2WRAM);
  __memcpy_async(m.w_bf16,
                 weights + row0 * kHeads,
                 nq * kHeads * sizeof(bfloat16_t),
                 GDRAM2NRAM);
  if (na > 0) {
    const int p_col0 = (tile_lo * N) >> (page.block_shift + 3);
    const int first_cnt =
        (max_piece_pages - p_col0) < 64 ? (max_piece_pages - p_col0) : 64;
    if (first_cnt > 0) {
      __memcpy_async(m.page_tmp,
                     table_b + p_col0,
                     first_cnt * sizeof(int32_t),
                     GDRAM2NRAM);
      cache_base = p_col0;
      cache_end = p_col0 + first_cnt;
    }
  }
  const int need_iota_cap =
      (source && !onchip_multi_blk && (!onchip_source_blk || na * 32 > kBlocks))
          ? kPagedBlkPoolCap
          : ((na * N > kTopk) ? kSegTokCap : N);
  if (defer_iota_cap != nullptr && *defer_iota_cap < need_iota_cap) {
    for (int len = *defer_iota_cap; len < need_iota_cap; len *= 2) {
      const int step =
          (need_iota_cap - len) < len ? (need_iota_cap - len) : len;
      __bang_add_scalar(
          m.sc_iota + len, m.sc_iota, static_cast<float>(len), step);
    }
    *defer_iota_cap = need_iota_cap;
  }
  __sync_io();
  if (params.logits_dtype == kLogitsFp32) {
    __bang_bfloat162float(m.wv, m.w_bf16, nq * kHeads);
  }

  if (na > 0) {
    LoadPagedDenseTile(params.page,
                       paged_k,
                       table_b,
                       seg_max_n,
                       max_piece_pages,
                       tile_lo * N,
                       kbf0,
                       m.page_tmp,
                       &cache_base,
                       &cache_end);
  }

  // Ultra-lean single-tile split-piece fast path for BOTH NONE and SOURCE
  // (covering both full tiles and the partial tail tile t = nt - 1):
  // eliminates straggler-core fallback on S > 1 tail tiles!
  if (na == 1 && !is_final) {
    const int c0 = tile_lo * N;
    const int n = (seg_max_n - c0) < N ? (seg_max_n - c0) : N;
    if (n > 0) {
      const int nco = (n + 63) / 64 * 64;
      const bool full_tok = (n == N) && (c0 + N <= seg_min_n);
      __sync();
      ScoreTileMap16<kDecodeSegQ>(m.acc,
                                  qk_nram,
                                  m.wram,
                                  kbf0,
                                  m.wv,
                                  m.w_bf16,
                                  nq,
                                  nco,
                                  params.logits_dtype);
      const int len = nq * nco;
      float* reach = m.acc + kDecodeSegQ * N;
      float* sel = m.acc + 2 * kDecodeSegQ * N;
      __bang_add_scalar(m.ids, m.iota_i, c0, N);
      __bang_gt_scalar(sel, m.acc, -INFINITY, len);

      int32_t* tok_cnt_g = reinterpret_cast<int32_t*>(
          params.workspace + params.plan.tok_part_cnt_offset);
      const int64_t base_item =
          static_cast<int64_t>(slot_idx) * kDecodeTokSlotStride;
      float* pv0 = reinterpret_cast<float*>(params.workspace +
                                            params.plan.tok_part_val_offset) +
                   base_item;
      int32_t* pi0 = reinterpret_cast<int32_t*>(
                         params.workspace + params.plan.tok_part_idx_offset) +
                     base_item;

      const bool all_finite = (static_cast<int>(__bang_count(sel, len)) == len);
      if (full_tok && all_finite) {
        for (int q = 0; q < nq; ++q) m.page_tmp[q] = N;
        if (source) {
          constexpr int nb_co = N / kBlockSize;  // 32
          const int rows_blk = nq * nb_co;
          const int b0 = c0 >> 3;
          float* tb = m.acc + kDecodeSegQ * N;
          __bang_transpose(tb, m.acc, rows_blk, kBlockSize);
          __bang_maximum(tb, tb, tb + 4 * rows_blk, 4 * rows_blk);
          __bang_maximum(tb, tb, tb + 2 * rows_blk, 2 * rows_blk);
          __bang_maximum(m.bm, tb, tb + rows_blk, rows_blk);
          __bang_add_scalar(m.blk_ids, m.blk_iota, b0, 64);
          __sync_compute();
          for (int q = 0; q < nq; ++q) {
            const int nw = (n_read[q] > 0) ? ((n_read[q] - 1) >> 3) : -1;
            if (nw >= b0 && nw < b0 + nb_co) {
              m.bm[q * nb_co + (nw - b0)] = INFINITY;
            }
            m.page_tmp[kDecodeSegQ + q] = nb_co;
          }
          __sync();
          int32_t* blk_cnt_g = reinterpret_cast<int32_t*>(
              params.workspace + params.plan.blk_part_cnt_offset);
          const int64_t bbase =
              static_cast<int64_t>(slot_idx) * kDecodeBlkSlotStride;
          float* bpv0 =
              reinterpret_cast<float*>(params.workspace +
                                       params.plan.blk_part_val_offset) +
              bbase;
          int32_t* bpi0 =
              reinterpret_cast<int32_t*>(params.workspace +
                                         params.plan.blk_part_idx_offset) +
              bbase;
          if (nq == 1) {
            __memcpy_async(bpv0, m.bm, nb_co * sizeof(float), NRAM2GDRAM);
          } else {
            __memcpy_async(bpv0,
                           m.bm,
                           nb_co * sizeof(float),
                           NRAM2GDRAM,
                           kBlocks * sizeof(float),
                           nb_co * sizeof(float),
                           nq - 1);
          }
          for (int q = 0; q < nq; ++q) {
            __memcpy_async(bpi0 + q * kBlocks,
                           m.blk_ids,
                           nb_co * sizeof(int32_t),
                           NRAM2GDRAM);
          }
          __memcpy_async(
              blk_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
              m.page_tmp + kDecodeSegQ,
              nq * sizeof(int32_t),
              NRAM2GDRAM);
        } else {
          __sync();
        }
        if (nq == 1) {
          __memcpy_async(pv0, m.acc, N * sizeof(float), NRAM2GDRAM);
        } else {
          __memcpy_async(pv0,
                         m.acc,
                         N * sizeof(float),
                         NRAM2GDRAM,
                         kTopk * sizeof(float),
                         N * sizeof(float),
                         nq - 1);
        }
        for (int q = 0; q < nq; ++q) {
          __memcpy_async(
              pi0 + q * kTopk, m.ids, N * sizeof(int32_t), NRAM2GDRAM);
        }
        __memcpy_async(tok_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                       m.page_tmp,
                       nq * sizeof(int32_t),
                       NRAM2GDRAM);
        __sync_io();
        return;
      }

      if (!all_finite) {
        for (int q = 0; q < nq; ++q) {
          const int rem = n_read[q] - c0;
          if (rem <= 0) {
            m.page_tmp[q] = 0;
            continue;
          }
          float* sel_q = sel + q * nco;
          if (rem < nco) {
            __bang_lt_scalar(reach, m.iota_f256, static_cast<float>(rem), nco);
            __bang_mul(sel_q, sel_q, reach, nco);
          }
          float* tv = m.tok_val + q * kSegTokCap;
          int32_t* ti = m.tok_idx + q * kSegTokCap;
          const int c =
              static_cast<int>(__bang_filter(tv, m.acc + q * nco, sel_q, nco));
          if (c > 0) {
            __bang_filter(reinterpret_cast<float*>(ti),
                          reinterpret_cast<const float*>(m.ids),
                          sel_q,
                          nco);
          }
          m.page_tmp[q] = c;
        }
      } else {
        for (int q = 0; q < nq; ++q) {
          const int rem = n_read[q] - c0;
          m.page_tmp[q] = rem <= 0 ? 0 : (rem < n ? rem : n);
        }
      }
      if (source) {
        const int nb_co = nco / kBlockSize;
        const int rows_blk = nq * nb_co;
        const int b0 = c0 >> 3;
        float* tb = m.acc + kDecodeSegQ * N;
        __bang_transpose(tb, m.acc, rows_blk, kBlockSize);
        __bang_maximum(tb, tb, tb + 4 * rows_blk, 4 * rows_blk);
        __bang_maximum(tb, tb, tb + 2 * rows_blk, 2 * rows_blk);
        __bang_maximum(m.bm, tb, tb + rows_blk, rows_blk);
        __bang_add_scalar(m.blk_ids, m.blk_iota, b0, 64);
        __sync_compute();
        for (int q = 0; q < nq; ++q) {
          const int nw = (n_read[q] > 0) ? ((n_read[q] - 1) >> 3) : -1;
          if (nw >= b0 && nw < b0 + nb_co) {
            m.bm[q * nb_co + (nw - b0)] = INFINITY;
          }
          const int max_rel = nw + 1 - b0;
          const int valid_b =
              max_rel <= 0 ? 0 : (max_rel > nb_co ? nb_co : max_rel);
          m.page_tmp[kDecodeSegQ + q] = valid_b;
        }
      }
      __sync();
      for (int q = 0; q < nq; ++q) {
        const int cnt = m.page_tmp[q];
        if (cnt > 0) {
          const float* src_v =
              all_finite ? (m.acc + q * nco) : (m.tok_val + q * kSegTokCap);
          const int32_t* src_i =
              all_finite ? m.ids : (m.tok_idx + q * kSegTokCap);
          __memcpy_async(
              pv0 + q * kTopk, src_v, cnt * sizeof(float), NRAM2GDRAM);
          __memcpy_async(
              pi0 + q * kTopk, src_i, cnt * sizeof(int32_t), NRAM2GDRAM);
        }
      }
      if (source) {
        const int nb_co = nco / kBlockSize;
        int32_t* blk_cnt_g = reinterpret_cast<int32_t*>(
            params.workspace + params.plan.blk_part_cnt_offset);
        const int64_t bbase =
            static_cast<int64_t>(slot_idx) * kDecodeBlkSlotStride;
        float* bpv0 = reinterpret_cast<float*>(
                          params.workspace + params.plan.blk_part_val_offset) +
                      bbase;
        int32_t* bpi0 =
            reinterpret_cast<int32_t*>(params.workspace +
                                       params.plan.blk_part_idx_offset) +
            bbase;
        for (int q = 0; q < nq; ++q) {
          const int vb = m.page_tmp[kDecodeSegQ + q];
          if (vb > 0) {
            __memcpy_async(bpv0 + q * kBlocks,
                           m.bm + q * nb_co,
                           vb * sizeof(float),
                           NRAM2GDRAM);
            __memcpy_async(bpi0 + q * kBlocks,
                           m.blk_ids,
                           vb * sizeof(int32_t),
                           NRAM2GDRAM);
          }
        }
        __memcpy_async(blk_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                       m.page_tmp + kDecodeSegQ,
                       nq * sizeof(int32_t),
                       NRAM2GDRAM);
      }
      __memcpy_async(tok_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                     m.page_tmp,
                     nq * sizeof(int32_t),
                     NRAM2GDRAM);
      __sync_io();
      return;
    }
  }

  // Ultra-lean two-tile (512 == kTopk) split-piece fast path for NONE mode:
  // overlaps Tile 1 K load + Tile 0 GDRAM emit with zero Pool/tok_val copies!
  if (na == 2 && !is_final && !source) {
    const int c0 = tile_lo * N;
    const int c1 = c0 + N;
    const int n1 = (seg_max_n - c1) < N ? (seg_max_n - c1) : N;
    if (n1 > 0) {
      int32_t* tok_cnt_g = reinterpret_cast<int32_t*>(
          params.workspace + params.plan.tok_part_cnt_offset);
      const int64_t base_item =
          static_cast<int64_t>(slot_idx) * kDecodeTokSlotStride;
      float* pv0 = reinterpret_cast<float*>(params.workspace +
                                            params.plan.tok_part_val_offset) +
                   base_item;
      int32_t* pi0 = reinterpret_cast<int32_t*>(
                         params.workspace + params.plan.tok_part_idx_offset) +
                     base_item;
      float* reach = m.acc + kDecodeSegQ * N;
      float* sel = m.acc + 2 * kDecodeSegQ * N;
      int cnt0[kDecodeSegQ];

      // Tile 0 (always full N slots since n1 > 0 => seg_max_n > c0 + N):
      __sync();
      LoadPagedDenseTile(params.page,
                         paged_k,
                         table_b,
                         seg_max_n,
                         max_piece_pages,
                         c1,
                         kbf1,
                         m.page_tmp,
                         &cache_base,
                         &cache_end);
      ScoreTileMap16<kDecodeSegQ>(m.acc,
                                  qk_nram,
                                  m.wram,
                                  kbf0,
                                  m.wv,
                                  m.w_bf16,
                                  nq,
                                  N,
                                  params.logits_dtype);
      const int len0 = nq * N;
      const bool full_tok0 = (c0 + N <= seg_min_n);
      __bang_add_scalar(m.ids, m.iota_i, c0, N);
      __bang_gt_scalar(sel, m.acc, -INFINITY, len0);

      if (full_tok0 && static_cast<int>(__bang_count(sel, len0)) == len0) {
        for (int q = 0; q < nq; ++q) cnt0[q] = N;
        __sync_compute();
        if (nq == 1) {
          __memcpy_async(pv0, m.acc, N * sizeof(float), NRAM2GDRAM);
        } else {
          __memcpy_async(pv0,
                         m.acc,
                         N * sizeof(float),
                         NRAM2GDRAM,
                         kTopk * sizeof(float),
                         N * sizeof(float),
                         nq - 1);
        }
        for (int q = 0; q < nq; ++q) {
          __memcpy_async(
              pi0 + q * kTopk, m.ids, N * sizeof(int32_t), NRAM2GDRAM);
        }
      } else {
        for (int q = 0; q < nq; ++q) {
          const int rem = n_read[q] - c0;
          if (rem <= 0) {
            cnt0[q] = 0;
            continue;
          }
          float* sel_q = sel + q * N;
          if (rem < N) {
            __bang_lt_scalar(reach, m.iota_f256, static_cast<float>(rem), N);
            __bang_mul(sel_q, sel_q, reach, N);
          }
          float* tv = m.tok_val + q * kSegTokCap;
          int32_t* ti = m.tok_idx + q * kSegTokCap;
          const int c =
              static_cast<int>(__bang_filter(tv, m.acc + q * N, sel_q, N));
          if (c > 0) {
            __bang_filter(reinterpret_cast<float*>(ti),
                          reinterpret_cast<const float*>(m.ids),
                          sel_q,
                          N);
          }
          cnt0[q] = c;
        }
        __sync();
        for (int q = 0; q < nq; ++q) {
          const int c = cnt0[q];
          if (c > 0) {
            __memcpy_async(pv0 + q * kTopk,
                           m.tok_val + q * kSegTokCap,
                           c * sizeof(float),
                           NRAM2GDRAM);
            __memcpy_async(pi0 + q * kTopk,
                           m.tok_idx + q * kSegTokCap,
                           c * sizeof(int32_t),
                           NRAM2GDRAM);
          }
        }
      }

      // Tile 1:
      const int nco1 = (n1 + 63) / 64 * 64;
      const bool full_tok1 = (n1 == N) && (c1 + N <= seg_min_n);
      __sync();
      ScoreTileMap16<kDecodeSegQ>(m.acc,
                                  qk_nram,
                                  m.wram,
                                  kbf1,
                                  m.wv,
                                  m.w_bf16,
                                  nq,
                                  nco1,
                                  params.logits_dtype);
      const int len1 = nq * nco1;
      __bang_add_scalar(m.ids, m.iota_i, c1, N);
      __bang_gt_scalar(sel, m.acc, -INFINITY, len1);

      bool all_c0_full = true;
      for (int q = 0; q < nq; ++q) {
        if (cnt0[q] != N) all_c0_full = false;
      }
      const bool all_finite1 =
          (static_cast<int>(__bang_count(sel, len1)) == len1);
      if (all_c0_full && full_tok1 && all_finite1) {
        for (int q = 0; q < nq; ++q) m.page_tmp[q] = 2 * N;
        __sync();
        if (nq == 1) {
          __memcpy_async(pv0 + N, m.acc, N * sizeof(float), NRAM2GDRAM);
        } else {
          __memcpy_async(pv0 + N,
                         m.acc,
                         N * sizeof(float),
                         NRAM2GDRAM,
                         kTopk * sizeof(float),
                         N * sizeof(float),
                         nq - 1);
        }
        for (int q = 0; q < nq; ++q) {
          __memcpy_async(
              pi0 + q * kTopk + N, m.ids, N * sizeof(int32_t), NRAM2GDRAM);
        }
        __memcpy_async(tok_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                       m.page_tmp,
                       nq * sizeof(int32_t),
                       NRAM2GDRAM);
        __sync_io();
        return;
      }

      if (!all_finite1) {
        for (int q = 0; q < nq; ++q) {
          const int rem = n_read[q] - c1;
          if (rem <= 0) {
            m.page_tmp[q] = cnt0[q];
            continue;
          }
          float* sel_q = sel + q * nco1;
          if (rem < nco1) {
            __bang_lt_scalar(reach, m.iota_f256, static_cast<float>(rem), nco1);
            __bang_mul(sel_q, sel_q, reach, nco1);
          }
          float* tv = m.tok_val + q * kSegTokCap;
          int32_t* ti = m.tok_idx + q * kSegTokCap;
          const int c = static_cast<int>(
              __bang_filter(tv, m.acc + q * nco1, sel_q, nco1));
          if (c > 0) {
            __bang_filter(reinterpret_cast<float*>(ti),
                          reinterpret_cast<const float*>(m.ids),
                          sel_q,
                          nco1);
          }
          m.page_tmp[q] = cnt0[q] + c;
        }
      } else {
        for (int q = 0; q < nq; ++q) {
          const int rem = n_read[q] - c1;
          const int c = rem <= 0 ? 0 : (rem < n1 ? rem : n1);
          m.page_tmp[q] = cnt0[q] + c;
        }
      }
      __sync();
      for (int q = 0; q < nq; ++q) {
        const int c1_q = m.page_tmp[q] - cnt0[q];
        if (c1_q > 0) {
          const float* src_v =
              all_finite1 ? (m.acc + q * nco1) : (m.tok_val + q * kSegTokCap);
          const int32_t* src_i =
              all_finite1 ? m.ids : (m.tok_idx + q * kSegTokCap);
          __memcpy_async(pv0 + q * kTopk + cnt0[q],
                         src_v,
                         c1_q * sizeof(float),
                         NRAM2GDRAM);
          __memcpy_async(pi0 + q * kTopk + cnt0[q],
                         src_i,
                         c1_q * sizeof(int32_t),
                         NRAM2GDRAM);
        }
      }
      __memcpy_async(tok_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                     m.page_tmp,
                     nq * sizeof(int32_t),
                     NRAM2GDRAM);
      __sync_io();
      return;
    }
  }

  Pool tok[kDecodeSegQ];
  for (int q = 0; q < nq; ++q) {
    tok[q] = Pool{m.tok_val + q * kSegTokCap,
                  m.tok_idx + q * kSegTokCap,
                  0,
                  -INFINITY,
                  kTopk,
                  kSegTokCap};
  }
  Scratch tok_scratch{
      m.ob, m.ob + kSegTokCap, m.ob + 2 * kSegTokCap, m.sc_iota};

  float* core_bval_base = nullptr;
  int32_t* core_bidx_base = nullptr;
  float* blk_tfm = m.w_f32;  // [8 * 32], dedicated to SOURCE block thresholds
  int blk_cnt[kDecodeSegQ];
  float blk_tf[kDecodeSegQ];
  int newest[kDecodeSegQ];
  int min_newest = 1 << 30;
  int max_newest = -1;
  bool blk_tfm_init = false;
  Pool blk_pool_1q{
      m.nram_bval, m.nram_bidx, 0, -INFINITY, kBlocks, kPagedBlkPoolCap};

  if (source) {
    if (!onchip_source_blk && !onchip_multi_blk) {
      const int64_t core_off =
          static_cast<int64_t>(taskId) * kDecodeCoreBlkStride;
      core_bval_base = reinterpret_cast<float*>(
                           params.workspace + params.plan.core_blk_val_offset) +
                       core_off;
      core_bidx_base = reinterpret_cast<int32_t*>(
                           params.workspace + params.plan.core_blk_idx_offset) +
                       core_off;
    }
    for (int q = 0; q < nq; ++q) {
      blk_cnt[q] = 0;
      blk_tf[q] = -INFINITY;
      const int nw = (n_read[q] > 0) ? ((n_read[q] - 1) >> 3) : -1;
      newest[q] = nw;
      if (nw >= 0) {
        if (nw < min_newest) min_newest = nw;
        if (nw > max_newest) max_newest = nw;
      }
    }
  }
  __sync();

  int tf_nco = 0;
  bool all_tf_neginf = true;
  bool same_tok_cnt = true;
  const bool direct_split_tok = (!is_final && na * N <= kTopk);
  const bool direct_split_blk = (!is_final && source && onchip_multi_blk);
  float* direct_pv0 =
      direct_split_tok
          ? (reinterpret_cast<float*>(params.workspace +
                                      params.plan.tok_part_val_offset) +
             static_cast<int64_t>(slot_idx) * kDecodeTokSlotStride)
          : nullptr;
  int32_t* direct_pi0 =
      direct_split_tok
          ? (reinterpret_cast<int32_t*>(params.workspace +
                                        params.plan.tok_part_idx_offset) +
             static_cast<int64_t>(slot_idx) * kDecodeTokSlotStride)
          : nullptr;
  float* direct_bpv0 =
      direct_split_blk
          ? (reinterpret_cast<float*>(params.workspace +
                                      params.plan.blk_part_val_offset) +
             static_cast<int64_t>(slot_idx) * kDecodeBlkSlotStride)
          : nullptr;
  int32_t* direct_bpi0 =
      direct_split_blk
          ? (reinterpret_cast<int32_t*>(params.workspace +
                                        params.plan.blk_part_idx_offset) +
             static_cast<int64_t>(slot_idx) * kDecodeBlkSlotStride)
          : nullptr;

  for (int i = 0; i < na; ++i) {
    const int t = tile_lo + i;
    const int c0 = t * N;
    const int n = (seg_max_n - c0) < N ? (seg_max_n - c0) : N;
    const int nco = (n + 63) / 64 * 64;

    if (i + 1 < na) {
      LoadPagedDenseTile(params.page,
                         paged_k,
                         table_b,
                         seg_max_n,
                         max_piece_pages,
                         (t + 1) * N,
                         ((i + 1) & 1) ? kbf1 : kbf0,
                         m.page_tmp,
                         &cache_base,
                         &cache_end);
    }

    ScoreTileMap16<kDecodeSegQ>(m.acc,
                                qk_nram,
                                m.wram,
                                (i & 1) ? kbf1 : kbf0,
                                m.wv,
                                m.w_bf16,
                                nq,
                                nco,
                                params.logits_dtype);

    // ---- Token Top-512 selection ----
    const bool full_tok = (n == N) && (c0 + nco <= seg_min_n);
    const int len = nq * nco;
    float* reach = m.acc + kDecodeSegQ * N;
    float* sel = m.acc + 2 * kDecodeSegQ * N;
    __bang_add_scalar(m.ids, m.iota_i, c0, N);
    const bool can_bulk_tok = full_tok && all_tf_neginf && same_tok_cnt &&
                              (tok[0].cnt + N <= kSegTokCap);
    bool did_bulk_tok = false;
    if (can_bulk_tok) {
      __bang_gt_scalar(sel, m.acc, -INFINITY, len);
      if (static_cast<int>(__bang_count(sel, len)) == len) {
        const int cnt0 = tok[0].cnt;
        __sync_compute();
        if (direct_split_tok) {
          if (nq == 1) {
            __memcpy_async(
                direct_pv0 + cnt0, m.acc, N * sizeof(float), NRAM2GDRAM);
          } else {
            __memcpy_async(direct_pv0 + cnt0,
                           m.acc,
                           N * sizeof(float),
                           NRAM2GDRAM,
                           kTopk * sizeof(float),
                           N * sizeof(float),
                           nq - 1);
          }
          for (int q = 0; q < nq; ++q) {
            __memcpy_async(direct_pi0 + q * kTopk + cnt0,
                           m.ids,
                           N * sizeof(int32_t),
                           NRAM2GDRAM);
            tok[q].cnt = cnt0 + N;
          }
        } else if (nq == 1) {
          __memcpy_async(
              tok[0].val + cnt0, m.acc, N * sizeof(float), NRAM2NRAM);
          __memcpy_async(
              tok[0].idx + cnt0, m.ids, N * sizeof(int32_t), NRAM2NRAM);
          tok[0].cnt = cnt0 + N;
          __sync_move();
        } else {
          __memcpy_async(tok[0].val + cnt0,
                         m.acc,
                         N * sizeof(float),
                         NRAM2NRAM,
                         kSegTokCap * sizeof(float),
                         N * sizeof(float),
                         nq - 1);
          __memcpy_async(tok[0].idx + cnt0,
                         m.ids,
                         N * sizeof(int32_t),
                         NRAM2NRAM,
                         kSegTokCap * sizeof(int32_t),
                         0,
                         nq - 1);
          for (int q = 0; q < nq; ++q) {
            tok[q].cnt = cnt0 + N;
          }
          __sync_move();
        }
        did_bulk_tok = true;
      }
    }
    if (!did_bulk_tok) {
      same_tok_cnt = false;
      if (all_tf_neginf) {
        __bang_gt_scalar(sel, m.acc, -INFINITY, len);
      } else {
        if (nco != tf_nco) {
          for (int q = 0; q < nq; ++q) {
            __bang_write_value(m.tfm + q * nco, nco, tok[q].tf);
          }
          tf_nco = nco;
        }
        __bang_gt(sel, m.acc, m.tfm, len);
      }
      if (!full_tok) {
        for (int q = 0; q < nq; ++q) {
          const int rem = n_read[q] - c0;
          __bang_lt_scalar(
              reach + q * nco, m.iota_f256, static_cast<float>(rem), nco);
        }
        __bang_mul(sel, sel, reach, len);
      }
      bool all_fit = true;
      for (int q = 0; q < nq; ++q) {
        if (tok[q].cnt + nco > tok[q].cap) {
          all_fit = false;
          break;
        }
      }
      if (all_fit) {
        for (int q = 0; q < nq; ++q) {
          Pool& p = tok[q];
          float* sel_q = sel + q * nco;
          const int prev_c = p.cnt;
          const int c = static_cast<int>(
              __bang_filter(p.val + prev_c, m.acc + q * nco, sel_q, nco));
          if (c > 0) {
            __bang_filter(reinterpret_cast<float*>(p.idx + prev_c),
                          reinterpret_cast<const float*>(m.ids),
                          sel_q,
                          nco);
            p.cnt = prev_c + c;
            if (direct_split_tok) {
              __sync_compute();
              __memcpy_async(direct_pv0 + q * kTopk + prev_c,
                             p.val + prev_c,
                             c * sizeof(float),
                             NRAM2GDRAM);
              __memcpy_async(direct_pi0 + q * kTopk + prev_c,
                             p.idx + prev_c,
                             c * sizeof(int32_t),
                             NRAM2GDRAM);
            }
          }
        }
      } else if (__bang_count(sel, len) > 0) {
        RowSums(m.rowc, sel, nq, nco);
        for (int q = 0; q < nq; ++q) {
          int c = static_cast<int>(m.rowc[q]);
          if (c == 0) continue;
          Pool& p = tok[q];
          float* score_q = m.acc + q * nco;
          float* sel_q = sel + q * nco;
          if (p.cnt + c > p.cap) {
            PoolCompact(p, tok_scratch);
            if (all_tf_neginf) {
              all_tf_neginf = false;
              for (int qq = 0; qq < nq; ++qq) {
                __bang_write_value(m.tfm + qq * nco, nco, tok[qq].tf);
              }
              tf_nco = nco;
            } else {
              __bang_write_value(m.tfm + q * nco, nco, p.tf);
            }
            __bang_gt_scalar(sel_q, score_q, p.tf, nco);
            if (!full_tok) __bang_mul(sel_q, sel_q, reach + q * nco, nco);
            c = static_cast<int>(__bang_count(sel_q, nco));
            if (c == 0) continue;
          }
          __bang_filter(p.val + p.cnt, score_q, sel_q, nco);
          __bang_filter(reinterpret_cast<float*>(p.idx + p.cnt),
                        reinterpret_cast<const float*>(m.ids),
                        sel_q,
                        nco);
          p.cnt += c;
        }
      }
    }

    // ---- SOURCE Streaming Block Top-2048 selection ----
    if (source) {
      const int nb_co = nco / kBlockSize;
      const int rows_blk = nq * nb_co;
      const int b0 = c0 / kBlockSize;
      float* tb = m.acc + kDecodeSegQ * N;
      __bang_transpose(tb, m.acc, rows_blk, kBlockSize);
      __bang_maximum(tb, tb, tb + 4 * rows_blk, 4 * rows_blk);
      __bang_maximum(tb, tb, tb + 2 * rows_blk, 2 * rows_blk);
      __bang_maximum(m.bm, tb, tb + rows_blk, rows_blk);
      if (b0 <= max_newest && b0 + nb_co > min_newest) {
        __sync_compute();
        for (int q = 0; q < nq; ++q) {
          const int nw = newest[q];
          if (nw >= b0 && nw < b0 + nb_co) {
            m.bm[q * nb_co + (nw - b0)] = INFINITY;
          }
        }
        __sync();
      }

      Scratch blk_scratch_1q{m.ob, m.ob + 4096, m.tmp, m.sc_iota};
      if (onchip_source_blk) {
        // 100% NRAM on-chip Top-2048 block pool for S = 1 (zero GDRAM traffic!)
        const int max_rel = newest[0] + 1 - b0;
        const int valid_b =
            max_rel <= 0 ? 0 : (max_rel > nb_co ? nb_co : max_rel);
        if (valid_b > 0) {
          __bang_add_scalar(m.blk_ids, m.blk_iota, b0, 64);
          float* b_score_pad = m.acc + kDecodeSegQ * N;  // [64]
          float* b_reach = b_score_pad + 64;             // [64]
          float* b_mask = b_score_pad + 128;             // [64]
          if (valid_b == 32 && nb_co == 32) {
            if (did_bulk_tok && blk_pool_1q.tf == -INFINITY &&
                blk_pool_1q.cnt + 32 <= blk_pool_1q.cap) {
              __sync_compute();
              __memcpy_async(blk_pool_1q.val + blk_pool_1q.cnt,
                             m.bm,
                             32 * sizeof(float),
                             NRAM2NRAM);
              __memcpy_async(blk_pool_1q.idx + blk_pool_1q.cnt,
                             m.blk_ids,
                             32 * sizeof(int32_t),
                             NRAM2NRAM);
              blk_pool_1q.cnt += 32;
              __sync_move();
            } else {
              // Fast 32-element offer without 64-padding copy
              PoolOffer(blk_pool_1q,
                        m.bm,
                        m.blk_ids,
                        nullptr,
                        32,
                        b_mask,
                        blk_scratch_1q);
            }
          } else {
            __bang_write_value(b_score_pad, 64, -INFINITY);
            __sync_compute();
            __memcpy(b_score_pad, m.bm, valid_b * sizeof(float), NRAM2NRAM);
            __sync();
            __bang_lt_scalar(
                b_reach, m.iota_f256, static_cast<float>(valid_b), 64);
            PoolOffer(blk_pool_1q,
                      b_score_pad,
                      m.blk_ids,
                      b_reach,
                      64,
                      b_mask,
                      blk_scratch_1q);
          }
        }
      } else if (onchip_multi_blk) {
        // 100% NRAM on-chip block buffer (or direct 2D GDRAM emit when
        // !is_final)
        __bang_add_scalar(m.blk_ids, m.blk_iota, b0, 64);
        __sync_compute();
        if (direct_split_blk) {
          bool same_b = (full_tok && nb_co == 32);
          if (same_b) {
            for (int q = 1; q < nq; ++q) {
              if (blk_cnt[q] != blk_cnt[0]) same_b = false;
            }
          }
          if (same_b) {
            const int bc0 = blk_cnt[0];
            __memcpy_async(direct_bpv0 + bc0,
                           m.bm,
                           32 * sizeof(float),
                           NRAM2GDRAM,
                           kBlocks * sizeof(float),
                           32 * sizeof(float),
                           nq - 1);
            for (int q = 0; q < nq; ++q) {
              __memcpy_async(direct_bpi0 + q * kBlocks + bc0,
                             m.blk_ids,
                             32 * sizeof(int32_t),
                             NRAM2GDRAM);
              blk_cnt[q] = bc0 + 32;
            }
          } else {
            for (int q = 0; q < nq; ++q) {
              const int max_rel = newest[q] + 1 - b0;
              const int valid_b =
                  max_rel <= 0 ? 0 : (max_rel > nb_co ? nb_co : max_rel);
              if (valid_b <= 0) continue;
              const int bc = blk_cnt[q];
              __memcpy_async(direct_bpv0 + q * kBlocks + bc,
                             m.bm + q * nb_co,
                             valid_b * sizeof(float),
                             NRAM2GDRAM);
              __memcpy_async(direct_bpi0 + q * kBlocks + bc,
                             m.blk_ids,
                             valid_b * sizeof(int32_t),
                             NRAM2GDRAM);
              blk_cnt[q] = bc + valid_b;
            }
          }
        } else {
          for (int q = 0; q < nq; ++q) {
            const int max_rel = newest[q] + 1 - b0;
            const int valid_b =
                max_rel <= 0 ? 0 : (max_rel > nb_co ? nb_co : max_rel);
            if (valid_b <= 0) continue;
            float* dst_v = m.nram_bval + q * kOnchipMultiBlkCap + blk_cnt[q];
            int32_t* dst_i = m.nram_bidx + q * kOnchipMultiBlkCap + blk_cnt[q];
            __memcpy_async(
                dst_v, m.bm + q * nb_co, valid_b * sizeof(float), NRAM2NRAM);
            __memcpy_async(
                dst_i, m.blk_ids, valid_b * sizeof(int32_t), NRAM2NRAM);
            blk_cnt[q] += valid_b;
          }
        }
      } else {
        float* pool_v_nram = m.ob;  // [4096]
        int32_t* pool_i_nram =
            reinterpret_cast<int32_t*>(m.ob + 4096);  // [4096]
        Scratch blk_scratch{m.ob + 8192, m.ob + 12288, m.tmp, m.sc_iota};

        if (nb_co == 32) {
          if (!blk_tfm_init) {
            for (int q = 0; q < nq; ++q) {
              __bang_write_value(blk_tfm + q * 32, 32, blk_tf[q]);
            }
            blk_tfm_init = true;
          }
          float* b_reach_all = m.acc + kDecodeSegQ * N;       // [nq * 32]
          float* b_sel_all = b_reach_all + kDecodeSegQ * 32;  // [nq * 32]
          if (!full_tok) {
            for (int q = 0; q < nq; ++q) {
              const int max_rel = newest[q] + 1 - b0;
              const int valid_b =
                  max_rel <= 0 ? 0 : (max_rel > 32 ? 32 : max_rel);
              __bang_lt_scalar(b_reach_all + q * 32,
                               m.iota_f256,
                               static_cast<float>(valid_b),
                               32);
            }
          }
          __bang_gt(b_sel_all, m.bm, blk_tfm, rows_blk);
          if (!full_tok)
            __bang_mul(b_sel_all, b_sel_all, b_reach_all, rows_blk);
          if (__bang_count(b_sel_all, rows_blk) > 0) {
            __bang_add_scalar(m.blk_ids, m.blk_iota, b0, 64);
            float* b_filt_all = b_sel_all + kDecodeSegQ * 32;
            int32_t* b_fidx_all =
                reinterpret_cast<int32_t*>(b_filt_all + kDecodeSegQ * 32);
            bool wrote_async = false;
            for (int q = 0; q < nq; ++q) {
              float* bm_q = m.bm + q * 32;
              float* bsel_q = b_sel_all + q * 32;
              int cb = static_cast<int>(__bang_count(bsel_q, 32));
              if (cb == 0) continue;

              float* gv = core_bval_base + q * kPagedBlkPoolCap;
              int32_t* gi = core_bidx_base + q * kPagedBlkPoolCap;
              if (blk_cnt[q] + cb > kPagedBlkPoolCap) {
                if (wrote_async) {
                  __sync_io();
                  wrote_async = false;
                }
                __memcpy(
                    pool_v_nram, gv, blk_cnt[q] * sizeof(float), GDRAM2NRAM);
                __memcpy(
                    pool_i_nram, gi, blk_cnt[q] * sizeof(int32_t), GDRAM2NRAM);
                __sync();
                Pool bp{pool_v_nram,
                        pool_i_nram,
                        blk_cnt[q],
                        blk_tf[q],
                        kBlocks,
                        kPagedBlkPoolCap};
                PoolCompact(bp, blk_scratch);
                __memcpy(gv, pool_v_nram, kBlocks * sizeof(float), NRAM2GDRAM);
                __memcpy(
                    gi, pool_i_nram, kBlocks * sizeof(int32_t), NRAM2GDRAM);
                __sync();
                blk_cnt[q] = kBlocks;
                blk_tf[q] = bp.tf;
                __bang_write_value(blk_tfm + q * 32, 32, blk_tf[q]);

                __bang_gt_scalar(bsel_q, bm_q, blk_tf[q], 32);
                if (!full_tok) {
                  __bang_mul(bsel_q, bsel_q, b_reach_all + q * 32, 32);
                }
                cb = static_cast<int>(__bang_count(bsel_q, 32));
                if (cb == 0) continue;
              }
              float* fv_q = b_filt_all + q * 32;
              int32_t* fi_q = b_fidx_all + q * 32;
              __bang_filter(fv_q, bm_q, bsel_q, 32);
              __bang_filter(reinterpret_cast<float*>(fi_q),
                            reinterpret_cast<const float*>(m.blk_ids),
                            bsel_q,
                            32);
              __sync_compute();
              __memcpy_async(
                  gv + blk_cnt[q], fv_q, cb * sizeof(float), NRAM2GDRAM);
              __memcpy_async(
                  gi + blk_cnt[q], fi_q, cb * sizeof(int32_t), NRAM2GDRAM);
              wrote_async = true;
              blk_cnt[q] += cb;
            }
            if (wrote_async) __sync_io();
          }
        } else {
          __bang_add_scalar(m.blk_ids, m.blk_iota, b0, 64);
          float* b_score_pad = m.acc + kDecodeSegQ * N;
          float* b_mask = b_score_pad + 64;
          float* b_reach = b_score_pad + 128;
          float* b_filt_val = b_score_pad + 192;
          int32_t* b_filt_idx =
              reinterpret_cast<int32_t*>(b_filt_val + kDecodeSegQ * 64);

          bool wrote_async = false;
          for (int q = 0; q < nq; ++q) {
            const int max_rel = newest[q] + 1 - b0;
            const int valid_b =
                max_rel <= 0 ? 0 : (max_rel > nb_co ? nb_co : max_rel);
            if (valid_b <= 0) continue;

            __bang_write_value(b_score_pad, 64, -INFINITY);
            __sync_compute();
            __memcpy(b_score_pad,
                     m.bm + q * nb_co,
                     valid_b * sizeof(float),
                     NRAM2NRAM);
            __sync();
            __bang_lt_scalar(
                b_reach, m.iota_f256, static_cast<float>(valid_b), 64);
            __bang_gt_scalar(b_mask, b_score_pad, blk_tf[q], 64);
            __bang_mul(b_mask, b_mask, b_reach, 64);
            int cb = static_cast<int>(__bang_count(b_mask, 64));
            if (cb == 0) continue;

            float* gv = core_bval_base + q * kPagedBlkPoolCap;
            int32_t* gi = core_bidx_base + q * kPagedBlkPoolCap;
            if (blk_cnt[q] + cb > kPagedBlkPoolCap) {
              if (wrote_async) {
                __sync_io();
                wrote_async = false;
              }
              __memcpy(pool_v_nram, gv, blk_cnt[q] * sizeof(float), GDRAM2NRAM);
              __memcpy(
                  pool_i_nram, gi, blk_cnt[q] * sizeof(int32_t), GDRAM2NRAM);
              __sync();
              Pool bp{pool_v_nram,
                      pool_i_nram,
                      blk_cnt[q],
                      blk_tf[q],
                      kBlocks,
                      kPagedBlkPoolCap};
              PoolCompact(bp, blk_scratch);
              __memcpy(gv, pool_v_nram, kBlocks * sizeof(float), NRAM2GDRAM);
              __memcpy(gi, pool_i_nram, kBlocks * sizeof(int32_t), NRAM2GDRAM);
              __sync();
              blk_cnt[q] = kBlocks;
              blk_tf[q] = bp.tf;
              if (blk_tfm_init) {
                __bang_write_value(blk_tfm + q * 32, 32, blk_tf[q]);
              }
              __bang_gt_scalar(b_mask, b_score_pad, blk_tf[q], 64);
              __bang_mul(b_mask, b_mask, b_reach, 64);
              cb = static_cast<int>(__bang_count(b_mask, 64));
              if (cb == 0) continue;
            }
            float* fv_q = b_filt_val + q * 64;
            int32_t* fi_q = b_filt_idx + q * 64;
            __bang_filter(fv_q, b_score_pad, b_mask, 64);
            __bang_filter(reinterpret_cast<float*>(fi_q),
                          reinterpret_cast<const float*>(m.blk_ids),
                          b_mask,
                          64);
            __sync_compute();
            __memcpy_async(
                gv + blk_cnt[q], fv_q, cb * sizeof(float), NRAM2GDRAM);
            __memcpy_async(
                gi + blk_cnt[q], fi_q, cb * sizeof(int32_t), NRAM2GDRAM);
            wrote_async = true;
            blk_cnt[q] += cb;
          }
          if (wrote_async) __sync_io();
        }
      }
    }
    __sync();
  }
  __sync();

  for (int q = 0; q < nq; ++q) {
    if (tok[q].cnt > kTopk) PoolCompact(tok[q], tok_scratch, !is_final);
  }
  int32_t* out32 = reinterpret_cast<int32_t*>(m.kf32);
  if (is_final) {
    bool all_full_topk = true;
    for (int q = 0; q < nq; ++q) {
      if (tok[q].cnt != kTopk) {
        all_full_topk = false;
        break;
      }
    }
    if (all_full_topk) {
      __sync();
      if (nq == 1) {
        __memcpy(params.topk_indices + row0 * kTopk,
                 tok[0].idx,
                 kTopk * sizeof(int32_t),
                 NRAM2GDRAM);
      } else {
        __memcpy(out32,
                 tok[0].idx,
                 kTopk * sizeof(int32_t),
                 NRAM2NRAM,
                 kTopk * sizeof(int32_t),
                 kSegTokCap * sizeof(int32_t),
                 nq - 1);
        __sync_move();
        __memcpy(params.topk_indices + row0 * kTopk,
                 out32,
                 nq * kTopk * sizeof(int32_t),
                 NRAM2GDRAM);
      }
      __sync_io();
    } else {
      __bang_write_value(out32, nq * kTopk, -1);
      __sync_compute();
      for (int q = 0; q < nq; ++q) {
        const int cnt = tok[q].cnt;
        if (cnt > 0) {
          __memcpy_async(out32 + q * kTopk + (kTopk - cnt),
                         tok[q].idx,
                         cnt * sizeof(int32_t),
                         NRAM2NRAM);
        }
      }
      __sync();
      __memcpy(params.topk_indices + row0 * kTopk,
               out32,
               nq * kTopk * sizeof(int32_t),
               NRAM2GDRAM);
      __sync_io();
    }
  } else {
    int32_t* tok_cnt_g = reinterpret_cast<int32_t*>(
        params.workspace + params.plan.tok_part_cnt_offset);
    bool all_split_full_k = (!direct_split_tok && nq > 1);
    for (int q = 0; q < nq; ++q) {
      const int cnt = tok[q].cnt;
      m.page_tmp[q] = cnt;
      if (cnt != kTopk) all_split_full_k = false;
    }
    if (all_split_full_k) {
      const int64_t base_item =
          static_cast<int64_t>(slot_idx) * kDecodeTokSlotStride;
      float* pv0 = reinterpret_cast<float*>(params.workspace +
                                            params.plan.tok_part_val_offset) +
                   base_item;
      int32_t* pi0 = reinterpret_cast<int32_t*>(
                         params.workspace + params.plan.tok_part_idx_offset) +
                     base_item;
      __memcpy_async(pv0,
                     tok[0].val,
                     kTopk * sizeof(float),
                     NRAM2GDRAM,
                     kTopk * sizeof(float),
                     kSegTokCap * sizeof(float),
                     nq - 1);
      __memcpy_async(pi0,
                     tok[0].idx,
                     kTopk * sizeof(int32_t),
                     NRAM2GDRAM,
                     kTopk * sizeof(int32_t),
                     kSegTokCap * sizeof(int32_t),
                     nq - 1);
    } else if (!direct_split_tok) {
      for (int q = 0; q < nq; ++q) {
        const int cnt = tok[q].cnt;
        if (cnt > 0) {
          const int64_t item =
              static_cast<int64_t>(slot_idx) * kDecodeTokSlotStride + q * kTopk;
          float* pv = reinterpret_cast<float*>(
                          params.workspace + params.plan.tok_part_val_offset) +
                      item;
          int32_t* pi =
              reinterpret_cast<int32_t*>(params.workspace +
                                         params.plan.tok_part_idx_offset) +
              item;
          __memcpy_async(pv, tok[q].val, cnt * sizeof(float), NRAM2GDRAM);
          __memcpy_async(pi, tok[q].idx, cnt * sizeof(int32_t), NRAM2GDRAM);
        }
      }
    }
    __sync();
    __memcpy_async(tok_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                   m.page_tmp,
                   nq * sizeof(int32_t),
                   NRAM2GDRAM);
    if (!(source && onchip_multi_blk)) {
      __sync_io();
    }
  }

  if (source) {
    int32_t* blk_cnt_g = reinterpret_cast<int32_t*>(
        params.workspace + params.plan.blk_part_cnt_offset);
    if (onchip_source_blk) {
      Scratch blk_scratch_1q{m.ob, m.ob + 4096, m.tmp, m.sc_iota};
      if (blk_pool_1q.cnt > kBlocks) {
        PoolCompact(blk_pool_1q, blk_scratch_1q, !is_final);
      }
      const int cnt = blk_pool_1q.cnt;
      if (is_final) {
        __bang_write_value(out32, kBlocks, -1);
        __sync_compute();
        if (cnt > 0) {
          __memcpy(out32, blk_pool_1q.idx, cnt * sizeof(int32_t), NRAM2NRAM);
          __sync();
        }
        __memcpy(params.candidate_ids_out + row0 * kBlocks,
                 out32,
                 kBlocks * sizeof(int32_t),
                 NRAM2GDRAM);
        __sync_io();
      } else {
        m.page_tmp[0] = cnt;
        __sync();
        __memcpy_async(blk_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                       m.page_tmp,
                       sizeof(int32_t),
                       NRAM2GDRAM);
        if (cnt > 0) {
          const int64_t bitem =
              static_cast<int64_t>(slot_idx) * kDecodeBlkSlotStride;
          float* bpv = reinterpret_cast<float*>(
                           params.workspace + params.plan.blk_part_val_offset) +
                       bitem;
          int32_t* bpi =
              reinterpret_cast<int32_t*>(params.workspace +
                                         params.plan.blk_part_idx_offset) +
              bitem;
          __memcpy_async(bpv, blk_pool_1q.val, cnt * sizeof(float), NRAM2GDRAM);
          __memcpy_async(
              bpi, blk_pool_1q.idx, cnt * sizeof(int32_t), NRAM2GDRAM);
        }
        __sync_io();
      }
    } else if (onchip_multi_blk) {
      if (is_final) {
        __bang_write_value(out32, nq * kBlocks, -1);
        __sync_compute();
        for (int q = 0; q < nq; ++q) {
          const int cnt = blk_cnt[q];
          if (cnt > 0) {
            __memcpy_async(out32 + q * kBlocks,
                           m.nram_bidx + q * kOnchipMultiBlkCap,
                           cnt * sizeof(int32_t),
                           NRAM2NRAM);
          }
        }
        __sync();
        __memcpy(params.candidate_ids_out + row0 * kBlocks,
                 out32,
                 nq * kBlocks * sizeof(int32_t),
                 NRAM2GDRAM);
        __sync_io();
      } else {
        int32_t* blk_cnt_stage = m.page_tmp + kDecodeSegQ;
        for (int q = 0; q < nq; ++q) {
          const int cnt = blk_cnt[q];
          blk_cnt_stage[q] = cnt;
          if (!direct_split_blk && cnt > 0) {
            const int64_t bitem =
                static_cast<int64_t>(slot_idx) * kDecodeBlkSlotStride +
                q * kBlocks;
            float* bpv =
                reinterpret_cast<float*>(params.workspace +
                                         params.plan.blk_part_val_offset) +
                bitem;
            int32_t* bpi =
                reinterpret_cast<int32_t*>(params.workspace +
                                           params.plan.blk_part_idx_offset) +
                bitem;
            __memcpy_async(bpv,
                           m.nram_bval + q * kOnchipMultiBlkCap,
                           cnt * sizeof(float),
                           NRAM2GDRAM);
            __memcpy_async(bpi,
                           m.nram_bidx + q * kOnchipMultiBlkCap,
                           cnt * sizeof(int32_t),
                           NRAM2GDRAM);
          }
        }
        __sync();
        __memcpy_async(blk_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                       blk_cnt_stage,
                       nq * sizeof(int32_t),
                       NRAM2GDRAM);
        __sync_io();
      }
    } else {
      float* pool_v_nram = m.ob;
      int32_t* pool_i_nram = reinterpret_cast<int32_t*>(m.ob + 4096);
      Scratch blk_scratch{m.ob + 8192, m.ob + 12288, m.tmp, m.sc_iota};
      if (is_final) {
        __bang_write_value(out32, nq * kBlocks, -1);
        __sync_compute();
      }
      for (int q = 0; q < nq; ++q) {
        int cnt = blk_cnt[q];
        if (cnt > 0) {
          __memcpy(pool_v_nram,
                   core_bval_base + q * kPagedBlkPoolCap,
                   cnt * sizeof(float),
                   GDRAM2NRAM);
          __memcpy(pool_i_nram,
                   core_bidx_base + q * kPagedBlkPoolCap,
                   cnt * sizeof(int32_t),
                   GDRAM2NRAM);
          __sync();
        }
        if (cnt > kBlocks) {
          Pool bp{pool_v_nram,
                  pool_i_nram,
                  cnt,
                  blk_tf[q],
                  kBlocks,
                  kPagedBlkPoolCap};
          PoolCompact(bp, blk_scratch, !is_final);
          cnt = kBlocks;
        }
        if (is_final) {
          if (cnt > 0) {
            __memcpy_async(out32 + q * kBlocks,
                           pool_i_nram,
                           cnt * sizeof(int32_t),
                           NRAM2NRAM);
            __sync_move();
          }
        } else {
          m.page_tmp[q] = cnt;
          if (cnt > 0) {
            const int64_t bitem =
                static_cast<int64_t>(slot_idx) * kDecodeBlkSlotStride +
                q * kBlocks;
            float* bpv =
                reinterpret_cast<float*>(params.workspace +
                                         params.plan.blk_part_val_offset) +
                bitem;
            int32_t* bpi =
                reinterpret_cast<int32_t*>(params.workspace +
                                           params.plan.blk_part_idx_offset) +
                bitem;
            __memcpy_async(bpv, pool_v_nram, cnt * sizeof(float), NRAM2GDRAM);
            __memcpy_async(bpi, pool_i_nram, cnt * sizeof(int32_t), NRAM2GDRAM);
            __sync_io();
          }
        }
      }
      if (is_final) {
        __sync();
        __memcpy(params.candidate_ids_out + row0 * kBlocks,
                 out32,
                 nq * kBlocks * sizeof(int32_t),
                 NRAM2GDRAM);
        __sync_io();
      } else {
        __sync();
        __memcpy(blk_cnt_g + static_cast<int64_t>(slot_idx) * kDecodeSegQ,
                 m.page_tmp,
                 nq * sizeof(int32_t),
                 NRAM2GDRAM);
        __sync_io();
      }
    }
  }
  __sync();
}

// =============================================================================
// FILTER Helpers: Reachability-first candidate sort & 64-bit block gathers
// =============================================================================

// Reachability-safe deduplicated / contiguous page-table lookup for strictly
// ascending reachable block IDs `ub_src[0..cnt-1]` (1 <= cnt <= kBlocks).
// Reads ONLY pages referenced by `ub_src[0..cnt-1]`:
//   - If all blocks fall in a single page (`span_pages == 1`), performs 1
//     4-byte load and broadcasts in NRAM.
//   - If `u_pages == span_pages` (`span_pages <= 4096`), every page in
//     `[lp_min, lp_max]` is referenced, so performs 1 contiguous burst DMA
//     and expands via NRAM2NRAM gather.
//   - Otherwise (`u_pages < span_pages <= 4096`), gathers ONLY the `u_pages`
//     deduplicated referenced pages from GDRAM, scatters into NRAM LUT, and
//     gathers `out_pages` in NRAM.
// `work_f` must be 64B-aligned NRAM scratch with >= 24576 32-bit words.
__mlu_func__ void LoadSortedBlockPages(const PageLayout& page,
                                       const int32_t* table_b,
                                       const int32_t* ub_src,
                                       int cnt,
                                       int32_t* out_pages,
                                       float* work_f,
                                       const float* sc_iota) {
  if (cnt <= 0) return;
  int32_t* ub_pad_i = reinterpret_cast<int32_t*>(work_f);
  int32_t* lp_i = ub_pad_i + kBlocks;
  float* lp_f = work_f + 2 * kBlocks;
  float* lp_prev_f = lp_f + kBlocks;
  float* chg_f = lp_prev_f + kBlocks;
  float* uniq_lp_f = chg_f + kBlocks;
  uint32_t* boff_u = reinterpret_cast<uint32_t*>(uniq_lp_f + kBlocks);
  int32_t* uniq_phys = reinterpret_cast<int32_t*>(boff_u + kBlocks);
  int32_t* out_aligned = uniq_phys + kBlocks;
  int32_t* phys_lut = out_aligned + kBlocks;  // [4096]

  const int32_t lp_min = ub_src[0] >> page.block_shift;
  const int32_t lp_max = ub_src[cnt - 1] >> page.block_shift;
  const int span_pages = lp_max - lp_min + 1;
  const int cnt64 = (cnt + 63) / 64 * 64;

  if (span_pages == 1) {
    __memcpy(uniq_phys, table_b + lp_min, sizeof(int32_t), GDRAM2NRAM);
    __sync_io();
    __bang_write_value(out_aligned, cnt64, uniq_phys[0]);
    __sync_compute();
    __memcpy(out_pages, out_aligned, cnt * sizeof(int32_t), NRAM2NRAM);
    __sync_move();
    return;
  }

  __memcpy(ub_pad_i, ub_src, cnt * sizeof(int32_t), NRAM2NRAM);
  const int32_t last_ub = ub_src[cnt - 1];
  for (int j = cnt; j < cnt64; ++j) ub_pad_i[j] = last_ub;
  __sync();

  __bang_band_scalar(lp_i, ub_pad_i, ~page.block_mask, cnt64);
  __bang_int322float(lp_f, lp_i, cnt64, 0);
  __bang_mul_scalar(lp_f, lp_f, page.inverse_blocks, cnt64);
  __sync_compute();

  if (span_pages > 4096) {
    __bang_mul_scalar(lp_prev_f, lp_f, 4.0f, cnt64);
    __bang_float2int32(reinterpret_cast<int32_t*>(boff_u), lp_prev_f, cnt64, 0);
    __sync_compute();
    __gather(out_pages,
             table_b,
             boff_u,
             sizeof(int32_t),
             GDRAM2NRAM,
             sizeof(int32_t),
             cnt);
    __sync_io();
    return;
  }

  lp_prev_f[0] = lp_f[0] - 1.0f;
  if (cnt > 1) {
    __memcpy(lp_prev_f + 1, lp_f, (cnt - 1) * sizeof(float), NRAM2NRAM);
  }
  for (int j = cnt; j < cnt64; ++j) lp_prev_f[j] = lp_f[j];
  __sync();

  __bang_ne(chg_f, lp_f, lp_prev_f, cnt64);
  const int u_pages =
      static_cast<int>(__bang_filter(uniq_lp_f, lp_f, chg_f, cnt64));

  uint32_t* blk_lut_boff = reinterpret_cast<uint32_t*>(ub_pad_i);
  __bang_sub_scalar(lp_prev_f, lp_f, static_cast<float>(lp_min), cnt64);
  __bang_mul_scalar(lp_prev_f, lp_prev_f, 4.0f, cnt64);
  __bang_float2int32(
      reinterpret_cast<int32_t*>(blk_lut_boff), lp_prev_f, cnt64, 0);

  if (u_pages == span_pages) {
    __memcpy(
        phys_lut, table_b + lp_min, span_pages * sizeof(int32_t), GDRAM2NRAM);
    __sync();
    __gather(out_pages,
             phys_lut,
             blk_lut_boff,
             sizeof(int32_t),
             NRAM2NRAM,
             sizeof(int32_t),
             cnt);
    __sync_move();
    return;
  }

  const int up64 = (u_pages + 63) / 64 * 64;
  int32_t* uniq_lp_i = out_aligned;
  for (int j = u_pages; j < up64; ++j) {
    uniq_lp_f[j] = 0.0f;
    lp_prev_f[j] = 1.0f;
  }
  lp_prev_f[u_pages - 1] = uniq_lp_f[u_pages - 1] + 1.0f;
  if (u_pages > 1) {
    __memcpy(
        lp_prev_f, uniq_lp_f + 1, (u_pages - 1) * sizeof(float), NRAM2NRAM);
  }
  __sync();
  __bang_float2int32(uniq_lp_i, uniq_lp_f, up64, 0);
  __bang_sub(chg_f, lp_prev_f, uniq_lp_f, up64);
  __bang_ne_scalar(chg_f, chg_f, 1.0f, up64);
  const int n_breaks = static_cast<int>(__bang_count(chg_f, up64));

  if (n_breaks <= 80 && 2 * u_pages >= 3 * (n_breaks + 1)) {
    if (n_breaks > 0) {
      const int nb64 = (n_breaks + 63) / 64 * 64;
      __bang_filter(lp_prev_f, sc_iota, chg_f, up64);
      __sync_compute();
      for (int j = n_breaks; j < nb64; ++j) lp_prev_f[j] = 0.0f;
      __sync();
      __bang_float2int32(lp_i, lp_prev_f, nb64, 0);
      __sync_compute();
    }
    int r_start = 0;
    for (int k = 0; k <= n_breaks; ++k) {
      const int r_end = (k < n_breaks) ? (lp_i[k] + 1) : u_pages;
      const int32_t lp0 = uniq_lp_i[r_start];
      const int r_len = r_end - r_start;
      __memcpy_async(phys_lut + (lp0 - lp_min),
                     table_b + lp0,
                     r_len * sizeof(int32_t),
                     GDRAM2NRAM);
      if ((k & 15) == 15) __sync_io();
      r_start = r_end;
    }
    __sync_io();
    __gather(out_pages,
             phys_lut,
             blk_lut_boff,
             sizeof(int32_t),
             NRAM2NRAM,
             sizeof(int32_t),
             cnt);
    __sync_move();
    return;
  }

  __bang_mul_scalar(chg_f, uniq_lp_f, 4.0f, up64);
  __bang_float2int32(reinterpret_cast<int32_t*>(boff_u), chg_f, up64, 0);
  __sync_compute();

  __gather_async(uniq_phys,
                 table_b,
                 boff_u,
                 sizeof(int32_t),
                 GDRAM2NRAM,
                 sizeof(int32_t),
                 u_pages);
  uint32_t* lut_boff = reinterpret_cast<uint32_t*>(lp_i);
  __bang_sub_scalar(chg_f, uniq_lp_f, static_cast<float>(lp_min), up64);
  __bang_mul_scalar(chg_f, chg_f, 4.0f, up64);
  __bang_float2int32(reinterpret_cast<int32_t*>(lut_boff), chg_f, up64, 0);
  __sync();

  __scatter(phys_lut,
            uniq_phys,
            lut_boff,
            sizeof(int32_t),
            NRAM2NRAM,
            sizeof(int32_t),
            u_pages);
  __sync_move();
  __gather(out_pages,
           phys_lut,
           blk_lut_boff,
           sizeof(int32_t),
           NRAM2NRAM,
           sizeof(int32_t),
           cnt);
  __sync_move();
}

__mlu_func__ void RadixPass(int32_t* dst,
                            const int32_t* src,
                            int bit,
                            int n,
                            int32_t* rm1,
                            float* fm0,
                            float* fm1) {
  __bang_band_scalar(rm1, src, 1 << bit, n);
  __bang_int322float(fm1, rm1, n, 0);
  __bang_eq_scalar(fm0, fm1, 0.0f, n);
  const int c0 =
      static_cast<int>(__bang_filter(reinterpret_cast<float*>(dst),
                                     reinterpret_cast<const float*>(src),
                                     fm0,
                                     n));
  __bang_filter(reinterpret_cast<float*>(dst + c0),
                reinterpret_cast<const float*>(src),
                fm1,
                n);
}

__mlu_func__ int SortReachableCandidates(const int32_t* cand_g,
                                         int n_reach_blocks,
                                         int32_t* xa,
                                         int32_t* xb,
                                         float* idf,
                                         float* xf,
                                         float* keepf,
                                         int32_t* rm1,
                                         float* fm0,
                                         float* fm1,
                                         float* out_f,
                                         bool preloaded_xa = false) {
  if (n_reach_blocks <= 0) return 0;
  if (!preloaded_xa) {
    __memcpy(xa, cand_g, kBlocks * sizeof(int32_t), GDRAM2NRAM);
    __sync();
  }
  __bang_int322float(idf, xa, kBlocks, 0);
  __bang_ge_scalar(fm0, idf, 0.0f, kBlocks);
  __bang_lt_scalar(fm1, idf, static_cast<float>(n_reach_blocks), kBlocks);
  __bang_mul(fm0, fm0, fm1, kBlocks);
  const int n1 = static_cast<int>(__bang_filter(out_f, idf, fm0, kBlocks));
  if (n1 <= 1) {
    if (n1 == 1) __sync_compute();
    return n1;
  }
  __bang_gt(fm0, out_f + 1, out_f, n1 - 1);
  if (static_cast<int>(__bang_count(fm0, n1 - 1)) == n1 - 1) {
    return n1;
  }
  __bang_lt(fm0, out_f + 1, out_f, n1 - 1);
  if (static_cast<int>(__bang_count(fm0, n1 - 1)) == n1 - 1) {
    __memcpy(xf,
             out_f + n1 - 1,
             sizeof(float),
             NRAM2NRAM,
             sizeof(float),
             -static_cast<int32_t>(sizeof(float)),
             n1 - 1);
    __sync();
    __bang_move(out_f, xf, n1 * sizeof(float));
    __sync_move();
    return n1;
  }
  int nbits = 1;
  while ((1 << nbits) < n_reach_blocks) ++nbits;
  __bang_float2int32(xa, out_f, n1, 0);
  int32_t* src = xa;
  int32_t* dst = xb;
  for (int bit = 0; bit < nbits; ++bit) {
    RadixPass(dst, src, bit, n1, rm1, fm0, fm1);
    int32_t* t = src;
    src = dst;
    dst = t;
  }
  __bang_int322float(xf, src, n1, 0);
  __sync_compute();
  keepf[0] = 1.0f;
  __sync();
  __bang_ne(keepf + 1, xf + 1, xf, n1 - 1);
  const int nu = static_cast<int>(__bang_filter(out_f, xf, keepf, n1));
  __sync_compute();
  return nu;
}

__mlu_func__ void ExpandMembership8(float* memb,
                                    const int32_t* bits_i,
                                    const int32_t* qbit,
                                    int nbp,
                                    float* tmp) {
  constexpr int Q = kDecodeSegQ;
  int32_t* bi = reinterpret_cast<int32_t*>(tmp);
  int32_t* r1 = reinterpret_cast<int32_t*>(tmp + 64);
  int32_t* r2 = reinterpret_cast<int32_t*>(tmp + 64 + 256);
  float* mf = tmp + 64 + 512;
  float* mt = tmp + 64 + 768;
  float* ex = tmp + 1088;
  __memcpy(bi, bits_i, nbp * sizeof(int32_t), NRAM2NRAM);
  __sync();
  __bang_write_value(r1, Q * nbp, 0);
  __bang_cycle_add(r1, r1, bi, Q * nbp, nbp);
  __bang_transpose(r2, r1, Q, nbp);
  __bang_cycle_band(r2, r2, qbit, Q * nbp, Q);
  __bang_int322float(mf, r2, Q * nbp, 0);
  __bang_gt_scalar(mf, mf, 0.5f, Q * nbp);
  __bang_transpose(mt, mf, nbp, Q);
  __bang_write_value(ex, kBlockSize * Q * nbp, 0.0f);
  __bang_cycle_add(ex, ex, mt, kBlockSize * Q * nbp, Q * nbp);
  __bang_transpose(memb, ex, kBlockSize, Q * nbp);
}

}  // namespace

// =============================================================================
// Global Kernels for Unified Rank-3 Packed Decode / Variable-Length Verify
// =============================================================================

__mlu_global__ void DecodeFillNegOneKernel(DecodeParams params) {
  if (__is_mpu()) return;
  __nram__ int32_t neg_ones[kBlocks];
  FillOutputRowsNegOne(params, 0, params.ncap, neg_ones);
}

__mlu_global__ void DecodeDenseScoreKernel(DecodeParams params) {
  if (__is_mpu()) return;

  __nram__ int8_t nram_buf[488 * 1024];
  __wram__ bfloat16_t wram_buf[kMap16WramBytes / sizeof(bfloat16_t)];

  constexpr int N = kTileSlots;
  int8_t* cur = nram_buf;
  CARVE_FROM(cur, bfloat16_t, kbf, N * kDim);
  CARVE_FROM(cur, float, kf32, N* kDim);
  CARVE_FROM(cur, float, ob, N * 64);
  CARVE_FROM(cur, float, tmp, N * 64);
  CARVE_FROM(cur, float, acc, 3 * kDecodeSegQ * N);
  CARVE_FROM(cur, float, tok_val, kDecodeSegQ* kSegTokCap);
  CARVE_FROM(cur, int32_t, tok_idx, kDecodeSegQ* kSegTokCap);
  CARVE_FROM(cur, float, nram_bval, kPagedBlkPoolCap);
  CARVE_FROM(cur, int32_t, nram_bidx, kPagedBlkPoolCap);
  CARVE_FROM(cur, float, sc_iota, kPagedBlkPoolCap);
  CARVE_FROM(cur, int32_t, ids, N);
  CARVE_FROM(cur, int32_t, iota_i, N);
  CARVE_FROM(cur, float, tfm, kDecodeSegQ* N);
  CARVE_FROM(cur, float, rowc, 64);
  CARVE_FROM(cur, float, bm, kDecodeSegQ * 32);
  CARVE_FROM(cur, int32_t, blk_ids, 64);
  CARVE_FROM(cur, int32_t, page_tmp, 64);
  CARVE_FROM(cur, float, wv, 4 * 64);
  CARVE_FROM(cur, float, w_f32, kDecodeSegQ* kHeads);
  CARVE_FROM(cur, bfloat16_t, w_bf16, kDecodeSegQ * kHeads);
  CARVE_FROM(cur, DecodeMergeHeader, hdr_out_stage, 1);
  CARVE_FROM(cur, DecodeSplitSeg, splits_stage, kDecodeMaxSplitSegs);
  PackedDecodeMetaBufs meta{};
  CarvePackedDecodeMeta(cur, &meta);

  const int neg_len = (params.mode == kSource) ? kBlocks : kTopk;
  int32_t* neg_ones = reinterpret_cast<int32_t*>(kf32);

  // Read V = num_valid_input_rows[0] dynamically on device (Graph replay safe!)
  // Overlapped with NRAM 64-element iota_i initialization (zero __mlu_const__).
  __memcpy_async(
      meta.meta_tmp, params.num_valid_input_rows, sizeof(int32_t), GDRAM2NRAM);
  InitIota64I(iota_i);
  __sync_io();

  int64_t v_rows = meta.meta_tmp[0];
  if (v_rows < 0 || params.bcap <= 0) v_rows = 0;
  if (v_rows > params.ncap) v_rows = params.ncap;

  DecodeMergeHeader* hdr_g = reinterpret_cast<DecodeMergeHeader*>(
      params.workspace + params.plan.header_offset);

  // Fill tail capacity rows [v_rows, ncap) with -1 without touching >= v_rows
  // inputs or metadata!
  if (v_rows < params.ncap) {
    FillOutputRowsNegOne(params, v_rows, params.ncap, neg_ones);
  }

  if (v_rows == 0 || params.max_pages == 0 || params.paged_rows == 0) {
    if (v_rows > 0) {
      FillOutputRowsNegOne(params, 0, v_rows, neg_ones);
    }
    if (params.plan.do_split && taskId == 0) {
      meta.hdr_stage->num_splits = 0;
      __sync();
      __memcpy(hdr_g, meta.hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    return;
  }

  if (!params.plan.do_split && params.mode != kSource && taskId >= v_rows) {
    return;
  }

  const bool prefetch_dense_meta = (v_rows <= kDecodeRowCacheCap);
  int32_t* qpos_prefetch = reinterpret_cast<int32_t*>(kf32);
  if (prefetch_dense_meta) {
    __memcpy_async(meta.row_b,
                   params.query_batch_indices,
                   v_rows * sizeof(int32_t),
                   GDRAM2NRAM);
    __memcpy_async(qpos_prefetch,
                   params.query_positions,
                   v_rows * sizeof(int32_t),
                   GDRAM2NRAM);
  }

  __bang_add_scalar(iota_i + 64, iota_i, 64, 64);
  __bang_add_scalar(iota_i + 128, iota_i, 128, 128);
  __bang_int322float(sc_iota, iota_i, N, 0);
  int pending_iota_cap = N;
  __sync();

  DecodeSegBufs m{kbf,     kf32,      ob,        tmp,     acc,      wv,
                  w_f32,   w_bf16,    ids,       iota_i,  sc_iota,  tfm,
                  rowc,    bm,        blk_ids,   iota_i,  page_tmp, tok_val,
                  tok_idx, nram_bval, nram_bidx, sc_iota, wram_buf};

  // Streaming per-row fallback when v_rows > kDecodeRowCacheCap
  if (v_rows > kDecodeRowCacheCap) {
    if (params.plan.do_split && taskId == 0) {
      meta.hdr_stage->num_splits = 0;
      __sync();
      __memcpy(hdr_g, meta.hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    int cached_b = -1;
    int32_t cached_hl = 0;
    for (int64_t r = taskId; r < v_rows; r += taskDim) {
      __memcpy_async(meta.meta_tmp,
                     params.query_batch_indices + r,
                     sizeof(int32_t),
                     GDRAM2NRAM);
      __memcpy_async(meta.meta_tmp + 1,
                     params.query_positions + r,
                     sizeof(int32_t),
                     GDRAM2NRAM);
      __sync_io();
      const int32_t b = meta.meta_tmp[0];
      const int32_t qpos = meta.meta_tmp[1];
      if (b != cached_b) {
        __memcpy(meta.meta_tmp + 2,
                 params.history_lengths + b,
                 sizeof(int32_t),
                 GDRAM2NRAM);
        __sync_io();
        cached_hl = meta.meta_tmp[2];
        cached_b = b;
      }
      const int32_t nr =
          ReadableCount(static_cast<int64_t>(qpos), cached_hl, params.ratio);
      if (nr <= 0) {
        int32_t* neg = reinterpret_cast<int32_t*>(kf32);
        __bang_write_value(neg, neg_len, -1);
        __sync_compute();
        __memcpy_async(params.topk_indices + r * kTopk,
                       neg,
                       kTopk * sizeof(int32_t),
                       NRAM2GDRAM);
        if (params.mode == kSource) {
          __memcpy_async(params.candidate_ids_out + r * kBlocks,
                         neg,
                         kBlocks * sizeof(int32_t),
                         NRAM2GDRAM);
        }
        __sync_io();
        continue;
      }
      const int nt = (nr + N - 1) / N;
      ScoreDensePiece(
          params, m, b, r, 1, &nr, nr, nr, 0, nt, true, -1, &pending_iota_cap);
    }
    return;
  }

  if (!params.plan.do_split) {
    // Fast per-core local segment path when query_batch_indices[0..v_rows-1]
    // is uniform contiguous [b_act, s0] (1 <= s0 <= tq): row_b & qpos were
    // already prefetched asynchronously during sc_iota setup!
    const int vr = static_cast<int>(v_rows);
    const int vr64 = (vr + 63) / 64 * 64;
    int32_t prefetched_b0 = -1;
    if (taskId < vr) {
      const int32_t b_try = meta.row_b[taskId];
      if (b_try >= 0 && b_try < params.bcap) {
        prefetched_b0 = b_try;
        __memcpy_async(meta.meta_tmp,
                       params.history_lengths + b_try,
                       sizeof(int32_t),
                       GDRAM2NRAM);
      }
    }
    int s0 = 0;
    if (meta.row_b[0] == 0) {
      s0 = 1;
      while (s0 < vr && s0 <= params.plan.tq && meta.row_b[s0] == 0) ++s0;
    }
    bool is_uniform = false;
    if (s0 >= 1 && s0 <= params.plan.tq && (vr % s0) == 0) {
      if (vr == s0) {
        is_uniform = true;
      } else {
        float* qbf_u = kf32 + kDecodeRowCacheCap;
        float* qbf_next_u = kf32 + 2 * kDecodeRowCacheCap;
        float* diff_u = kf32 + 3 * kDecodeRowCacheCap;
        if (vr < vr64) {
          __memcpy(meta.row_b + vr,
                   iota_i + vr,
                   (vr64 - vr) * sizeof(int32_t),
                   NRAM2NRAM);
          __sync_move();
        }
        __bang_int322float(qbf_u, meta.row_b, vr64, 0);
        if (s0 == 1) {
          __bang_ne(diff_u, qbf_u, sc_iota, vr64);
          is_uniform = (static_cast<int>(__bang_count(diff_u, vr64)) == 0);
        } else {
          const int rem_len = vr - s0;
          const int rem64 = (rem_len + 63) / 64 * 64;
          __bang_add_scalar(qbf_next_u, qbf_u, 1.0f, rem64);
          __sync_compute();
          __memcpy(qbf_next_u, qbf_u + s0, rem_len * sizeof(float), NRAM2NRAM);
          __sync_move();
          __bang_sub(diff_u, qbf_next_u, qbf_u, rem64);
          __bang_ne_scalar(diff_u, diff_u, 1.0f, rem64);
          is_uniform = (static_cast<int>(__bang_count(diff_u, rem64)) == 0);
        }
      }
    }
    if (is_uniform) {
      const int b_act = vr / s0;
      const int ns_wid = (params.mode == kSource && b_act <= 16 &&
                          params.plan.cores == 32 && taskDim == 32)
                             ? (((taskId & 3) << 3) | (taskId >> 2))
                             : taskId;
      if (ns_wid >= b_act) {
        if (prefetched_b0 >= 0) __sync_io();
        return;
      }
      // Scoring and empty-row fills reuse kf32 before the next segment.
      const int32_t* positions = qpos_prefetch;
      if (ns_wid + taskDim < b_act) {
        __memcpy(meta.row_n, qpos_prefetch, vr * sizeof(int32_t), NRAM2NRAM);
        __sync_move();
        positions = meta.row_n;
      }
      for (int s = ns_wid; s < b_act; s += taskDim) {
        const int64_t row0 = static_cast<int64_t>(s) * s0;
        if (s != prefetched_b0) {
          if (prefetched_b0 >= 0) {
            __sync_io();
            prefetched_b0 = -1;
          }
          __memcpy(meta.meta_tmp,
                   params.history_lengths + s,
                   sizeof(int32_t),
                   GDRAM2NRAM);
        } else {
          prefetched_b0 = -1;
        }
        __sync_io();
        const int32_t hl = meta.meta_tmp[0];
        int32_t nr_local[kDecodeSegQ];
        int seg_min_n = 1 << 30;
        int seg_max_n = 0;
        for (int q = 0; q < s0; ++q) {
          const int32_t nr =
              ReadableCountFast32(positions[row0 + q], hl, params.ratio);
          nr_local[q] = nr;
          if (nr < seg_min_n) seg_min_n = nr;
          if (nr > seg_max_n) seg_max_n = nr;
        }
        if (seg_max_n <= 0) {
          int32_t* neg = reinterpret_cast<int32_t*>(kf32);
          __bang_write_value(neg, neg_len, -1);
          __sync_compute();
          for (int q = 0; q < s0; ++q) {
            __memcpy_async(params.topk_indices + (row0 + q) * kTopk,
                           neg,
                           kTopk * sizeof(int32_t),
                           NRAM2GDRAM);
            if (params.mode == kSource) {
              __memcpy_async(params.candidate_ids_out + (row0 + q) * kBlocks,
                             neg,
                             kBlocks * sizeof(int32_t),
                             NRAM2GDRAM);
            }
          }
          __sync_io();
          continue;
        }
        const int nt = (seg_max_n + N - 1) / N;
        ScoreDensePiece(params,
                        m,
                        s,
                        row0,
                        s0,
                        nr_local,
                        seg_min_n,
                        seg_max_n,
                        0,
                        nt,
                        true,
                        -1,
                        &pending_iota_cap);
      }
      return;
    }
    if (prefetched_b0 >= 0) __sync_io();
  }

  BuildPackedDecodeMeta(params,
                        static_cast<int>(v_rows),
                        params.plan.tq,
                        qpos_prefetch,
                        &meta,
                        sc_iota,
                        true);
  const int num_segs = meta.num_segs;

  if (!params.plan.do_split) {
    if (taskId >= num_segs) return;
    for (int s = taskId; s < num_segs; s += taskDim) {
      const int b = meta.seg_b[s];
      const int64_t row0 = meta.seg_row0[s];
      const int nq = meta.seg_nq[s];
      const int seg_min_n = meta.seg_min_n[s];
      const int seg_max_n = meta.seg_max_n[s];
      if (seg_max_n <= 0) {
        int32_t* neg = reinterpret_cast<int32_t*>(kf32);
        __bang_write_value(neg, neg_len, -1);
        __sync_compute();
        for (int q = 0; q < nq; ++q) {
          __memcpy_async(params.topk_indices + (row0 + q) * kTopk,
                         neg,
                         kTopk * sizeof(int32_t),
                         NRAM2GDRAM);
          if (params.mode == kSource) {
            __memcpy_async(params.candidate_ids_out + (row0 + q) * kBlocks,
                           neg,
                           kBlocks * sizeof(int32_t),
                           NRAM2GDRAM);
          }
        }
        __sync_io();
        continue;
      }
      const int nt = (seg_max_n + N - 1) / N;
      ScoreDensePiece(params,
                      m,
                      b,
                      row0,
                      nq,
                      meta.row_n + row0,
                      seg_min_n,
                      seg_max_n,
                      0,
                      nt,
                      true,
                      -1,
                      &pending_iota_cap);
    }
    return;
  }

  const int64_t total_tiles = meta.total_tiles;
  const int64_t active_segs = meta.active_segs;
  if (active_segs < num_segs) {
    bool wrote_empty = false;
    int32_t* neg_empty = neg_ones;
    for (int s = 0; s < num_segs; ++s) {
      if (meta.seg_max_n[s] <= 0 && (s % taskDim) == taskId) {
        if (!wrote_empty) {
          __bang_write_value(neg_empty, neg_len, -1);
          __sync_compute();
        }
        const int64_t row0 = meta.seg_row0[s];
        const int nq = meta.seg_nq[s];
        for (int q = 0; q < nq; ++q) {
          __memcpy_async(params.topk_indices + (row0 + q) * kTopk,
                         neg_empty,
                         kTopk * sizeof(int32_t),
                         NRAM2GDRAM);
          if (params.mode == kSource) {
            __memcpy_async(params.candidate_ids_out + (row0 + q) * kBlocks,
                           neg_empty,
                           kBlocks * sizeof(int32_t),
                           NRAM2GDRAM);
          }
        }
        wrote_empty = true;
      }
    }
    if (wrote_empty) __sync_io();
  }

  if (total_tiles <= 0) {
    if (taskId == 0) {
      meta.hdr_stage->num_splits = 0;
      __sync();
      __memcpy(hdr_g, meta.hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    return;
  }

  const int min_tpc = (params.mode == kSource && meta.max_seg_nq == 1) ? 4 : 1;
  int64_t desired_cores = (total_tiles + min_tpc - 1) / min_tpc;
  if (desired_cores < active_segs) desired_cores = active_segs;
  if (desired_cores < 1) desired_cores = 1;
  const int eff_cores = desired_cores < params.plan.cores
                            ? static_cast<int>(desired_cores)
                            : params.plan.cores;
  int tpc_shift = -1;
  if (eff_cores > 0 && (eff_cores & (eff_cores - 1)) == 0 &&
      total_tiles >= eff_cores && (total_tiles % eff_cores) == 0) {
    const int64_t q_tpc = total_tiles / eff_cores;
    if (q_tpc > 0 && (q_tpc & (q_tpc - 1)) == 0) {
      int sh = 0;
      while ((int64_t{1} << sh) < q_tpc) ++sh;
      tpc_shift = sh;
    }
  }
  const int dense_wid =
      (meta.max_seg_nq > 1 && eff_cores >= 8 && eff_cores <= 16 &&
       params.plan.cores == 32 && taskDim == 32)
          ? (((taskId & 3) << 3) | (taskId >> 2))
          : taskId;
  const int64_t my_lo =
      dense_wid < eff_cores
          ? (tpc_shift >= 0 ? (static_cast<int64_t>(dense_wid) << tpc_shift)
                            : CoreLo(total_tiles, dense_wid, eff_cores))
          : 0;
  const int64_t my_hi =
      dense_wid < eff_cores
          ? (tpc_shift >= 0 ? (static_cast<int64_t>(dense_wid + 1) << tpc_shift)
                            : CoreLo(total_tiles, dense_wid + 1, eff_cores))
          : 0;

  if (taskId == 0) {
    int ns = 0;
    int slot_cur = 0;
    int64_t p_cur = 0;
    for (int s = 0; s < num_segs; ++s) {
      const int smx = meta.seg_max_n[s];
      if (smx <= 0) continue;
      const int nt = (smx + N - 1) / N;
      const int pts = tpc_shift >= 0
                          ? (static_cast<int>((p_cur + nt - 1) >> tpc_shift) -
                             static_cast<int>(p_cur >> tpc_shift) + 1)
                          : (CoreOf(p_cur + nt - 1, total_tiles, eff_cores) -
                             CoreOf(p_cur, total_tiles, eff_cores) + 1);
      if (pts > 1) {
        DecodeSplitSeg& sp = splits_stage[ns++];
        sp.row0 = meta.seg_row0[s];
        sp.nq = meta.seg_nq[s];
        sp.first_slot = slot_cur;
        sp.num_parts = pts;
        slot_cur += pts;
      }
      p_cur += nt;
    }
    hdr_out_stage->num_splits = ns;
    __sync();
    const int out_bytes = ns > 0 ? static_cast<int>(sizeof(DecodeMergeHeader) +
                                                    ns * sizeof(DecodeSplitSeg))
                                 : static_cast<int>(sizeof(int32_t));
    __memcpy_async(hdr_g, hdr_out_stage, out_bytes, NRAM2GDRAM);
  }
  if (dense_wid >= eff_cores) return;

  int next_slot = 0;
  int64_t pre = 0;

  for (int s = 0; s < num_segs; ++s) {
    if (pre >= my_hi) break;
    const int seg_max_n = meta.seg_max_n[s];
    if (seg_max_n <= 0) continue;

    const int b = meta.seg_b[s];
    const int64_t row0 = meta.seg_row0[s];
    const int nq = meta.seg_nq[s];
    const int seg_min_n = meta.seg_min_n[s];
    const int nt = (seg_max_n + N - 1) / N;
    const int c_first = tpc_shift >= 0 ? static_cast<int>(pre >> tpc_shift)
                                       : CoreOf(pre, total_tiles, eff_cores);
    const int c_last = tpc_shift >= 0
                           ? static_cast<int>((pre + nt - 1) >> tpc_shift)
                           : CoreOf(pre + nt - 1, total_tiles, eff_cores);
    const int parts = c_last - c_first + 1;
    int first_slot = -1;

    if (parts > 1) {
      first_slot = next_slot;
      next_slot += parts;
    }

    if (c_first <= dense_wid && dense_wid <= c_last) {
      const int64_t seg_end = pre + nt;
      const int t_lo = static_cast<int>((my_lo > pre ? my_lo : pre) - pre);
      const int t_hi =
          static_cast<int>((my_hi < seg_end ? my_hi : seg_end) - pre);
      const int p_idx = dense_wid - c_first;
      ScoreDensePiece(params,
                      m,
                      b,
                      row0,
                      nq,
                      meta.row_n + row0,
                      seg_min_n,
                      seg_max_n,
                      t_lo,
                      t_hi,
                      parts == 1,
                      parts == 1 ? -1 : (first_slot + p_idx),
                      &pending_iota_cap);
    }
    pre += nt;
  }

  if (taskId == 0) {
    __sync_io();
  }
}

// =============================================================================
// FILTER Kernel: Strict reachability-first + 2KB block gather + multi-core
// team splitting when active_rows < cores!
// =============================================================================

__mlu_func__ __attribute__((always_inline)) bool LoadFilterSingleTile(
    const PageLayout& page,
    const bfloat16_t* paged_k,
    const int32_t* ub_i,
    const int32_t* page_all,
    const uint32_t* k_boff32_all,
    const uint64_t* k_boff64_all,
    const float* iota_f256,
    bfloat16_t* kbf,
    float* reach_ring,
    bool use_u32_boff,
    int n_u,
    int nu,
    int t,
    int st) {
  constexpr int BPT = kTileSlots / kBlockSize;
  constexpr uint32_t kBlockBytes = kBlockSize * kDim * sizeof(bfloat16_t);
  const int b_off = t * BPT;
  const int nb = (nu - b_off) < BPT ? (nu - b_off) : BPT;
  const int n = nb * kBlockSize;
  const int nco = (n + 63) / 64 * 64;
  bfloat16_t* kb = kbf + st * kTileSlots * kDim;
  float* rd = reach_ring + st * kTileSlots;

  const int last_s0 = ub_i[b_off + nb - 1] * kBlockSize;
  const int last_w =
      (n_u - last_s0) < kBlockSize ? (n_u - last_s0) : kBlockSize;
  const int valid_slots = (nb - 1) * kBlockSize + last_w;
  const bool full_reach = (valid_slots == nco);
  if (!full_reach) {
    __bang_lt_scalar(rd, iota_f256, static_cast<float>(valid_slots), nco);
  }

  const int nfull = (last_w == kBlockSize) ? nb : (nb - 1);
  if (nfull > 0) {
    if (use_u32_boff) {
      __gather_async(kb,
                     paged_k,
                     k_boff32_all + b_off,
                     kBlockBytes,
                     GDRAM2NRAM,
                     kBlockBytes,
                     nfull);
    } else {
      __gather_async(kb,
                     paged_k,
                     k_boff64_all + b_off,
                     kBlockBytes,
                     GDRAM2NRAM,
                     kBlockBytes,
                     nfull);
    }
  }
  if (nfull < nb) {
    const int j_last = nb - 1;
    const int64_t phys_page = static_cast<int64_t>(page_all[b_off + j_last]);
    const int32_t blk_last = ub_i[b_off + j_last];
    const bfloat16_t* k_src =
        paged_k +
        (phys_page * page.rows + (blk_last & page.block_mask) * kBlockSize) *
            kDim;
    bfloat16_t* k_dst = kb + (j_last * kBlockSize) * kDim;
    if (last_w > 0) {
      __memcpy_async(
          k_dst, k_src, last_w * kDim * sizeof(bfloat16_t), GDRAM2NRAM);
    }
    __bang_write_value(k_dst + last_w * kDim,
                       (kBlockSize - last_w) * kDim,
                       static_cast<bfloat16_t>(0));
  }
  if (nco > n) {
    __bang_write_value(
        kb + n * kDim, (nco - n) * kDim, static_cast<bfloat16_t>(0));
  }
  return full_reach;
}

__mlu_func__ __attribute__((always_inline)) void RunDecodeFilterRowPath(
    const DecodeParams& params,
    int8_t* nram_buf,
    bfloat16_t* wram_k,
    int64_t v_rows,
    bool has_row_cache,
    const PackedDecodeMetaBufs& meta) {
  const auto& page = params.page;
  constexpr int kFTokCap = 2048;
  constexpr int BPT = kTileSlots / kBlockSize;  // 32

  int8_t* cur = nram_buf;
  CARVE_FROM(cur, bfloat16_t, kbf, 2 * kTileSlots * kDim);
  CARVE_FROM(cur, float, k_f32, kTileSlots* kDim);
  CARVE_FROM(cur, float, qk, 2 * kTileSlots * kHeads);
  CARVE_FROM(cur, int32_t, slot_all_i, kBlocks* kBlockSize);
  CARVE_FROM(cur, float, ub_f, kBlocks);
  CARVE_FROM(cur, int32_t, ub_i, kBlocks);
  CARVE_FROM(cur, int32_t, page_all, kBlocks);
  CARVE_FROM(cur, uint64_t, k_boff64_all, kBlocks);
  CARVE_FROM(cur, float, reach_ring, 2 * kTileSlots);
  CARVE_FROM(cur, float, iota_f256, kTileSlots);
  CARVE_FROM(cur, float, pat64, 64);
  CARVE_FROM(cur, float, pool_mask, kTileSlots);
  CARVE_FROM(cur, float, score, kTileSlots);
  CARVE_FROM(cur, float, w_f32, kHeads);
  CARVE_FROM(cur, bfloat16_t, w_bf16, kHeads);
  CARVE_FROM(cur, int32_t, page_tmp, 64);
  CARVE_FROM(cur, float, tok_val, kFTokCap);
  CARVE_FROM(cur, int32_t, tok_idx, kFTokCap);
  CARVE_FROM(cur, float, sc_iota, kFTokCap);
  CARVE_FROM(cur, int32_t, out32, kTopk);
  CARVE_FROM(cur, int32_t, neg_ones, kTopk);

  DecodeSplitSeg* sp_nram = meta.sp_nram;
  DecodeMergeHeader* hdr_stage = meta.hdr_stage;
  DecodeMergeHeader* hdr_g = reinterpret_cast<DecodeMergeHeader*>(
      params.workspace + params.plan.header_offset);
  DecodeSplitSeg* splits_g = reinterpret_cast<DecodeSplitSeg*>(
      params.workspace + params.plan.split_seg_offset);

  bool neg_ready = false;
  const bool need_merge_hdr = (params.plan.do_split == 1);
  const int cores = params.plan.cores;
  bool can_any_split = (has_row_cache && meta.global_max_n > 1792);
  const bool split_mode =
      (need_merge_hdr && can_any_split && 2 * v_rows <= cores &&
       v_rows <= kDecodeMaxSplitSegs);

  int64_t u_begin = taskId;
  int64_t u_end = v_rows;
  int64_t u_step = taskDim;
  int c_lo = 0;
  int part = 0;
  int max_team = 1;

  if (split_mode) {
    if (taskId == 0) {
      hdr_stage->num_splits = static_cast<int32_t>(v_rows);
      __sync();
      __memcpy(hdr_g, hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    if (taskId >= cores) return;
    const int u_assigned = CoreOf(taskId, cores, static_cast<int>(v_rows));
    c_lo =
        static_cast<int>(CoreLo(cores, u_assigned, static_cast<int>(v_rows)));
    const int c_hi = static_cast<int>(
        CoreLo(cores, u_assigned + 1, static_cast<int>(v_rows)));
    part = taskId - c_lo;
    max_team = (c_hi - c_lo) < kDecodeMaxFilterTeam ? (c_hi - c_lo)
                                                    : kDecodeMaxFilterTeam;
    if (part >= max_team) return;
    u_begin = u_assigned;
    u_end = u_assigned + 1;
    u_step = 1;
  } else {
    if (need_merge_hdr && taskId == 0) {
      hdr_stage->num_splits = 0;
      __sync();
      __memcpy(hdr_g, hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    if (taskId >= v_rows) return;
  }

  const bool prefetched_first_row = (!has_row_cache && u_begin < u_end);
  if (prefetched_first_row) {
    __memcpy_async(page_tmp,
                   params.query_batch_indices + u_begin,
                   sizeof(int32_t),
                   GDRAM2NRAM);
    __memcpy_async(page_tmp + 1,
                   params.query_positions + u_begin,
                   sizeof(int32_t),
                   GDRAM2NRAM);
  }
  __memcpy(sc_iota, meta.c_iota64, 64 * sizeof(float), NRAM2NRAM);
  __sync_move();
  for (int len = 64; len < kFTokCap; len *= 2) {
    const int step = (kFTokCap - len) < len ? (kFTokCap - len) : len;
    __bang_add_scalar(sc_iota + len, sc_iota, static_cast<float>(len), step);
  }
  __sync_compute();
  const float* iota_f256_ptr = sc_iota;
  const float* pat64_ptr = meta.c_pat64;
  (void)iota_f256;
  (void)pat64;
  Scratch scratch{k_f32, k_f32 + kFTokCap, k_f32 + 2 * kFTokCap, sc_iota};

  int32_t* xa = reinterpret_cast<int32_t*>(qk);
  int32_t* xb = xa + kBlocks;
  float* idf = reinterpret_cast<float*>(xb + kBlocks);
  float* xf = idf + kBlocks;
  float* keepf = xf + kBlocks;
  int32_t* rm1 = reinterpret_cast<int32_t*>(k_f32);
  float* fm0 = k_f32 + kBlocks;
  float* fm1 = fm0 + kBlocks;
  uint32_t* k_boff32_all = reinterpret_cast<uint32_t*>(k_boff64_all);
  const bool use_u32_boff = (params.paged_rows < (int64_t{1} << 24));

  const bfloat16_t* query = static_cast<const bfloat16_t*>(params.query);
  const bfloat16_t* weights = static_cast<const bfloat16_t*>(params.weights);
  const bfloat16_t* paged_k = static_cast<const bfloat16_t*>(params.paged_k);

  int cached_b = -1;
  int32_t cached_hl = 0;
  for (int64_t u = u_begin; u < u_end; u += u_step) {
    int b = 0;
    int32_t n_u = 0;
    if (has_row_cache) {
      b = meta.row_b[u];
      n_u = meta.row_n[u];
    } else {
      if (u != u_begin || !prefetched_first_row) {
        __memcpy_async(page_tmp,
                       params.query_batch_indices + u,
                       sizeof(int32_t),
                       GDRAM2NRAM);
        __memcpy_async(page_tmp + 1,
                       params.query_positions + u,
                       sizeof(int32_t),
                       GDRAM2NRAM);
      }
      __sync_io();
      b = page_tmp[0];
      const int32_t qpos = page_tmp[1];
      if (b != cached_b) {
        __memcpy(page_tmp + 2,
                 params.history_lengths + b,
                 sizeof(int32_t),
                 GDRAM2NRAM);
        __sync_io();
        cached_hl = page_tmp[2];
        cached_b = b;
      }
      n_u = ReadableCountFast32(qpos, cached_hl, params.ratio);
    }

    int eff_team = 0;
    do {
      if (n_u <= 0) {
        if (part == 0) {
          if (!neg_ready) {
            __bang_write_value(neg_ones, kTopk, -1);
            __sync_compute();
            neg_ready = true;
          }
          __memcpy(params.topk_indices + u * kTopk,
                   neg_ones,
                   kTopk * sizeof(int32_t),
                   NRAM2GDRAM);
          __sync_io();
        }
        break;
      }

      __sync();
      LoadQueriesMap16(wram_k, query + u * kHeads * kDim, 1, GDRAM2WRAM);
      __memcpy_async(w_bf16,
                     weights + u * kHeads,
                     kHeads * sizeof(bfloat16_t),
                     GDRAM2NRAM);

      const int n_reach_blocks = (n_u + kBlockSize - 1) / kBlockSize;
      const int nu = SortReachableCandidates(params.candidate_ids + u * kBlocks,
                                             n_reach_blocks,
                                             xa,
                                             xb,
                                             idf,
                                             xf,
                                             keepf,
                                             rm1,
                                             fm0,
                                             fm1,
                                             ub_f);
      if (nu <= 0) {
        __sync_io();
        if (part == 0) {
          if (!neg_ready) {
            __bang_write_value(neg_ones, kTopk, -1);
            __sync_compute();
            neg_ready = true;
          }
          __memcpy(params.topk_indices + u * kTopk,
                   neg_ones,
                   kTopk * sizeof(int32_t),
                   NRAM2GDRAM);
          __sync_io();
        }
        break;
      }

      const int nt = (nu + BPT - 1) / BPT;
      const int max_by_nt = nt / 4;
      eff_team = (max_team > 1 && max_by_nt >= 2)
                     ? (max_by_nt < max_team ? max_by_nt : max_team)
                     : 1;
      if (part >= eff_team) {
        __sync_io();
        break;
      }

      const int t_lo =
          eff_team > 1 ? static_cast<int>(CoreLo(nt, part, eff_team)) : 0;
      const int t_hi =
          eff_team > 1 ? static_cast<int>(CoreLo(nt, part + 1, eff_team)) : nt;
      const int na = t_hi - t_lo;

      const int b_slice_lo = t_lo * BPT;
      const int b_slice_hi = (t_hi * BPT) < nu ? (t_hi * BPT) : nu;
      const int b_slice_cnt = b_slice_hi - b_slice_lo;
      const int slice64_lo = (b_slice_lo / 64) * 64;
      const int slice64_hi_raw =
          slice64_lo + ((b_slice_hi - slice64_lo + 63) / 64) * 64;
      const int nu64 = (nu + 63) / 64 * 64;
      const int slice64_len = slice64_hi_raw - slice64_lo;

      if (nu64 > nu) {
        for (int j = nu; j < nu64; ++j) {
          ub_f[j] = static_cast<float>(kMaxPositionSentinel / kBlockSize);
        }
        __sync();
      }

      // Wait for query & weights DMA (already arrived during
      // SortReachableCandidates)
      __sync_io();

      if (slice64_len > 0) {
        __bang_float2int32(
            ub_i + slice64_lo, ub_f + slice64_lo, slice64_len, 0);
        const int32_t* table_b = params.paged_block_table +
                                 static_cast<int64_t>(b) * params.max_pages;
        __sync_compute();
        const int span_p =
            (b_slice_cnt > 0)
                ? ((ub_i[b_slice_lo + b_slice_cnt - 1] >> page.block_shift) -
                   (ub_i[b_slice_lo] >> page.block_shift) + 1)
                : 0;
        if (span_p == 1 || (b_slice_cnt >= 384 && span_p <= 4096 &&
                            b_slice_cnt >= 2 * span_p)) {
          LoadSortedBlockPages(params.page,
                               table_b,
                               ub_i + b_slice_lo,
                               b_slice_cnt,
                               page_all + b_slice_lo,
                               k_f32,
                               sc_iota);
        } else {
          uint32_t* p_boff = reinterpret_cast<uint32_t*>(qk);
          __bang_band_scalar(xa + slice64_lo,
                             ub_i + slice64_lo,
                             ~page.block_mask,
                             slice64_len);
          __bang_int322float(xf + slice64_lo, xa + slice64_lo, slice64_len, 0);
          __bang_mul_scalar(xf + slice64_lo,
                            xf + slice64_lo,
                            4.0f * page.inverse_blocks,
                            slice64_len);
          __bang_float2int32(reinterpret_cast<int32_t*>(p_boff) + slice64_lo,
                             xf + slice64_lo,
                             slice64_len,
                             0);
          __sync_compute();
          if (b_slice_cnt > 0) {
            __gather_async(page_all + b_slice_lo,
                           table_b,
                           p_boff + b_slice_lo,
                           sizeof(int32_t),
                           GDRAM2NRAM,
                           sizeof(int32_t),
                           b_slice_cnt);
          }
        }
      }

      // Overlap weight conversion + slice-local slot_all_i expansion with
      // the GDRAM2NRAM page_all gather!
      if (params.logits_dtype == kLogitsFp32) {
        __bang_bfloat162float(w_f32, w_bf16, kHeads);
      }

      if (slice64_len > 0) {
        float* rows8 = k_f32;
        float* slot_f = k_f32 + kBlocks * kBlockSize;
        __bang_mul_scalar(xf + slice64_lo,
                          ub_f + slice64_lo,
                          static_cast<float>(kBlockSize),
                          slice64_len);
        __bang_write_value(rows8, kBlockSize * slice64_len, 0.0f);
        __bang_cycle_add(rows8,
                         rows8,
                         xf + slice64_lo,
                         kBlockSize * slice64_len,
                         slice64_len);
        __bang_transpose(slot_f, rows8, kBlockSize, slice64_len);
        __bang_cycle_add(slot_f,
                         slot_f,
                         const_cast<float*>(pat64_ptr),
                         kBlockSize * slice64_len,
                         64);
        __bang_float2int32(slot_all_i + slice64_lo * kBlockSize,
                           slot_f,
                           kBlockSize * slice64_len,
                           0);
      }
      __sync_io();

      if (use_u32_boff) {
        if (slice64_len > 0) {
          __bang_mul_scalar(
              xa + slice64_lo, page_all + slice64_lo, page.bytes, slice64_len);
          __bang_band_scalar(
              xb + slice64_lo, ub_i + slice64_lo, page.block_mask, slice64_len);
          __bang_mul_scalar(
              xb + slice64_lo, xb + slice64_lo, 2048, slice64_len);
          __bang_add(reinterpret_cast<int32_t*>(k_boff32_all) + slice64_lo,
                     xa + slice64_lo,
                     xb + slice64_lo,
                     slice64_len);
        }
      } else {
        for (int j = b_slice_lo; j < b_slice_hi; ++j) {
          const uint64_t blk_idx =
              (static_cast<uint64_t>(static_cast<uint32_t>(page_all[j]))
               << page.block_shift) |
              static_cast<uint64_t>(ub_i[j] & page.block_mask);
          k_boff64_all[j] = blk_idx << 11;
        }
      }
      __sync();

      Pool tok{tok_val, tok_idx, 0, -INFINITY, kTopk, kFTokCap};
      bool full_ring[2] = {false, false};
      const bool direct_full_slice =
          (na > 0 && na * kTileSlots <= kFTokCap && b_slice_cnt == na * BPT &&
           static_cast<int64_t>(ub_i[b_slice_hi - 1] + 1) * kBlockSize <= n_u);
      if (na > 0) {
        full_ring[0] = LoadFilterSingleTile(params.page,
                                            paged_k,
                                            ub_i,
                                            page_all,
                                            k_boff32_all,
                                            k_boff64_all,
                                            iota_f256_ptr,
                                            kbf,
                                            reach_ring,
                                            use_u32_boff,
                                            n_u,
                                            nu,
                                            t_lo,
                                            0);
        __sync();
      }
      if (direct_full_slice) {
        for (int i = 0; i < na; ++i) {
          const int t = t_lo + i;
          if (i + 1 < na) {
            const int next_st = (i + 1) & 1;
            LoadFilterSingleTile(params.page,
                                 paged_k,
                                 ub_i,
                                 page_all,
                                 k_boff32_all,
                                 k_boff64_all,
                                 iota_f256_ptr,
                                 kbf,
                                 reach_ring,
                                 use_u32_boff,
                                 n_u,
                                 nu,
                                 t + 1,
                                 next_st);
          }
          const bfloat16_t* kb = kbf + (i & 1) * kTileSlots * kDim;
          ScoreTileMap16<1>(tok_val + i * kTileSlots,
                            qk,
                            wram_k,
                            kb,
                            w_f32,
                            w_bf16,
                            1,
                            kTileSlots,
                            params.logits_dtype);
          __sync();
        }
        const int total_n = na * kTileSlots;
        int32_t* slice_slots = slot_all_i + t_lo * kTileSlots;
        __bang_gt_scalar(k_f32, tok_val, -INFINITY, total_n);
        if (static_cast<int>(__bang_count(k_f32, total_n)) == total_n) {
          tok.idx = slice_slots;
          tok.cnt = total_n;
        } else {
          for (int i = 0; i < na; ++i) {
            __memcpy(score,
                     tok_val + i * kTileSlots,
                     kTileSlots * sizeof(float),
                     NRAM2NRAM);
            __sync_move();
            PoolOffer(tok,
                      score,
                      slice_slots + i * kTileSlots,
                      nullptr,
                      kTileSlots,
                      pool_mask,
                      scratch);
          }
        }
      } else {
        for (int i = 0; i < na; ++i) {
          const int t = t_lo + i;
          if (i + 1 < na) {
            const int next_st = (i + 1) & 1;
            full_ring[next_st] = LoadFilterSingleTile(params.page,
                                                      paged_k,
                                                      ub_i,
                                                      page_all,
                                                      k_boff32_all,
                                                      k_boff64_all,
                                                      iota_f256_ptr,
                                                      kbf,
                                                      reach_ring,
                                                      use_u32_boff,
                                                      n_u,
                                                      nu,
                                                      t + 1,
                                                      next_st);
          }
          const int st = i & 1;
          const int nb = (nu - t * BPT) < BPT ? (nu - t * BPT) : BPT;
          const int nco = (nb * kBlockSize + 63) / 64 * 64;
          const bfloat16_t* kb = kbf + st * kTileSlots * kDim;
          ScoreTileMap16<1>(score,
                            qk,
                            wram_k,
                            kb,
                            w_f32,
                            w_bf16,
                            1,
                            nco,
                            params.logits_dtype);
          PoolOffer(tok,
                    score,
                    slot_all_i + t * kTileSlots,
                    full_ring[st] ? nullptr : (reach_ring + st * kTileSlots),
                    nco,
                    pool_mask,
                    scratch);
          __sync();
        }
      }

      if (tok.cnt > kTopk) PoolCompact(tok, scratch, eff_team > 1);
      const int cnt = tok.cnt;
      if (eff_team <= 1) {
        if (cnt == kTopk) {
          __memcpy(params.topk_indices + u * kTopk,
                   tok.idx,
                   kTopk * sizeof(int32_t),
                   NRAM2GDRAM);
        } else {
          if (!neg_ready) {
            __bang_write_value(neg_ones, kTopk, -1);
            __sync_compute();
            neg_ready = true;
          }
          if (cnt <= 0) {
            __memcpy(params.topk_indices + u * kTopk,
                     neg_ones,
                     kTopk * sizeof(int32_t),
                     NRAM2GDRAM);
          } else {
            __memcpy(
                out32, neg_ones, (kTopk - cnt) * sizeof(int32_t), NRAM2NRAM);
            __memcpy(out32 + (kTopk - cnt),
                     tok.idx,
                     cnt * sizeof(int32_t),
                     NRAM2NRAM);
            __sync();
            __memcpy(params.topk_indices + u * kTopk,
                     out32,
                     kTopk * sizeof(int32_t),
                     NRAM2GDRAM);
          }
        }
        __sync_io();
      } else {
        int32_t* tok_cnt_g = reinterpret_cast<int32_t*>(
            params.workspace + params.plan.tok_part_cnt_offset);
        page_tmp[0] = cnt;
        __sync();
        __memcpy_async(
            tok_cnt_g + static_cast<int64_t>(c_lo + part) * kDecodeSegQ,
            page_tmp,
            sizeof(int32_t),
            NRAM2GDRAM);
        if (cnt > 0) {
          const int64_t item =
              static_cast<int64_t>(c_lo + part) * kDecodeTokSlotStride;
          float* pv = reinterpret_cast<float*>(
                          params.workspace + params.plan.tok_part_val_offset) +
                      item;
          int32_t* pi =
              reinterpret_cast<int32_t*>(params.workspace +
                                         params.plan.tok_part_idx_offset) +
              item;
          __memcpy_async(pv, tok.val, cnt * sizeof(float), NRAM2GDRAM);
          __memcpy_async(pi, tok.idx, cnt * sizeof(int32_t), NRAM2GDRAM);
        }
        __sync_io();
      }
    } while (false);

    if (split_mode && part == 0) {
      sp_nram->row0 = static_cast<int32_t>(u);
      sp_nram->nq = 1;
      sp_nram->first_slot = c_lo;
      sp_nram->num_parts = eff_team > 1 ? eff_team : 0;
      __sync();
      __memcpy(splits_g + u, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
      __sync_io();
    }
  }
}

// =============================================================================
// FILTER Candidate-Union Kernel (sched_override == 3):
// Intra-request union over up to 8 queries using pair-packed co=64 convs.
// =============================================================================

__mlu_func__ __attribute__((always_inline)) bool LoadUnionTile(
    const PageLayout& page,
    const bfloat16_t* paged_k,
    const int32_t* table_b,
    const int32_t* uid_src,
    const int32_t* ubit_src,
    bool src_in_nram,
    bool use_u32_boff,
    int nq,
    const int32_t* n_read,
    int seg_min_n,
    int total_blocks,
    int tile,
    int ring,
    bfloat16_t* kbf,
    int32_t* slot_ring,
    int32_t* bits_ring,
    int32_t* ub_tmp,
    int32_t* page_tmp,
    uint32_t* p_boff,
    uint64_t* k_boff,
    float* ub_f64,
    float* rows8,
    float* slot_f,
    const float* pat64) {
  constexpr int N = kTileSlots;
  constexpr int BPT = N / kBlockSize;
  constexpr uint32_t kBlockBytes = kBlockSize * kDim * sizeof(bfloat16_t);
  constexpr int32_t kPadBlk = (1 << 23) / kBlockSize;
  const int b_off = tile * BPT;
  const int nb = (total_blocks - b_off) < BPT ? (total_blocks - b_off) : BPT;
  const int n = nb * kBlockSize;
  const int nco = (n + 63) / 64 * 64;

  int32_t* bits_dst = bits_ring + ring * BPT;
  int32_t* slot_dst = slot_ring + ring * N;
  if (src_in_nram) {
    __memcpy(ub_tmp, uid_src + b_off, nb * sizeof(int32_t), NRAM2NRAM);
    __memcpy(bits_dst, ubit_src + b_off, nb * sizeof(int32_t), NRAM2NRAM);
    __sync();
  } else {
    __memcpy_async(ub_tmp, uid_src + b_off, nb * sizeof(int32_t), GDRAM2NRAM);
    __memcpy_async(
        bits_dst, ubit_src + b_off, nb * sizeof(int32_t), GDRAM2NRAM);
    __sync_io();
  }

  for (int j = 0; j < nb; ++j) {
    p_boff[j] = static_cast<uint32_t>((ub_tmp[j] >> page.block_shift) << 2);
  }
  for (int j = nb; j < BPT; ++j) {
    ub_tmp[j] = kPadBlk;
    bits_dst[j] = 0;
  }
  __sync();

  __gather_async(page_tmp,
                 table_b,
                 p_boff,
                 sizeof(int32_t),
                 GDRAM2NRAM,
                 sizeof(int32_t),
                 nb);

  __bang_int322float(ub_f64, ub_tmp, 64, 0);
  __bang_mul_scalar(ub_f64, ub_f64, static_cast<float>(kBlockSize), 64);
  __bang_write_value(rows8, kBlockSize * BPT, 0.0f);
  __bang_cycle_add(rows8, rows8, ub_f64, kBlockSize * BPT, BPT);
  __bang_transpose(slot_f, rows8, kBlockSize, BPT);
  __bang_cycle_add(slot_f, slot_f, pat64, N, 64);
  __bang_float2int32(slot_dst, slot_f, N, 0);

  const bool all_full_w =
      (nb > 0 && ub_tmp[nb - 1] * kBlockSize + kBlockSize <= seg_min_n);
  int valid_w[32];
  if (!all_full_w) {
    for (int j = 0; j < nb; ++j) {
      const int32_t s0 = ub_tmp[j] * kBlockSize;
      if (s0 + kBlockSize <= seg_min_n) {
        valid_w[j] = kBlockSize;
      } else {
        const int32_t bm_mask = bits_dst[j];
        int32_t mx = 0;
        for (int q = 0; q < nq; ++q) {
          if ((bm_mask & (1 << q)) && n_read[q] > mx) mx = n_read[q];
        }
        int w = mx - s0;
        if (w > kBlockSize) w = kBlockSize;
        valid_w[j] = w;
      }
    }
  }
  __sync_io();

  uint32_t* k_boff32 = reinterpret_cast<uint32_t*>(k_boff);
  if (use_u32_boff) {
    for (int j = 0; j < nb; ++j) {
      const uint32_t blk_idx =
          (static_cast<uint32_t>(page_tmp[j]) << page.block_shift) |
          static_cast<uint32_t>(ub_tmp[j] & page.block_mask);
      k_boff32[j] = blk_idx << 11;
    }
  } else {
    for (int j = 0; j < nb; ++j) {
      const uint64_t blk_idx =
          (static_cast<uint64_t>(static_cast<uint32_t>(page_tmp[j]))
           << page.block_shift) |
          static_cast<uint64_t>(ub_tmp[j] & page.block_mask);
      k_boff[j] = blk_idx << 11;
    }
  }
  __sync();

  if (all_full_w) {
    if (use_u32_boff) {
      __gather_async(
          kbf, paged_k, k_boff32, kBlockBytes, GDRAM2NRAM, kBlockBytes, nb);
    } else {
      __gather_async(
          kbf, paged_k, k_boff, kBlockBytes, GDRAM2NRAM, kBlockBytes, nb);
    }
  } else {
    int j = 0;
    while (j < nb) {
      if (valid_w[j] == kBlockSize) {
        const int j0 = j;
        ++j;
        while (j < nb && valid_w[j] == kBlockSize) ++j;
        if (use_u32_boff) {
          __gather_async(kbf + (j0 * kBlockSize) * kDim,
                         paged_k,
                         k_boff32 + j0,
                         kBlockBytes,
                         GDRAM2NRAM,
                         kBlockBytes,
                         j - j0);
        } else {
          __gather_async(kbf + (j0 * kBlockSize) * kDim,
                         paged_k,
                         k_boff + j0,
                         kBlockBytes,
                         GDRAM2NRAM,
                         kBlockBytes,
                         j - j0);
        }
      } else {
        const int w = valid_w[j];
        const int64_t phys_page = static_cast<int64_t>(page_tmp[j]);
        const int32_t blk = ub_tmp[j];
        const bfloat16_t* k_src =
            paged_k +
            (phys_page * page.rows + (blk & page.block_mask) * kBlockSize) *
                kDim;
        bfloat16_t* k_dst = kbf + (j * kBlockSize) * kDim;
        if (w > 0) {
          __memcpy_async(
              k_dst, k_src, w * kDim * sizeof(bfloat16_t), GDRAM2NRAM);
        }
        __bang_write_value(k_dst + w * kDim,
                           (kBlockSize - w) * kDim,
                           static_cast<bfloat16_t>(0));
        ++j;
      }
    }
  }
  if (nco > n) {
    __bang_write_value(
        kbf + n * kDim, (nco - n) * kDim, static_cast<bfloat16_t>(0));
  }
  return all_full_w;
}

__mlu_func__ __attribute__((always_inline)) bool LoadFilterStage3aTile(
    const PageLayout& page,
    const bfloat16_t* paged_k,
    const int32_t* pq_ub_i,
    const int32_t* pq_page_all,
    const uint32_t* pq_k_boff32,
    const uint64_t* pq_k_boff64,
    const float* sc_iota,
    bfloat16_t* kb,
    float* rd,
    bool use_u32_boff,
    int n_u,
    int slice_nu,
    int lt) {
  constexpr int BPT = kTileSlots / kBlockSize;
  constexpr uint32_t kBlockBytes = kBlockSize * kDim * sizeof(bfloat16_t);
  const int b_off = lt * BPT;
  const int nb = (slice_nu - b_off) < BPT ? (slice_nu - b_off) : BPT;
  const int n = nb * kBlockSize;
  const int nco = (n + 63) / 64 * 64;

  const int last_s0 = pq_ub_i[b_off + nb - 1] * kBlockSize;
  const int last_w =
      (n_u - last_s0) < kBlockSize ? (n_u - last_s0) : kBlockSize;
  const int valid_slots = (nb - 1) * kBlockSize + last_w;
  const bool full_reach = (valid_slots == nco);
  if (!full_reach) {
    __bang_lt_scalar(rd, sc_iota, static_cast<float>(valid_slots), nco);
  }

  const int nfull = (last_w == kBlockSize) ? nb : (nb - 1);
  if (nfull > 0) {
    if (use_u32_boff) {
      __gather_async(kb,
                     paged_k,
                     pq_k_boff32 + b_off,
                     kBlockBytes,
                     GDRAM2NRAM,
                     kBlockBytes,
                     nfull);
    } else {
      __gather_async(kb,
                     paged_k,
                     pq_k_boff64 + b_off,
                     kBlockBytes,
                     GDRAM2NRAM,
                     kBlockBytes,
                     nfull);
    }
  }
  if (nfull < nb) {
    const int j_last = nb - 1;
    const int64_t phys_page = static_cast<int64_t>(pq_page_all[b_off + j_last]);
    const int32_t blk_last = pq_ub_i[b_off + j_last];
    const bfloat16_t* k_src =
        paged_k +
        (phys_page * page.rows + (blk_last & page.block_mask) * kBlockSize) *
            kDim;
    bfloat16_t* k_dst = kb + (j_last * kBlockSize) * kDim;
    if (last_w > 0) {
      __memcpy_async(
          k_dst, k_src, last_w * kDim * sizeof(bfloat16_t), GDRAM2NRAM);
    }
    __bang_write_value(k_dst + last_w * kDim,
                       (kBlockSize - last_w) * kDim,
                       static_cast<bfloat16_t>(0));
  }
  if (nco > n) {
    __bang_write_value(
        kb + n * kDim, (nco - n) * kDim, static_cast<bfloat16_t>(0));
  }
  return full_reach;
}

__mlu_func__ __attribute__((always_inline)) void RunDecodeFilterUnionPath(
    const DecodeParams& params,
    int8_t* nram_buf,
    bfloat16_t* wram_buf,
    int64_t v_rows,
    const PackedDecodeMetaBufs& meta) {
  const auto& page = params.page;
  if (taskId >= params.plan.cores) return;

  constexpr int kFTokCap = 2048;
  constexpr int kUWin = 8192;
  constexpr int N = kTileSlots;
  constexpr int BPT = N / kBlockSize;
  int8_t* cur = nram_buf;
  CARVE_FROM(cur, bfloat16_t, kbf, N * kDim);
  CARVE_FROM(cur, float, kf32, N* kDim);
  CARVE_FROM(cur, float, ob, N * 64);
  CARVE_FROM(cur, float, tmp, N * 64);
  CARVE_FROM(cur, float, pq_qk, N* kHeads);
  CARVE_FROM(cur, float, acc, 3 * kDecodeSegQ * N);
  CARVE_FROM(cur, float, tok_buf, 2 * kDecodeSegQ * kSegTokCap);
  CARVE_FROM(cur, float, pq_tok_val, kFTokCap);
  CARVE_FROM(cur, int32_t, pq_tok_idx, kFTokCap);
  CARVE_FROM(cur, float, sc_iota, kFTokCap);
  CARVE_FROM(cur, float, tfm, kDecodeSegQ* N);
  CARVE_FROM(cur, float, rowc, 64);
  CARVE_FROM(cur, float, wv, 4 * 64);
  CARVE_FROM(cur, float, w_f32, kDecodeSegQ* kHeads);
  CARVE_FROM(cur, bfloat16_t, w_bf16, kDecodeSegQ * kHeads);
  CARVE_FROM(cur, int32_t, slot_ring, 3 * N);
  CARVE_FROM(cur, int32_t, bits_ring, 3 * BPT);
  CARVE_FROM(cur, int32_t, ub_tmp, 64);
  CARVE_FROM(cur, int32_t, qbit, kDecodeSegQ);
  CARVE_FROM(cur, int32_t, page_tmp, 64);
  CARVE_FROM(cur, uint32_t, p_boff, 32);
  CARVE_FROM(cur, uint64_t, k_boff, 32);
  CARVE_FROM(cur, float, ub_f64, 64);
  CARVE_FROM(cur, float, rows8, N);
  CARVE_FROM(cur, float, slot_f, N);
  CARVE_FROM(cur, float, pat64, 64);

  float* tok_val = tok_buf;
  int32_t* tok_idx =
      reinterpret_cast<int32_t*>(tok_buf + kDecodeSegQ * kSegTokCap);

  DecodeSplitSeg* sp_nram = meta.sp_nram;
  DecodeMergeHeader* hdr_stage = meta.hdr_stage;
  const bool need_merge_hdr = (params.plan.do_split == 1);
  DecodeMergeHeader* hdr_g = reinterpret_cast<DecodeMergeHeader*>(
      params.workspace + params.plan.header_offset);
  DecodeSplitSeg* splits_g = reinterpret_cast<DecodeSplitSeg*>(
      params.workspace + params.plan.split_seg_offset);

  const bfloat16_t* query = static_cast<const bfloat16_t*>(params.query);
  const bfloat16_t* weights = static_cast<const bfloat16_t*>(params.weights);
  const bfloat16_t* paged_k = static_cast<const bfloat16_t*>(params.paged_k);
  const bool use_u32_boff = (params.paged_rows < (int64_t{1} << 24));
  const bool force_union = (params.plan.sched_override == 3);

  const int num_segs = meta.num_segs;
  const int C = params.plan.cores;
  const bool split_mode = (params.plan.do_split != 0 && 2 * num_segs <= C);
  const uint32_t rem_c_u = static_cast<uint32_t>(C - num_segs);
  const uint32_t v_rows_u = static_cast<uint32_t>(v_rows);
  const int32_t* seg_cum_nq_arr = meta.seg_cum_nq;

  bool all_short_direct = false;
  int s_begin = taskId;
  int s_end = num_segs;
  int s_step = C;
  int c_lo = 0;
  int team = 1;
  if (split_mode) {
    int seg_id = 0;
    int next_c = 1 + static_cast<int>(
                         (rem_c_u * static_cast<uint32_t>(seg_cum_nq_arr[1])) /
                         v_rows_u);
    while (seg_id + 1 < num_segs && next_c <= taskId) {
      c_lo = next_c;
      ++seg_id;
      next_c =
          (seg_id + 1) +
          static_cast<int>(
              (rem_c_u * static_cast<uint32_t>(seg_cum_nq_arr[seg_id + 1])) /
              v_rows_u);
    }
    team = next_c - c_lo;
    if (!need_merge_hdr && !force_union) {
      all_short_direct = true;
    } else if (!force_union) {
      all_short_direct = true;
      int prev_c = 0;
      for (int sg = 0; sg < num_segs; ++sg) {
        const int end_c =
            (sg + 1) +
            static_cast<int>(
                (rem_c_u * static_cast<uint32_t>(seg_cum_nq_arr[sg + 1])) /
                v_rows_u);
        const int t_sg = end_c - prev_c;
        prev_c = end_c;
        const int nq_sg = meta.seg_nq[sg];
        const int mx_sg = meta.seg_max_n[sg];
        const bool short_sg =
            ((t_sg >= nq_sg && mx_sg <= 3072) || (t_sg >= 2 && mx_sg <= 1536) ||
             (nq_sg == 1 && mx_sg <= 1792));
        const bool direct_long_sg =
            (mx_sg > 24576 &&
             (t_sg <= 1 || (t_sg <= nq_sg && (nq_sg % t_sg) == 0)));
        if (!short_sg && !direct_long_sg) {
          all_short_direct = false;
          break;
        }
      }
    }
    if (need_merge_hdr && taskId == 0) {
      hdr_stage->num_splits = all_short_direct ? 0 : num_segs;
      __sync();
      __memcpy(hdr_g, hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    if (all_short_direct) {
      const int nq_my = meta.seg_nq[seg_id];
      if ((taskId - c_lo) >= nq_my) return;
    }
    s_begin = seg_id;
    s_end = seg_id + 1;
    s_step = 1;
  } else {
    if (need_merge_hdr && taskId == 0) {
      hdr_stage->num_splits = 0;
      __sync();
      __memcpy(hdr_g, hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    if (s_begin >= s_end) return;
  }
  const bool skip_split_writes = (!need_merge_hdr || all_short_direct);

  __memcpy(sc_iota, meta.c_iota64, 64 * sizeof(float), NRAM2NRAM);
  __memcpy(qbit, meta.c_qbit16, kDecodeSegQ * sizeof(int32_t), NRAM2NRAM);
  __memcpy(pat64, meta.c_pat64, 64 * sizeof(float), NRAM2NRAM);
  __sync_move();
  for (int len = 64; len < kFTokCap; len *= 2) {
    const int step = (kFTokCap - len) < len ? (kFTokCap - len) : len;
    __bang_add_scalar(sc_iota + len, sc_iota, static_cast<float>(len), step);
  }
  __sync_compute();

  DecodeSegBufs m{kbf,     kf32,    ob,      tmp,     acc,      wv,
                  w_f32,   w_bf16,  nullptr, nullptr, nullptr,  tfm,
                  rowc,    nullptr, nullptr, nullptr, page_tmp, tok_val,
                  tok_idx, nullptr, nullptr, sc_iota, wram_buf};

  int32_t* core_union_g =
      reinterpret_cast<int32_t*>(params.workspace +
                                 params.plan.union_scratch_offset) +
      static_cast<int64_t>(taskId) * kDecodeCoreUnionStride;
  int32_t* uid_g = core_union_g;
  int32_t* ubit_g = core_union_g + kDecodeFilterUnionCap;

  int32_t* tok_cnt_g = reinterpret_cast<int32_t*>(
      params.workspace + params.plan.tok_part_cnt_offset);
  float* tok_pv_g = reinterpret_cast<float*>(params.workspace +
                                             params.plan.tok_part_val_offset);
  int32_t* tok_pi_g = reinterpret_cast<int32_t*>(
      params.workspace + params.plan.tok_part_idx_offset);

  for (int s = s_begin; s < s_end; s += s_step) {
    const int part = split_mode ? (taskId - c_lo) : 0;
    const int b = meta.seg_b[s];
    const int nq = meta.seg_nq[s];
    const int64_t row0 = meta.seg_row0[s];
    const int seg_min_n = meta.seg_min_n[s];
    const int seg_max_n = meta.seg_max_n[s];
    int32_t n_read[kDecodeSegQ];
    for (int q = 0; q < nq; ++q) {
      n_read[q] = meta.row_n[row0 + q];
    }

    const int32_t* table_b =
        params.paged_block_table + static_cast<int64_t>(b) * params.max_pages;

    const bool fast_short_pq = (split_mode && !force_union &&
                                ((team >= nq && seg_max_n <= 3072) ||
                                 (team >= 2 && seg_max_n <= 1536)));
    const bool fast_long_pq = (!force_union && seg_max_n > 24576);
    const bool skip_union = (fast_short_pq || fast_long_pq);

    int pre_q_begin = 0;
    int pre_q_end = nq;
    int pre_q_step = 1;
    int pre_q_parts = 1;
    int pre_p_idx = 0;
    bool pre_write_direct = true;
    bool long_frac_split = false;
    int eff_long_team = 1;
    int max_parts_seg = 1;
    int first_p[kDecodeSegQ];
    int last_p[kDecodeSegQ];

    if (fast_short_pq) {
      if (!skip_split_writes && part == 0) {
        sp_nram->row0 = static_cast<int32_t>(row0);
        sp_nram->nq = nq;
        sp_nram->first_slot = c_lo;
        sp_nram->num_parts = 1;
        __sync();
        __memcpy(splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
        __sync_io();
      }
      if (part >= nq) continue;
      pre_q_begin = part;
      pre_q_end = nq;
      pre_q_step = team;
    } else if (fast_long_pq && split_mode) {
      if (team <= 1 || !need_merge_hdr || (team <= nq && (nq % team) == 0)) {
        if (!skip_split_writes && part == 0) {
          sp_nram->row0 = static_cast<int32_t>(row0);
          sp_nram->nq = nq;
          sp_nram->first_slot = c_lo;
          sp_nram->num_parts = 1;
          __sync();
          __memcpy(splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
          __sync_io();
        }
        if (team > 1) {
          if (part >= nq) continue;
          pre_q_begin = part;
          pre_q_end = nq;
          pre_q_step = team;
        }
      } else {
        const int W = nq * 64;
        eff_long_team = (team < nq * 8) ? team : (nq * 8);
        for (int q = 0; q < nq; ++q) {
          first_p[q] = eff_long_team;
          last_p[q] = -1;
        }
        for (int p = 0; p < eff_long_team; ++p) {
          const int pw0 = (p * W) / eff_long_team;
          const int pw1 = ((p + 1) * W) / eff_long_team;
          for (int q = 0; q < nq; ++q) {
            if (pw1 > q * 64 && pw0 < (q + 1) * 64) {
              if (p < first_p[q]) first_p[q] = p;
              if (p > last_p[q]) last_p[q] = p;
            }
          }
        }
        for (int q = 0; q < nq; ++q) {
          const int pq = last_p[q] - first_p[q] + 1;
          if (pq > max_parts_seg) max_parts_seg = pq;
        }
        if (!skip_split_writes && part == 0) {
          sp_nram->row0 = static_cast<int32_t>(row0);
          sp_nram->nq = nq;
          sp_nram->first_slot = c_lo;
          sp_nram->num_parts = max_parts_seg;
          __sync();
          __memcpy(splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
          __sync_io();
        }
        if (part >= eff_long_team) continue;
        long_frac_split = true;
        pre_write_direct = (max_parts_seg <= 1);
      }
    }

    // Stage 1: Sort reachable candidates into q_lists (tok_buf)
    float* q_lists = tok_buf;
    const int sort_q_begin = skip_union ? pre_q_begin : 0;
    const int sort_q_end = skip_union ? pre_q_end : nq;
    const int sort_q_step = skip_union ? pre_q_step : 1;

    int32_t* xa = reinterpret_cast<int32_t*>(kf32);               // 2K
    int32_t* xb = xa + kBlocks;                                   // 2K
    float* idf = reinterpret_cast<float*>(xb + kBlocks);          // 2K
    float* xf = idf + kBlocks;                                    // 2K
    float* keepf = xf + kBlocks;                                  // 2K
    int32_t* rm1 = reinterpret_cast<int32_t*>(keepf + kBlocks);   // 2K
    float* fm0 = reinterpret_cast<float*>(rm1 + kBlocks);         // 2K
    float* fm1 = fm0 + kBlocks;                                   // 2K
    int32_t* xa_alt = reinterpret_cast<int32_t*>(fm1 + kBlocks);  // 2K

    int nl[kDecodeSegQ];
    int nl64[kDecodeSegQ];
    int max_nl64 = 0;
    int rem_total = 0;
    float perq_tiles = 0.0f;
    int min_blk = 1 << 30;
    int max_blk = -1;

    if (!skip_union && sort_q_begin == 0 && sort_q_step == 1 &&
        !long_frac_split) {
      int32_t* xa_ring[2] = {xa, xa_alt};
      if (sort_q_end > 0 && n_read[0] > 0) {
        __memcpy(xa_ring[0],
                 params.candidate_ids + row0 * kBlocks,
                 kBlocks * sizeof(int32_t),
                 GDRAM2NRAM);
        __sync_io();
      }
      for (int q = 0; q < sort_q_end; ++q) {
        if (q + 1 < sort_q_end && n_read[q + 1] > 0) {
          if (q > 0) {
            __sync_compute();
          }
          __memcpy_async(xa_ring[(q + 1) & 1],
                         params.candidate_ids + (row0 + q + 1) * kBlocks,
                         kBlocks * sizeof(int32_t),
                         GDRAM2NRAM);
        }
        const int n_rb = (n_read[q] + kBlockSize - 1) / kBlockSize;
        float* lq = q_lists + q * kBlocks;
        const int nu_q =
            SortReachableCandidates(params.candidate_ids + (row0 + q) * kBlocks,
                                    n_rb,
                                    xa_ring[q & 1],
                                    xb,
                                    idf,
                                    xf,
                                    keepf,
                                    rm1,
                                    fm0,
                                    fm1,
                                    lq,
                                    /*preloaded_xa=*/(n_rb > 0));
        nl[q] = nu_q;
        const int nu_q64 = (nu_q + 63) / 64 * 64;
        nl64[q] = nu_q64;
        if (nu_q64 > max_nl64) max_nl64 = nu_q64;
        if (nu_q > 0) {
          for (int j = nu_q; j < nu_q64; ++j) lq[j] = -1.0f;
          const int b_lo = static_cast<int>(lq[0]);
          const int b_hi = static_cast<int>(lq[nu_q - 1]);
          if (b_lo < min_blk) min_blk = b_lo;
          if (b_hi > max_blk) max_blk = b_hi;
          rem_total += nu_q;
          perq_tiles += static_cast<float>((nu_q + BPT - 1) / BPT);
        }
        if (q + 1 < sort_q_end && n_read[q + 1] > 0) {
          __sync_io();
        }
      }
    } else {
      for (int q = sort_q_begin; q < sort_q_end; q += sort_q_step) {
        if (long_frac_split && (part < first_p[q] || part > last_p[q]))
          continue;
        const int n_rb = (n_read[q] + kBlockSize - 1) / kBlockSize;
        float* lq = q_lists + q * kBlocks;
        const int nu_q =
            SortReachableCandidates(params.candidate_ids + (row0 + q) * kBlocks,
                                    n_rb,
                                    xa,
                                    xb,
                                    idf,
                                    xf,
                                    keepf,
                                    rm1,
                                    fm0,
                                    fm1,
                                    lq);
        nl[q] = nu_q;
        if (!skip_union) {
          const int nu_q64 = (nu_q + 63) / 64 * 64;
          nl64[q] = nu_q64;
          if (nu_q64 > max_nl64) max_nl64 = nu_q64;
          if (nu_q > 0) {
            for (int j = nu_q; j < nu_q64; ++j) lq[j] = -1.0f;
            const int b_lo = static_cast<int>(lq[0]);
            const int b_hi = static_cast<int>(lq[nu_q - 1]);
            if (b_lo < min_blk) min_blk = b_lo;
            if (b_hi > max_blk) max_blk = b_hi;
            rem_total += nu_q;
            perq_tiles += static_cast<float>((nu_q + BPT - 1) / BPT);
          }
        }
      }
    }
    __sync();

    if (!skip_union && rem_total <= 0) {
      if (part == 0) {
        int32_t* neg = reinterpret_cast<int32_t*>(kf32);
        __bang_write_value(neg, kTopk, -1);
        __sync_compute();
        for (int q = 0; q < nq; ++q) {
          __memcpy_async(params.topk_indices + (row0 + q) * kTopk,
                         neg,
                         kTopk * sizeof(int32_t),
                         NRAM2GDRAM);
        }
        __sync_io();
        if (split_mode && !skip_split_writes) {
          sp_nram->row0 = static_cast<int32_t>(row0);
          sp_nram->nq = nq;
          sp_nram->first_slot = c_lo;
          sp_nram->num_parts = 1;
          __sync();
          __memcpy(splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
          __sync_io();
        }
      }
      continue;
    }

    // Stage 2: Vectorized NRAM windowed scatter+filter bitset union +
    // dynamic crossover gate (keeps <= 4096 union blocks 100% on-chip in pq_qk)
    constexpr int kOnchipUnionCap = (N * kHeads) / 2;  // 4096 blocks
    int32_t* uid_nram = reinterpret_cast<int32_t*>(pq_qk);
    int32_t* ubit_nram = uid_nram + kOnchipUnionCap;
    int u_len = 0;
    bool use_union = false;
    bool onchip_union = false;
    bool all_union_all_q = false;
    bool prefetched_pair_qw = false;
    if (!skip_union && (force_union || nq > 1)) {
      LoadQueriesMap16(wram_buf, query + row0 * kHeads * kDim, nq, GDRAM2WRAM);
      __memcpy_async(w_bf16,
                     weights + row0 * kHeads,
                     nq * kHeads * sizeof(bfloat16_t),
                     GDRAM2NRAM);
      prefetched_pair_qw = true;
      const int groups = (nq + 1) >> 1;
      const float union_cost = 0.8f + 0.8f * static_cast<float>(groups);
      float* bits = ob;
      float* flag = ob + kUWin;
      float* iotaw = tmp;
      float* outid_f = tmp + kUWin;
      float* outbit_f = kf32;
      float* fm0_u = kf32 + kUWin;
      float* fm1_u = fm0_u + kBlocks;
      float* ones = acc;
      uint32_t* soff = reinterpret_cast<uint32_t*>(acc + kBlocks);

      __bang_write_value(ones, max_nl64 > 0 ? max_nl64 : 64, 1.0f);
      __sync_compute();

      const int span_all = max_blk - min_blk + 1;
      if (span_all <= kUWin) {
        const int win_len = (span_all + 63) / 64 * 64;
        const float* iota_u = sc_iota;
        if (win_len > kFTokCap) {
          MakeIotaF(iotaw, win_len);
          iota_u = iotaw;
        }
        __bang_write_value(bits, win_len, 0.0f);
        for (int q = 0; q < nq; ++q) {
          const int cnt = nl[q];
          if (cnt <= 0) continue;
          const int cnt64 = nl64[q];
          const float* lq = q_lists + q * kBlocks;
          __bang_sub_scalar(fm1_u, lq, static_cast<float>(min_blk), cnt64);
          __bang_mul_scalar(
              fm1_u, fm1_u, static_cast<float>(sizeof(float)), cnt64);
          __bang_float2int32(reinterpret_cast<int32_t*>(soff), fm1_u, cnt64, 0);
          __bang_write_value(flag, win_len, 0.0f);
          __sync_compute();
          __scatter(
              flag, ones, soff, sizeof(float), NRAM2NRAM, sizeof(float), cnt);
          __sync_move();
          __bang_mul_scalar(flag, flag, static_cast<float>(1 << q), win_len);
          __bang_add(bits, bits, flag, win_len);
        }
        __bang_gt_scalar(flag, bits, 0.5f, win_len);
        const int nw =
            static_cast<int>(__bang_filter(outid_f, iota_u, flag, win_len));
        const float union_tiles = static_cast<float>((nw + BPT - 1) / BPT);
        if (nw > 0 && (force_union || union_tiles * union_cost < perq_tiles)) {
          __bang_eq_scalar(
              fm0_u, bits, static_cast<float>((1 << nq) - 1), win_len);
          all_union_all_q =
              (static_cast<int>(__bang_count(fm0_u, win_len)) == nw);
          __bang_filter(outbit_f, bits, flag, win_len);
          const int nwr = (nw + 63) / 64 * 64;
          if (min_blk != 0) {
            __bang_add_scalar(
                outid_f, outid_f, static_cast<float>(min_blk), nwr);
          }
          if (nw <= kOnchipUnionCap) {
            __bang_float2int32(uid_nram, outid_f, nwr, 0);
            __bang_float2int32(ubit_nram, outbit_f, nwr, 0);
            __sync_compute();
            onchip_union = true;
          } else {
            int32_t* outid_i = reinterpret_cast<int32_t*>(flag);
            int32_t* outbit_i = reinterpret_cast<int32_t*>(bits);
            __bang_float2int32(outid_i, outid_f, nwr, 0);
            __bang_float2int32(outbit_i, outbit_f, nwr, 0);
            __sync_compute();
            __memcpy(uid_g, outid_i, nw * sizeof(int32_t), NRAM2GDRAM);
            __memcpy(ubit_g, outbit_i, nw * sizeof(int32_t), NRAM2GDRAM);
            __sync_io();
          }
          u_len = nw;
          use_union = true;
        }
      } else {
        MakeIotaF(iotaw, kUWin);
        int q_pos[kDecodeSegQ];
        for (int q = 0; q < nq; ++q) q_pos[q] = 0;
        int rem = rem_total;
        int total = 0;
        bool overflow = false;
        int w0 = min_blk;
        while (w0 <= max_blk && rem > 0) {
          int next_min = max_blk + 1;
          for (int q = 0; q < nq; ++q) {
            if (q_pos[q] < nl[q]) {
              const int bq = static_cast<int>(q_lists[q * kBlocks + q_pos[q]]);
              if (bq < next_min) next_min = bq;
            }
          }
          if (next_min > max_blk) break;
          if (next_min > w0) w0 = next_min;

          const int span =
              (max_blk - w0 + 1) < kUWin ? (max_blk - w0 + 1) : kUWin;
          const int win_len = (span + 63) / 64 * 64;
          __bang_write_value(bits, win_len, 0.0f);
          bool any_in_win = false;
          for (int q = 0; q < nq; ++q) {
            if (q_pos[q] >= nl[q]) continue;
            const float* lq = q_lists + q * kBlocks;
            if (static_cast<int>(lq[q_pos[q]]) >= w0 + span) continue;
            const int nq_len64 = nl64[q];
            __bang_ge_scalar(fm0_u, lq, static_cast<float>(w0), nq_len64);
            __bang_lt_scalar(
                fm1_u, lq, static_cast<float>(w0 + span), nq_len64);
            __bang_mul(fm0_u, fm0_u, fm1_u, nq_len64);
            const int cnt =
                static_cast<int>(__bang_filter(fm1_u, lq, fm0_u, nq_len64));
            if (cnt == 0) continue;
            any_in_win = true;
            q_pos[q] += cnt;
            rem -= cnt;
            const int cnt64 = (cnt + 63) / 64 * 64;
            __bang_sub_scalar(fm1_u, fm1_u, static_cast<float>(w0), cnt64);
            __bang_mul_scalar(
                fm1_u, fm1_u, static_cast<float>(sizeof(float)), cnt64);
            __bang_float2int32(
                reinterpret_cast<int32_t*>(soff), fm1_u, cnt64, 0);
            __bang_write_value(flag, win_len, 0.0f);
            __sync_compute();
            __scatter(
                flag, ones, soff, sizeof(float), NRAM2NRAM, sizeof(float), cnt);
            __sync_move();
            __bang_mul_scalar(flag, flag, static_cast<float>(1 << q), win_len);
            __bang_add(bits, bits, flag, win_len);
          }
          if (!any_in_win) {
            w0 += span;
            continue;
          }
          __bang_gt_scalar(flag, bits, 0.5f, win_len);
          const int nw =
              static_cast<int>(__bang_filter(outid_f, iotaw, flag, win_len));
          const float next_tiles =
              static_cast<float>((total + nw + BPT - 1) / BPT);
          if (total + nw > kDecodeFilterUnionCap ||
              (!force_union && next_tiles * union_cost >= perq_tiles)) {
            overflow = true;
            break;
          }
          __bang_filter(outbit_f, bits, flag, win_len);
          const int nwr = (nw + 63) / 64 * 64;
          if (w0 != 0) {
            __bang_add_scalar(outid_f, outid_f, static_cast<float>(w0), nwr);
          }
          int32_t* outid_i = reinterpret_cast<int32_t*>(flag);
          int32_t* outbit_i = reinterpret_cast<int32_t*>(bits);
          __bang_float2int32(outid_i, outid_f, nwr, 0);
          __bang_float2int32(outbit_i, outbit_f, nwr, 0);
          __sync_compute();
          __memcpy(uid_g + total, outid_i, nw * sizeof(int32_t), NRAM2GDRAM);
          __memcpy(ubit_g + total, outbit_i, nw * sizeof(int32_t), NRAM2GDRAM);
          __sync_io();
          total += nw;
          w0 += span;
        }
        if (!overflow && total > 0) {
          const float union_tiles = static_cast<float>((total + BPT - 1) / BPT);
          if (force_union || union_tiles * union_cost < perq_tiles) {
            u_len = total;
            use_union = true;
          }
        }
      }
      __sync_io();
    }

    // Stage 3a: Single flat inline per-query co=32 loop (zero closure overhead)
    if (!use_union) {
      int q_begin = 0;
      int q_end = nq;
      int q_step = 1;
      int q_parts = 1;
      int p_idx = 0;
      bool write_direct = true;

      if (skip_union) {
        q_begin = pre_q_begin;
        q_end = pre_q_end;
        q_step = pre_q_step;
        q_parts = pre_q_parts;
        p_idx = pre_p_idx;
        write_direct = pre_write_direct;
      } else if (split_mode && team > 1) {
        if (team < 2 * nq || !need_merge_hdr) {
          if (!skip_split_writes && part == 0) {
            sp_nram->row0 = static_cast<int32_t>(row0);
            sp_nram->nq = nq;
            sp_nram->first_slot = c_lo;
            sp_nram->num_parts = 1;
            __sync();
            __memcpy(splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
            __sync_io();
          }
          if (part >= nq) continue;
          q_begin = part;
          q_end = nq;
          q_step = team;
        } else {
          int max_nt = 0;
          for (int q = 0; q < nq; ++q) {
            const int nt_q = (nl[q] + BPT - 1) / BPT;
            if (nt_q > max_nt) max_nt = nt_q;
          }
          q_parts = team / nq;
          if (max_nt >= 8) {
            const int cap_p = max_nt / 4;
            if (q_parts > cap_p) q_parts = cap_p;
          } else {
            q_parts = 1;
          }
          if (q_parts <= 1) {
            if (!skip_split_writes && part == 0) {
              sp_nram->row0 = static_cast<int32_t>(row0);
              sp_nram->nq = nq;
              sp_nram->first_slot = c_lo;
              sp_nram->num_parts = 1;
              __sync();
              __memcpy(
                  splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
              __sync_io();
            }
            if (part >= nq) continue;
            q_begin = part;
            q_end = part + 1;
            q_parts = 1;
          } else {
            if (!skip_split_writes && part == 0) {
              sp_nram->row0 = static_cast<int32_t>(row0);
              sp_nram->nq = nq;
              sp_nram->first_slot = c_lo;
              sp_nram->num_parts = q_parts;
              __sync();
              __memcpy(
                  splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
              __sync_io();
            }
            if (part >= nq * q_parts) continue;
            q_begin = part / q_parts;
            q_end = q_begin + 1;
            p_idx = part % q_parts;
            write_direct = false;
          }
        }
      } else if (split_mode && !skip_split_writes && part == 0) {
        sp_nram->row0 = static_cast<int32_t>(row0);
        sp_nram->nq = nq;
        sp_nram->first_slot = c_lo;
        sp_nram->num_parts = 1;
        __sync();
        __memcpy(splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
        __sync_io();
      }

      int32_t* pq_slot_all = reinterpret_cast<int32_t*>(ob);
      uint64_t* pq_k_boff64 = reinterpret_cast<uint64_t*>(acc);
      uint32_t* pq_k_boff32 = reinterpret_cast<uint32_t*>(pq_k_boff64);
      int32_t* pq_ub_i = reinterpret_cast<int32_t*>(acc + 4096);
      int32_t* pq_page_all = reinterpret_cast<int32_t*>(tfm);
      bfloat16_t* pq_kbf0 = kbf;
      bfloat16_t* pq_kbf1 = reinterpret_cast<bfloat16_t*>(tmp);
      Scratch pq_scratch{kf32, kf32 + kFTokCap, kf32 + 2 * kFTokCap, sc_iota};

      for (int q = q_begin; q < q_end; q += q_step) {
        if (long_frac_split && (part < first_p[q] || part > last_p[q])) {
          continue;
        }
        const int64_t u = row0 + q;
        const int nu = nl[q];
        const int32_t n_u = n_read[q];
        const int nt_q = (nu + BPT - 1) / BPT;
        int t_lo = 0;
        int t_hi = nt_q;
        int q_p_idx = p_idx;
        int z_hi = p_idx + 1;
        if (long_frac_split) {
          const int loc_p = part - first_p[q];
          const int W = nq * 64;
          const int w_lo = (part * W) / eff_long_team;
          const int w_hi = ((part + 1) * W) / eff_long_team;
          const int ov_lo = (w_lo > q * 64 ? w_lo : q * 64) - q * 64;
          const int ov_hi =
              (w_hi < (q + 1) * 64 ? w_hi : (q + 1) * 64) - q * 64;
          t_lo = write_direct ? 0 : ((ov_lo * nt_q) / 64);
          t_hi = write_direct ? nt_q : ((ov_hi * nt_q) / 64);
          q_p_idx = write_direct ? 0 : loc_p;
          z_hi = (!write_direct && part == last_p[q]) ? max_parts_seg
                                                      : (q_p_idx + 1);
        } else if (!write_direct) {
          t_lo = (p_idx * nt_q) / q_parts;
          t_hi = ((p_idx + 1) * nt_q) / q_parts;
        }

        const int64_t part_off =
            static_cast<int64_t>(c_lo + q_p_idx) * kDecodeTokSlotStride +
            q * kTopk;

        if (nu <= 0 || n_u <= 0 || t_lo >= t_hi) {
          if (write_direct) {
            int32_t* neg = reinterpret_cast<int32_t*>(kf32);
            __bang_write_value(neg, kTopk, -1);
            __sync_compute();
            __memcpy(params.topk_indices + u * kTopk,
                     neg,
                     kTopk * sizeof(int32_t),
                     NRAM2GDRAM);
            __sync_io();
          } else {
            page_tmp[0] = 0;
            __sync();
            for (int ep = q_p_idx; ep < z_hi; ++ep) {
              const int64_t cnt_idx =
                  static_cast<int64_t>(c_lo + ep) * kDecodeSegQ + q;
              __memcpy_async(
                  tok_cnt_g + cnt_idx, page_tmp, sizeof(int32_t), NRAM2GDRAM);
            }
            __sync_io();
          }
          continue;
        }

        const int b_base = t_lo * BPT;
        const int b_end = (t_hi * BPT) < nu ? (t_hi * BPT) : nu;
        const int slice_nu = b_end - b_base;
        const int slice_nu64 = (slice_nu + 63) / 64 * 64;
        const int lnt = t_hi - t_lo;
        Pool pq_tok{pq_tok_val, pq_tok_idx, 0, -INFINITY, kTopk, kFTokCap};
        bool pq_full_ring[2] = {false, false};

        __sync();
        LoadQueriesMap16(wram_buf, query + u * kHeads * kDim, 1, GDRAM2WRAM);
        __memcpy_async(w_bf16,
                       weights + u * kHeads,
                       kHeads * sizeof(bfloat16_t),
                       GDRAM2NRAM);

        float* ub_f_slice = tmp;
        int32_t* tmp_i = reinterpret_cast<int32_t*>(pq_qk);
        float* tmp_f = pq_qk + kBlocks;
        uint32_t* p_boff_all = reinterpret_cast<uint32_t*>(pq_qk + 2 * kBlocks);
        float* r8_all = kf32;
        float* sf_all = kf32 + kBlocks * kBlockSize;
        float* x_mul = pq_qk + 3 * kBlocks;

        if (slice_nu <= 256) {
          __memcpy(ub_f_slice,
                   q_lists + q * kBlocks + b_base,
                   slice_nu * sizeof(float),
                   NRAM2NRAM);
          __sync();
          if (slice_nu64 > slice_nu) {
            for (int j = slice_nu; j < slice_nu64; ++j) {
              ub_f_slice[j] =
                  static_cast<float>(kMaxPositionSentinel / kBlockSize);
            }
            __sync();
          }
          __bang_float2int32(pq_ub_i, ub_f_slice, slice_nu64, 0);
          __sync_compute();
          const int32_t s3a_b0 = pq_ub_i[0];
          const int32_t s3a_b1 = pq_ub_i[slice_nu - 1];
          const int s3a_p0 = s3a_b0 >> page.block_shift;
          const int s3a_span_p = (s3a_b1 >> page.block_shift) - s3a_p0 + 1;
          if ((s3a_b1 - s3a_b0 + 1) == slice_nu && s3a_span_p <= 64) {
            __memcpy_async(page_tmp,
                           table_b + s3a_p0,
                           s3a_span_p * sizeof(int32_t),
                           GDRAM2NRAM);
            __bang_band_scalar(tmp_i, pq_ub_i, ~page.block_mask, slice_nu64);
            if (s3a_p0 != 0) {
              __bang_sub_scalar(
                  tmp_i, tmp_i, s3a_p0 << page.block_shift, slice_nu64);
            }
            __bang_int322float(tmp_f, tmp_i, slice_nu64, 0);
            __bang_mul_scalar(
                tmp_f, tmp_f, 4.0f * page.inverse_blocks, slice_nu64);
            __bang_float2int32(
                reinterpret_cast<int32_t*>(p_boff_all), tmp_f, slice_nu64, 0);
            __bang_mul_scalar(
                x_mul, ub_f_slice, static_cast<float>(kBlockSize), slice_nu64);
            __bang_write_value(r8_all, kBlockSize * slice_nu64, 0.0f);
            __bang_cycle_add(
                r8_all, r8_all, x_mul, kBlockSize * slice_nu64, slice_nu64);
            __bang_transpose(sf_all, r8_all, kBlockSize, slice_nu64);
            __bang_cycle_add(
                sf_all, sf_all, pat64, kBlockSize * slice_nu64, 64);
            __bang_float2int32(pq_slot_all, sf_all, kBlockSize * slice_nu64, 0);
            __sync();
            if (params.logits_dtype == kLogitsFp32) {
              __bang_bfloat162float(w_f32, w_bf16, kHeads);
            }
            __gather(pq_page_all,
                     page_tmp,
                     p_boff_all,
                     sizeof(int32_t),
                     NRAM2NRAM,
                     sizeof(int32_t),
                     slice_nu);
            __sync();
          } else {
            __bang_band_scalar(tmp_i, pq_ub_i, ~page.block_mask, slice_nu64);
            __bang_int322float(tmp_f, tmp_i, slice_nu64, 0);
            __bang_mul_scalar(
                tmp_f, tmp_f, 4.0f * page.inverse_blocks, slice_nu64);
            __bang_float2int32(
                reinterpret_cast<int32_t*>(p_boff_all), tmp_f, slice_nu64, 0);
            __sync();

            __gather_async(pq_page_all,
                           table_b,
                           p_boff_all,
                           sizeof(int32_t),
                           GDRAM2NRAM,
                           sizeof(int32_t),
                           slice_nu);

            if (params.logits_dtype == kLogitsFp32) {
              __bang_bfloat162float(w_f32, w_bf16, kHeads);
            }

            __bang_mul_scalar(
                x_mul, ub_f_slice, static_cast<float>(kBlockSize), slice_nu64);
            __bang_write_value(r8_all, kBlockSize * slice_nu64, 0.0f);
            __bang_cycle_add(
                r8_all, r8_all, x_mul, kBlockSize * slice_nu64, slice_nu64);
            __bang_transpose(sf_all, r8_all, kBlockSize, slice_nu64);
            __bang_cycle_add(
                sf_all, sf_all, pat64, kBlockSize * slice_nu64, 64);
            __bang_float2int32(pq_slot_all, sf_all, kBlockSize * slice_nu64, 0);
            __sync_io();
          }

          if (use_u32_boff) {
            __bang_mul_scalar(tmp_i, pq_page_all, page.bytes, slice_nu64);
            int32_t* tmp_i2 = tmp_i + kBlocks;
            __bang_band_scalar(tmp_i2, pq_ub_i, page.block_mask, slice_nu64);
            __bang_mul_scalar(tmp_i2, tmp_i2, 2048, slice_nu64);
            __bang_add(reinterpret_cast<int32_t*>(pq_k_boff32),
                       tmp_i,
                       tmp_i2,
                       slice_nu64);
          } else {
            for (int j = 0; j < slice_nu; ++j) {
              const uint64_t blk_idx =
                  (static_cast<uint64_t>(static_cast<uint32_t>(pq_page_all[j]))
                   << page.block_shift) |
                  static_cast<uint64_t>(pq_ub_i[j] & page.block_mask);
              pq_k_boff64[j] = blk_idx << 11;
            }
          }
          __sync();

          pq_full_ring[0] = LoadFilterStage3aTile(params.page,
                                                  paged_k,
                                                  pq_ub_i,
                                                  pq_page_all,
                                                  pq_k_boff32,
                                                  pq_k_boff64,
                                                  sc_iota,
                                                  pq_kbf0,
                                                  rows8,
                                                  use_u32_boff,
                                                  n_u,
                                                  slice_nu,
                                                  0);
          __sync();
        } else {
          constexpr int head_nu = BPT;
          __bang_move(ub_f_slice,
                      q_lists + q * kBlocks + b_base,
                      slice_nu * sizeof(float));
          __sync_compute();
          if (slice_nu64 > slice_nu) {
            for (int j = slice_nu; j < slice_nu64; ++j) {
              ub_f_slice[j] =
                  static_cast<float>(kMaxPositionSentinel / kBlockSize);
            }
            __sync();
          }
          __bang_write_value(pq_page_all, slice_nu64, 0);
          __bang_float2int32(pq_ub_i, ub_f_slice, slice_nu64, 0);
          __sync_compute();

          LoadSortedBlockPages(params.page,
                               table_b,
                               pq_ub_i,
                               slice_nu,
                               pq_page_all,
                               kf32,
                               sc_iota);

          if (params.logits_dtype == kLogitsFp32) {
            __bang_bfloat162float(w_f32, w_bf16, kHeads);
          }

          if (use_u32_boff) {
            __bang_mul_scalar(tmp_i, pq_page_all, page.bytes, 64);
            int32_t* tmp_i2 = tmp_i + kBlocks;
            __bang_band_scalar(tmp_i2, pq_ub_i, page.block_mask, 64);
            __bang_mul_scalar(tmp_i2, tmp_i2, 2048, 64);
            __bang_add(
                reinterpret_cast<int32_t*>(pq_k_boff32), tmp_i, tmp_i2, 64);
          } else {
            for (int j = 0; j < head_nu; ++j) {
              const uint64_t blk_idx =
                  (static_cast<uint64_t>(static_cast<uint32_t>(pq_page_all[j]))
                   << page.block_shift) |
                  static_cast<uint64_t>(pq_ub_i[j] & page.block_mask);
              pq_k_boff64[j] = blk_idx << 11;
            }
          }
          __sync();

          pq_full_ring[0] = LoadFilterStage3aTile(params.page,
                                                  paged_k,
                                                  pq_ub_i,
                                                  pq_page_all,
                                                  pq_k_boff32,
                                                  pq_k_boff64,
                                                  sc_iota,
                                                  pq_kbf0,
                                                  rows8,
                                                  use_u32_boff,
                                                  n_u,
                                                  slice_nu,
                                                  0);

          __bang_mul_scalar(
              x_mul, ub_f_slice, static_cast<float>(kBlockSize), slice_nu64);
          __bang_write_value(r8_all, kBlockSize * slice_nu64, 0.0f);
          __bang_cycle_add(
              r8_all, r8_all, x_mul, kBlockSize * slice_nu64, slice_nu64);
          __bang_transpose(sf_all, r8_all, kBlockSize, slice_nu64);
          __bang_cycle_add(sf_all, sf_all, pat64, kBlockSize * slice_nu64, 64);
          __bang_float2int32(pq_slot_all, sf_all, kBlockSize * slice_nu64, 0);
          __sync();

          if (use_u32_boff) {
            __bang_mul_scalar(tmp_i, pq_page_all, page.bytes, slice_nu64);
            int32_t* tmp_i2 = tmp_i + kBlocks;
            __bang_band_scalar(tmp_i2, pq_ub_i, page.block_mask, slice_nu64);
            __bang_mul_scalar(tmp_i2, tmp_i2, 2048, slice_nu64);
            __bang_add(reinterpret_cast<int32_t*>(pq_k_boff32),
                       tmp_i,
                       tmp_i2,
                       slice_nu64);
          } else {
            for (int j = head_nu; j < slice_nu; ++j) {
              const uint64_t blk_idx =
                  (static_cast<uint64_t>(static_cast<uint32_t>(pq_page_all[j]))
                   << page.block_shift) |
                  static_cast<uint64_t>(pq_ub_i[j] & page.block_mask);
              pq_k_boff64[j] = blk_idx << 11;
            }
          }
          __sync();
        }
        for (int lt = 0; lt < lnt; ++lt) {
          if (lt + 1 < lnt) {
            const int nst = (lt + 1) & 1;
            pq_full_ring[nst] =
                LoadFilterStage3aTile(params.page,
                                      paged_k,
                                      pq_ub_i,
                                      pq_page_all,
                                      pq_k_boff32,
                                      pq_k_boff64,
                                      sc_iota,
                                      (nst == 0) ? pq_kbf0 : pq_kbf1,
                                      (nst == 0) ? rows8 : slot_f,
                                      use_u32_boff,
                                      n_u,
                                      slice_nu,
                                      lt + 1);
          }
          const int st = lt & 1;
          const int nb =
              (slice_nu - lt * BPT) < BPT ? (slice_nu - lt * BPT) : BPT;
          const int nco = (nb * kBlockSize + 63) / 64 * 64;
          const bfloat16_t* kb = (st == 0) ? pq_kbf0 : pq_kbf1;
          float* rd = pq_full_ring[st] ? nullptr : ((st == 0) ? rows8 : slot_f);

          float* pq_score = kf32 + 3 * kFTokCap;
          float* pq_mask = pq_score + N;
          ScoreTileMap16<1>(pq_score,
                            pq_qk,
                            wram_buf,
                            kb,
                            w_f32,
                            w_bf16,
                            1,
                            nco,
                            params.logits_dtype);
          PoolOffer(pq_tok,
                    pq_score,
                    pq_slot_all + lt * N,
                    rd,
                    nco,
                    pq_mask,
                    pq_scratch);
          __sync();
        }

        if (pq_tok.cnt > kTopk) PoolCompact(pq_tok, pq_scratch, !write_direct);
        const int cnt = pq_tok.cnt;
        if (write_direct) {
          if (cnt == kTopk) {
            __memcpy(params.topk_indices + u * kTopk,
                     pq_tok.idx,
                     kTopk * sizeof(int32_t),
                     NRAM2GDRAM);
            __sync_io();
          } else {
            int32_t* out32 = reinterpret_cast<int32_t*>(kf32);
            __bang_write_value(out32, kTopk, -1);
            __sync_compute();
            if (cnt > 0) {
              __memcpy(out32 + (kTopk - cnt),
                       pq_tok.idx,
                       cnt * sizeof(int32_t),
                       NRAM2NRAM);
              __sync();
            }
            __memcpy(params.topk_indices + u * kTopk,
                     out32,
                     kTopk * sizeof(int32_t),
                     NRAM2GDRAM);
            __sync_io();
          }
        } else {
          const int64_t cnt_idx =
              static_cast<int64_t>(c_lo + q_p_idx) * kDecodeSegQ + q;
          page_tmp[0] = cnt;
          page_tmp[1] = 0;
          __sync();
          __memcpy_async(
              tok_cnt_g + cnt_idx, page_tmp, sizeof(int32_t), NRAM2GDRAM);
          for (int ep = q_p_idx + 1; ep < z_hi; ++ep) {
            const int64_t z_idx =
                static_cast<int64_t>(c_lo + ep) * kDecodeSegQ + q;
            __memcpy_async(
                tok_cnt_g + z_idx, page_tmp + 1, sizeof(int32_t), NRAM2GDRAM);
          }
          if (cnt > 0) {
            __memcpy_async(tok_pv_g + part_off,
                           pq_tok.val,
                           cnt * sizeof(float),
                           NRAM2GDRAM);
            __memcpy_async(tok_pi_g + part_off,
                           pq_tok.idx,
                           cnt * sizeof(int32_t),
                           NRAM2GDRAM);
          }
          __sync_io();
        }
      }
      continue;
    }

    // Stage 3b: Pair-packed co=64 union scoring
    const int na = (u_len + BPT - 1) / BPT;
    int eff_u_team = 1;
    if (split_mode && need_merge_hdr && team > 1 && na >= 6) {
      eff_u_team = team < 16 ? team : 16;
      if (eff_u_team > na / 2) eff_u_team = na / 2;
      if (eff_u_team < 1) eff_u_team = 1;
    }
    if (split_mode && !skip_split_writes && part == 0) {
      sp_nram->row0 = static_cast<int32_t>(row0);
      sp_nram->nq = nq;
      sp_nram->first_slot = c_lo;
      sp_nram->num_parts = eff_u_team;
      __sync();
      __memcpy(splits_g + s, sp_nram, sizeof(DecodeSplitSeg), NRAM2GDRAM);
      __sync_io();
    }
    if (part >= eff_u_team) continue;

    const int u_lo = (part * na) / eff_u_team;
    const int u_hi = ((part + 1) * na) / eff_u_team;
    const int u_na = u_hi - u_lo;

    if (prefetched_pair_qw) {
      if (params.logits_dtype == kLogitsFp32) {
        __bang_bfloat162float(wv, w_bf16, nq * kHeads);
        __sync_compute();
      }
    } else {
      LoadQueriesPairPacked(query, weights, row0, nq, params.logits_dtype, m);
    }

    Pool tok[kDecodeSegQ];
    for (int q = 0; q < nq; ++q) {
      tok[q] = Pool{tok_val + q * kSegTokCap,
                    tok_idx + q * kSegTokCap,
                    0,
                    -INFINITY,
                    kTopk,
                    kSegTokCap};
    }
    Scratch tok_scratch{ob, ob + kSegTokCap, ob + 2 * kSegTokCap, sc_iota};

    const int32_t* uid_src = onchip_union ? uid_nram : uid_g;
    const int32_t* ubit_src = onchip_union ? ubit_nram : ubit_g;
    const bool u_contig = (onchip_union && u_len > 0 &&
                           (uid_src[u_len - 1] - uid_src[0] + 1) == u_len &&
                           (uid_src[0] & 31) == 0);
    const int u_contig_b0 = u_contig ? uid_src[0] : 0;
    const int u_contig_max_pages =
        u_contig ? ((uid_src[u_len - 1] >> page.block_shift) + 1) : 0;
    int32_t* u_page_cache = pq_tok_idx;
    int32_t* u_iota_i256 = pq_tok_idx + 64;
    int u_cache_base = -1;
    int u_cache_end = -1;
    if (u_contig) {
      __bang_float2int32(u_iota_i256, sc_iota, N, 0);
      __sync_compute();
    }

    bfloat16_t* u_kbf0 = kbf;
    bfloat16_t* u_kbf1 = reinterpret_cast<bfloat16_t*>(kf32);
    float* u_qk_nram = kf32 + 16384;
    bool full_ring[3] = {false, false, false};
    int tf_nco = 0;
    bool all_u_tf_neginf = true;
    bool same_u_cnt = true;
    const bool u_direct_split_tok = (eff_u_team > 1 && u_na * N <= kTopk);
    const int64_t u_slot_off =
        static_cast<int64_t>(c_lo + part) * kDecodeTokSlotStride;
    float* u_direct_pv0 =
        u_direct_split_tok ? (tok_pv_g + u_slot_off) : nullptr;
    int32_t* u_direct_pi0 =
        u_direct_split_tok ? (tok_pi_g + u_slot_off) : nullptr;

    const bool first_contig_256 =
        (u_contig && (u_lo * BPT + BPT <= u_len) &&
         ((u_contig_b0 + u_lo * BPT + BPT) * kBlockSize <= seg_min_n));
    if (first_contig_256) {
      const int c0 = (u_contig_b0 + u_lo * BPT) * kBlockSize;
      LoadPagedDenseTile(params.page,
                         paged_k,
                         table_b,
                         c0 + N,
                         u_contig_max_pages,
                         c0,
                         u_kbf0,
                         u_page_cache,
                         &u_cache_base,
                         &u_cache_end);
      __bang_add_scalar(slot_ring, u_iota_i256, c0, N);
      if (!all_union_all_q) {
        __memcpy(
            bits_ring, ubit_src + u_lo * BPT, BPT * sizeof(int32_t), NRAM2NRAM);
      }
      full_ring[0] = true;
    } else {
      full_ring[0] = LoadUnionTile(params.page,
                                   paged_k,
                                   table_b,
                                   uid_src,
                                   ubit_src,
                                   onchip_union,
                                   use_u32_boff,
                                   nq,
                                   n_read,
                                   seg_min_n,
                                   u_len,
                                   u_lo,
                                   0,
                                   u_kbf0,
                                   slot_ring,
                                   bits_ring,
                                   ub_tmp,
                                   page_tmp,
                                   p_boff,
                                   k_boff,
                                   ub_f64,
                                   rows8,
                                   slot_f,
                                   pat64);
    }
    __sync();

    for (int li = 0; li < u_na; ++li) {
      const int i = u_lo + li;
      const int nb = (u_len - i * BPT) < BPT ? (u_len - i * BPT) : BPT;
      const int n = nb * kBlockSize;
      const int nco = (n + 63) / 64 * 64;

      if (li + 1 < u_na) {
        const int nr1 = (li + 1) % 3;
        const int next_i = i + 1;
        bfloat16_t* next_kbf = ((li + 1) & 1) ? u_kbf1 : u_kbf0;
        const bool next_contig_256 =
            (u_contig && (next_i * BPT + BPT <= u_len) &&
             ((u_contig_b0 + next_i * BPT + BPT) * kBlockSize <= seg_min_n));
        if (next_contig_256) {
          const int c0_next = (u_contig_b0 + next_i * BPT) * kBlockSize;
          LoadPagedDenseTile(params.page,
                             paged_k,
                             table_b,
                             c0_next + N,
                             u_contig_max_pages,
                             c0_next,
                             next_kbf,
                             u_page_cache,
                             &u_cache_base,
                             &u_cache_end);
          __bang_add_scalar(slot_ring + nr1 * N, u_iota_i256, c0_next, N);
          if (!all_union_all_q) {
            __memcpy(bits_ring + nr1 * BPT,
                     ubit_src + next_i * BPT,
                     BPT * sizeof(int32_t),
                     NRAM2NRAM);
          }
          full_ring[nr1] = true;
        } else {
          full_ring[nr1] = LoadUnionTile(params.page,
                                         paged_k,
                                         table_b,
                                         uid_src,
                                         ubit_src,
                                         onchip_union,
                                         use_u32_boff,
                                         nq,
                                         n_read,
                                         seg_min_n,
                                         u_len,
                                         next_i,
                                         nr1,
                                         next_kbf,
                                         slot_ring,
                                         bits_ring,
                                         ub_tmp,
                                         page_tmp,
                                         p_boff,
                                         k_boff,
                                         ub_f64,
                                         rows8,
                                         slot_f,
                                         pat64);
        }
      }

      ScoreTileMap16<kDecodeSegQ>(acc,
                                  u_qk_nram,
                                  wram_buf,
                                  (li & 1) ? u_kbf1 : u_kbf0,
                                  wv,
                                  w_bf16,
                                  nq,
                                  nco,
                                  params.logits_dtype);

      const int ring = li % 3;
      const int32_t* ids_tile = slot_ring + ring * N;
      const int len = nq * nco;
      float* reach = acc + kDecodeSegQ * N;
      float* sel = acc + 2 * kDecodeSegQ * N;
      const bool all_reach_one =
          (all_union_all_q && full_ring[ring] && n == nco);

      bool did_bulk_u = false;
      if (all_reach_one && n == N && all_u_tf_neginf && same_u_cnt &&
          (tok[0].cnt + N <= kSegTokCap)) {
        __bang_gt_scalar(sel, acc, -INFINITY, len);
        if (static_cast<int>(__bang_count(sel, len)) == len) {
          const int cnt0 = tok[0].cnt;
          __sync_compute();
          if (u_direct_split_tok) {
            if (nq == 1) {
              __memcpy_async(
                  u_direct_pv0 + cnt0, acc, N * sizeof(float), NRAM2GDRAM);
            } else {
              __memcpy_async(u_direct_pv0 + cnt0,
                             acc,
                             N * sizeof(float),
                             NRAM2GDRAM,
                             kTopk * sizeof(float),
                             N * sizeof(float),
                             nq - 1);
            }
            for (int q = 0; q < nq; ++q) {
              __memcpy_async(u_direct_pi0 + q * kTopk + cnt0,
                             ids_tile,
                             N * sizeof(int32_t),
                             NRAM2GDRAM);
              tok[q].cnt = cnt0 + N;
            }
          } else if (nq == 1) {
            __memcpy_async(
                tok[0].val + cnt0, acc, N * sizeof(float), NRAM2NRAM);
            __memcpy_async(
                tok[0].idx + cnt0, ids_tile, N * sizeof(int32_t), NRAM2NRAM);
            tok[0].cnt = cnt0 + N;
            __sync_move();
          } else {
            __memcpy_async(tok[0].val + cnt0,
                           acc,
                           N * sizeof(float),
                           NRAM2NRAM,
                           kSegTokCap * sizeof(float),
                           N * sizeof(float),
                           nq - 1);
            for (int q = 0; q < nq; ++q) {
              __memcpy_async(
                  tok[q].idx + cnt0, ids_tile, N * sizeof(int32_t), NRAM2NRAM);
              tok[q].cnt = cnt0 + N;
            }
            __sync_move();
          }
          did_bulk_u = true;
        }
      }

      if (!did_bulk_u) {
        same_u_cnt = false;
        if (!all_reach_one) {
          ExpandMembership8(
              reach, bits_ring + ring * BPT, qbit, nco / kBlockSize, ob + 4096);
          if (!full_ring[ring]) {
            float* slot_f_tile = ob;
            __bang_int322float(slot_f_tile, ids_tile, nco, 0);
            for (int q = 0; q < nq; ++q) {
              __bang_lt_scalar(sel + q * nco,
                               slot_f_tile,
                               static_cast<float>(n_read[q]),
                               nco);
            }
            __bang_mul(reach, reach, sel, len);
          }
        }

        if (all_u_tf_neginf) {
          __bang_gt_scalar(sel, acc, -INFINITY, len);
        } else {
          if (nco != tf_nco) {
            for (int q = 0; q < nq; ++q) {
              __bang_write_value(tfm + q * nco, nco, tok[q].tf);
            }
            tf_nco = nco;
          }
          __bang_gt(sel, acc, tfm, len);
        }
        if (!all_reach_one) {
          __bang_mul(sel, sel, reach, len);
        }
        if (__bang_count(sel, len) > 0) {
          RowSums(rowc, sel, nq, nco);
          for (int q = 0; q < nq; ++q) {
            int c = static_cast<int>(rowc[q]);
            if (c == 0) continue;
            Pool& p = tok[q];
            float* score_q = acc + q * nco;
            float* sel_q = sel + q * nco;
            if (p.cnt + c > p.cap) {
              PoolCompact(p, tok_scratch);
              if (all_u_tf_neginf) {
                all_u_tf_neginf = false;
                for (int qq = 0; qq < nq; ++qq) {
                  __bang_write_value(tfm + qq * nco, nco, tok[qq].tf);
                }
                tf_nco = nco;
              } else {
                __bang_write_value(tfm + q * nco, nco, p.tf);
              }
              __bang_gt_scalar(sel_q, score_q, p.tf, nco);
              if (!all_reach_one) {
                __bang_mul(sel_q, sel_q, reach + q * nco, nco);
              }
              c = static_cast<int>(__bang_count(sel_q, nco));
              if (c == 0) continue;
            }
            const int prev_c = p.cnt;
            __bang_filter(p.val + prev_c, score_q, sel_q, nco);
            __bang_filter(reinterpret_cast<float*>(p.idx + prev_c),
                          reinterpret_cast<const float*>(ids_tile),
                          sel_q,
                          nco);
            p.cnt = prev_c + c;
            if (u_direct_split_tok) {
              __sync_compute();
              __memcpy_async(u_direct_pv0 + q * kTopk + prev_c,
                             p.val + prev_c,
                             c * sizeof(float),
                             NRAM2GDRAM);
              __memcpy_async(u_direct_pi0 + q * kTopk + prev_c,
                             p.idx + prev_c,
                             c * sizeof(int32_t),
                             NRAM2GDRAM);
            }
          }
        }
      }
      __sync();
    }
    __sync();

    if (eff_u_team == 1) {
      bool all_full_topk = (nq > 0);
      for (int q = 0; q < nq; ++q) {
        if (tok[q].cnt > kTopk) PoolCompact(tok[q], tok_scratch, false);
        if (tok[q].cnt != kTopk) all_full_topk = false;
      }
      int32_t* out32 = reinterpret_cast<int32_t*>(kf32);
      if (all_full_topk) {
        if (nq == 1) {
          __memcpy(params.topk_indices + row0 * kTopk,
                   tok[0].idx,
                   kTopk * sizeof(int32_t),
                   NRAM2GDRAM);
          __sync_io();
        } else {
          __memcpy(out32,
                   tok[0].idx,
                   kTopk * sizeof(int32_t),
                   NRAM2NRAM,
                   kTopk * sizeof(int32_t),
                   kSegTokCap * sizeof(int32_t),
                   nq - 1);
          __sync();
          __memcpy(params.topk_indices + row0 * kTopk,
                   out32,
                   nq * kTopk * sizeof(int32_t),
                   NRAM2GDRAM);
          __sync_io();
        }
      } else {
        __bang_write_value(out32, nq * kTopk, -1);
        __sync_compute();
        for (int q = 0; q < nq; ++q) {
          const int cnt = tok[q].cnt;
          if (cnt > 0) {
            __memcpy_async(out32 + q * kTopk + (kTopk - cnt),
                           tok[q].idx,
                           cnt * sizeof(int32_t),
                           NRAM2NRAM);
          }
        }
        __sync();
        __memcpy(params.topk_indices + row0 * kTopk,
                 out32,
                 nq * kTopk * sizeof(int32_t),
                 NRAM2GDRAM);
        __sync_io();
      }
    } else {
      for (int q = 0; q < nq; ++q) {
        if (tok[q].cnt > kTopk) PoolCompact(tok[q], tok_scratch);
        const int cnt = tok[q].cnt;
        page_tmp[q] = cnt;
        if (!u_direct_split_tok && cnt > 0) {
          const int64_t off =
              static_cast<int64_t>(c_lo + part) * kDecodeTokSlotStride +
              q * kTopk;
          __memcpy_async(
              tok_pv_g + off, tok[q].val, cnt * sizeof(float), NRAM2GDRAM);
          __memcpy_async(
              tok_pi_g + off, tok[q].idx, cnt * sizeof(int32_t), NRAM2GDRAM);
        }
      }
      __sync();
      __memcpy_async(
          tok_cnt_g + static_cast<int64_t>(c_lo + part) * kDecodeSegQ,
          page_tmp,
          nq * sizeof(int32_t),
          NRAM2GDRAM);
      __sync_io();
    }
  }
}

__mlu_func__ void BuildFilterRowSmallMeta(const DecodeParams& params,
                                          int v_rows,
                                          int32_t* scratch,
                                          PackedDecodeMetaBufs* meta) {
  int32_t* qpos_s = scratch;
  int32_t* hl_s = scratch + 64;
  int32_t* uniq_b = scratch + 128;
  int32_t* row_uidx = scratch + 192;
  __memcpy_async(meta->row_b,
                 params.query_batch_indices,
                 v_rows * sizeof(int32_t),
                 GDRAM2NRAM);
  __memcpy_async(
      qpos_s, params.query_positions, v_rows * sizeof(int32_t), GDRAM2NRAM);
  __sync_io();

  bool id_s1 = (v_rows <= params.bcap);
  for (int r = 0; r < v_rows && id_s1; ++r) {
    if (meta->row_b[r] != r) id_s1 = false;
  }
  if (id_s1) {
    __memcpy(
        hl_s, params.history_lengths, v_rows * sizeof(int32_t), GDRAM2NRAM);
    __sync_io();
    int gmax = 0;
    for (int r = 0; r < v_rows; ++r) {
      const int32_t nr = ReadableCountFast32(qpos_s[r], hl_s[r], params.ratio);
      meta->row_n[r] = nr;
      if (nr > gmax) gmax = nr;
    }
    meta->global_max_n = gmax;
    __sync();
    return;
  }

  int uniq_cnt = 0;
  int32_t b_min = meta->row_b[0];
  int32_t b_max = b_min - 1;
  bool mono_contig = true;
  for (int r = 0; r < v_rows; ++r) {
    const int32_t b = meta->row_b[r];
    int u_idx = -1;
    if (b > b_max) {
      if (uniq_cnt > 0 && b != b_max + 1) mono_contig = false;
      b_max = b;
      u_idx = uniq_cnt++;
      uniq_b[u_idx] = b;
    } else if (uniq_cnt > 0 && b == uniq_b[uniq_cnt - 1]) {
      u_idx = uniq_cnt - 1;
    } else {
      mono_contig = false;
      if (b < b_min) b_min = b;
      for (int u = 0; u < uniq_cnt; ++u) {
        if (uniq_b[u] == b) {
          u_idx = u;
          break;
        }
      }
      if (u_idx < 0) {
        u_idx = uniq_cnt++;
        uniq_b[u_idx] = b;
      }
    }
    row_uidx[r] = u_idx;
  }

  const int64_t b_span =
      static_cast<int64_t>(b_max) - static_cast<int64_t>(b_min) + 1;
  int32_t* uhl = scratch + 256;
  if (b_span == uniq_cnt) {
    __memcpy(hl_s,
             params.history_lengths + b_min,
             uniq_cnt * sizeof(int32_t),
             GDRAM2NRAM);
    __sync_io();
    if (mono_contig) {
      uhl = hl_s;
    } else {
      for (int u = 0; u < uniq_cnt; ++u) uhl[u] = hl_s[uniq_b[u] - b_min];
    }
  } else {
    for (int u = 0; u < uniq_cnt; ++u) {
      __memcpy_async(uhl + u,
                     params.history_lengths + uniq_b[u],
                     sizeof(int32_t),
                     GDRAM2NRAM);
    }
    __sync_io();
  }

  int gmax = 0;
  for (int r = 0; r < v_rows; ++r) {
    const int32_t nr =
        ReadableCountFast32(qpos_s[r], uhl[row_uidx[r]], params.ratio);
    meta->row_n[r] = nr;
    if (nr > gmax) gmax = nr;
  }
  meta->global_max_n = gmax;
  __sync();
}

__mlu_global__ void DecodeFilterRowKernel(DecodeParams params) {
  if (__is_mpu()) return;

  __nram__ int8_t nram_buf[484 * 1024];
  __wram__ bfloat16_t wram_buf[kMap16WramBytes / sizeof(bfloat16_t)];

  PackedDecodeMetaBufs meta{};
  CarvePackedDecodeMeta(nram_buf + 472 * 1024, &meta);
  int32_t* scratch = reinterpret_cast<int32_t*>(nram_buf);

  __memcpy_async(
      meta.meta_tmp, params.num_valid_input_rows, sizeof(int32_t), GDRAM2NRAM);
  InitDecodeMetaConsts(meta.c_iota64, meta.c_pat64, meta.c_qbit16);
  __sync_io();
  __sync_compute();

  int64_t v_rows = meta.meta_tmp[0];
  if (v_rows < 0 || params.bcap <= 0) v_rows = 0;
  if (v_rows > params.ncap) v_rows = params.ncap;

  const bool need_merge_hdr = (params.plan.do_split == 1);
  DecodeMergeHeader* hdr_g = reinterpret_cast<DecodeMergeHeader*>(
      params.workspace + params.plan.header_offset);

  if (v_rows < params.ncap) {
    FillOutputRowsNegOne(params, v_rows, params.ncap, scratch);
  }
  if (v_rows == 0 || params.max_pages == 0 || params.paged_rows == 0) {
    if (v_rows > 0) {
      FillOutputRowsNegOne(params, 0, v_rows, scratch);
    }
    if (need_merge_hdr && taskId == 0) {
      meta.hdr_stage->num_splits = 0;
      __sync();
      __memcpy(hdr_g, meta.hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    return;
  }

  if (v_rows > 32 || !need_merge_hdr || 2 * v_rows > params.plan.cores) {
    RunDecodeFilterRowPath(params, nram_buf, wram_buf, v_rows, false, meta);
    return;
  }

  BuildFilterRowSmallMeta(params, static_cast<int>(v_rows), scratch, &meta);
  RunDecodeFilterRowPath(params, nram_buf, wram_buf, v_rows, true, meta);
}

__mlu_global__ void DecodeFilterUnionKernel(DecodeParams params) {
  if (__is_mpu()) return;

  __nram__ int8_t nram_buf[491 * 1024];
  __wram__ bfloat16_t wram_buf[kMap16WramBytes / sizeof(bfloat16_t)];

  PackedDecodeMetaBufs meta{};
  CarvePackedDecodeMeta(nram_buf + 482 * 1024, &meta);
  int32_t* scratch = reinterpret_cast<int32_t*>(nram_buf);

  __memcpy_async(
      meta.meta_tmp, params.num_valid_input_rows, sizeof(int32_t), GDRAM2NRAM);
  InitDecodeMetaConsts(meta.c_iota64, meta.c_pat64, meta.c_qbit16);
  __sync_io();
  __sync_compute();

  int64_t v_rows = meta.meta_tmp[0];
  if (v_rows < 0 || params.bcap <= 0) v_rows = 0;
  if (v_rows > params.ncap) v_rows = params.ncap;

  const bool need_merge_hdr = (params.plan.do_split == 1);
  DecodeMergeHeader* hdr_g = reinterpret_cast<DecodeMergeHeader*>(
      params.workspace + params.plan.header_offset);

  if (v_rows < params.ncap) {
    FillOutputRowsNegOne(params, v_rows, params.ncap, scratch);
  }
  if (v_rows == 0 || params.max_pages == 0 || params.paged_rows == 0) {
    if (v_rows > 0) {
      FillOutputRowsNegOne(params, 0, v_rows, scratch);
    }
    if (need_merge_hdr && taskId == 0) {
      meta.hdr_stage->num_splits = 0;
      __sync();
      __memcpy(hdr_g, meta.hdr_stage, sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
    }
    return;
  }

  // Non-split uniform [b_act, s0] fast path when 2 * b_act > C (e.g. B=24/32,
  // S=2..6): each core only populates its own segment(s), skipping whole-batch
  // 192-row metadata construction! Reuses preloaded row_b & qpos on
  // fallthrough.
  bool preloaded_rows = false;
  if (v_rows > 28 && v_rows <= kDecodeRowCacheCap) {
    const int vr = static_cast<int>(v_rows);
    __memcpy_async(meta.row_b,
                   params.query_batch_indices,
                   vr * sizeof(int32_t),
                   GDRAM2NRAM);
    __memcpy_async(
        scratch, params.query_positions, vr * sizeof(int32_t), GDRAM2NRAM);
    __sync_io();
    preloaded_rows = true;
    int s0 = 0;
    if (meta.row_b[0] == 0) {
      s0 = 1;
      while (s0 < vr && s0 <= kDecodeSegQ && meta.row_b[s0] == 0) ++s0;
    }
    if (s0 >= 2 && s0 <= kDecodeSegQ && (vr % s0) == 0 &&
        2 * (vr / s0) > params.plan.cores) {
      const int vr64 = (vr + 63) / 64 * 64;
      const int rem_len = vr - s0;
      const int rem64 = (rem_len + 63) / 64 * 64;
      float* qbf_u = reinterpret_cast<float*>(scratch + kDecodeRowCacheCap);
      float* qbf_next_u = qbf_u + kDecodeRowCacheCap;
      float* diff_u = qbf_next_u + kDecodeRowCacheCap;
      for (int i = vr; i < vr64; ++i) meta.row_b[i] = meta.row_b[vr - 1];
      __sync();
      __bang_int322float(qbf_u, meta.row_b, vr64, 0);
      __sync_compute();
      __memcpy(qbf_next_u, qbf_u + s0, rem_len * sizeof(float), NRAM2NRAM);
      for (int i = rem_len; i < rem64; ++i) qbf_next_u[i] = qbf_u[i] + 1.0f;
      __sync();
      __bang_sub(diff_u, qbf_next_u, qbf_u, rem64);
      __bang_ne_scalar(diff_u, diff_u, 1.0f, rem64);
      if (static_cast<int>(__bang_count(diff_u, rem64)) == 0) {
        const int b_act = vr / s0;
        meta.num_segs = b_act;
        meta.max_seg_nq = s0;
        if (taskId < params.plan.cores) {
          for (int s = taskId; s < b_act; s += params.plan.cores) {
            const int r0 = s * s0;
            __memcpy(scratch + kDecodeRowCacheCap,
                     params.history_lengths + s,
                     sizeof(int32_t),
                     GDRAM2NRAM);
            __sync_io();
            const int32_t hl = scratch[kDecodeRowCacheCap];
            int32_t mn = 1 << 30;
            int32_t mx = 0;
            for (int q = 0; q < s0; ++q) {
              const int32_t nr =
                  ReadableCountFast32(scratch[r0 + q], hl, params.ratio);
              meta.row_n[r0 + q] = nr;
              if (nr < mn) mn = nr;
              if (nr > mx) mx = nr;
            }
            meta.seg_b[s] = s;
            meta.seg_row0[s] = r0;
            meta.seg_nq[s] = s0;
            meta.seg_min_n[s] = mn;
            meta.seg_max_n[s] = mx;
          }
        }
        __sync();
        RunDecodeFilterUnionPath(params, nram_buf, wram_buf, v_rows, meta);
        return;
      }
    }
  }

  BuildPackedDecodeMeta(params,
                        static_cast<int>(v_rows),
                        kDecodeSegQ,
                        scratch,
                        &meta,
                        nullptr,
                        preloaded_rows,
                        false);
  RunDecodeFilterUnionPath(params, nram_buf, wram_buf, v_rows, meta);
}

// =============================================================================
// Merge Kernel for Split Segments / Split FILTER Teams
// =============================================================================

__mlu_global__ void DecodeMergeKernel(DecodeParams params) {
  if (__is_mpu()) return;
  constexpr int kMergeCap = 8192;
  constexpr int kMaxCntEntries = kDecodeMaxSplitPieceSlots * kDecodeSegQ;
  __nram__ int8_t nram_buf[280 * 1024];
  int8_t* cur = nram_buf;
  CARVE_FROM(cur, float, pool_val, kMergeCap);
  CARVE_FROM(cur, int32_t, pool_idx, kMergeCap);
  CARVE_FROM(cur, float, m0, kMergeCap);
  CARVE_FROM(cur, float, m1, kMergeCap);
  CARVE_FROM(cur, float, m2, kMergeCap);
  CARVE_FROM(cur, float, iota, kMergeCap);
  CARVE_FROM(cur, float, chunk_val, kBlocks);
  CARVE_FROM(cur, int32_t, chunk_idx, kBlocks);
  CARVE_FROM(cur, float, valid_m, kBlocks);
  CARVE_FROM(cur, float, mask_buf, kBlocks);
  CARVE_FROM(cur, int32_t, out32, kBlocks);
  CARVE_FROM(cur, int32_t, tok_cnt_nram, kMaxCntEntries);
  CARVE_FROM(cur, int32_t, blk_cnt_nram, kMaxCntEntries);
  CARVE_FROM(cur, DecodeMergeHeader, hdr_nram, 1);
  CARVE_FROM(cur, DecodeSplitSeg, splits_nram, kDecodeMaxSplitSegs);
  CARVE_FROM(cur, uint16_t, active_sq, kDecodeMaxSplitSegs* kDecodeSegQ);

  const DecodeMergeHeader* hdr_g = reinterpret_cast<const DecodeMergeHeader*>(
      params.workspace + params.plan.header_offset);
  __memcpy_async(
      hdr_nram,
      hdr_g,
      sizeof(DecodeMergeHeader) + kDecodeMaxSplitSegs * sizeof(DecodeSplitSeg),
      GDRAM2NRAM);
  InitIota64F(iota);
  __sync_io();
  const int num_splits = hdr_nram->num_splits;
  if (num_splits <= 0) return;

  int max_slot_end = 0;
  int n_active_sq = 0;
  for (int i = 0; i < num_splits; ++i) {
    const int np = splits_nram[i].num_parts;
    if (np > 1) {
      const int end_s = splits_nram[i].first_slot + np;
      if (end_s > max_slot_end) max_slot_end = end_s;
      const int nq_i = splits_nram[i].nq;
      for (int q = 0; q < nq_i; ++q) {
        active_sq[n_active_sq++] = static_cast<uint16_t>((i << 3) | q);
      }
    }
  }
  if (max_slot_end <= 0 || n_active_sq <= 0) return;

  const int kinds = (params.mode == kSource) ? 2 : 1;
  const int total_items = n_active_sq * kinds;
  const int worker_id = (total_items > 8 && total_items <= 16 && taskDim == 32)
                            ? (((taskId & 3) << 3) | (taskId >> 2))
                            : taskId;
  if (worker_id >= total_items) return;

  const int cnt_elems = max_slot_end * kDecodeSegQ;
  const int32_t* tok_cnt_g = reinterpret_cast<const int32_t*>(
      params.workspace + params.plan.tok_part_cnt_offset);
  __memcpy_async(
      tok_cnt_nram, tok_cnt_g, cnt_elems * sizeof(int32_t), GDRAM2NRAM);
  if (params.mode == kSource) {
    const int32_t* blk_cnt_g = reinterpret_cast<const int32_t*>(
        params.workspace + params.plan.blk_part_cnt_offset);
    __memcpy_async(
        blk_cnt_nram, blk_cnt_g, cnt_elems * sizeof(int32_t), GDRAM2NRAM);
  }
  for (int len = 64; len < 4096; len *= 2) {
    __bang_add_scalar(iota + len, iota, static_cast<float>(len), len);
  }
  int iota_built = 4096;
  __sync();
  Scratch scratch{m0, m1, m2, iota};

  const float* tok_pv_g = reinterpret_cast<const float*>(
      params.workspace + params.plan.tok_part_val_offset);
  const int32_t* tok_pi_g = reinterpret_cast<const int32_t*>(
      params.workspace + params.plan.tok_part_idx_offset);
  const float* blk_pv_g =
      (params.mode == kSource)
          ? reinterpret_cast<const float*>(params.workspace +
                                           params.plan.blk_part_val_offset)
          : nullptr;
  const int32_t* blk_pi_g =
      (params.mode == kSource)
          ? reinterpret_cast<const int32_t*>(params.workspace +
                                             params.plan.blk_part_idx_offset)
          : nullptr;

  for (int item = worker_id; item < total_items; item += taskDim) {
    const int kind = (kinds == 2) ? (item & 1) : 0;
    const int sq_packed = active_sq[(kinds == 2) ? (item >> 1) : item];
    const int sp_idx = sq_packed >> 3;
    const int q = sq_packed & 7;
    const int num_parts = splits_nram[sp_idx].num_parts;

    const int64_t orig_row = static_cast<int64_t>(splits_nram[sp_idx].row0) + q;
    const int first_slot = splits_nram[sp_idx].first_slot;

    const int target_k = (kind == 0) ? kTopk : kBlocks;
    const int slot_stride =
        (kind == 0) ? kDecodeTokSlotStride : kDecodeBlkSlotStride;
    const int32_t* cnt_arr = (kind == 0) ? tok_cnt_nram : blk_cnt_nram;
    const float* pv_base = (kind == 0) ? tok_pv_g : blk_pv_g;
    const int32_t* pi_base = (kind == 0) ? tok_pi_g : blk_pi_g;

    Pool mp{pool_val, pool_idx, 0, -INFINITY, target_k, kMergeCap};
    int p_idx = 0;
    bool pending_dma = false;
    const int c0 = (num_parts > 0) ? cnt_arr[first_slot * kDecodeSegQ + q] : 0;
    int unif_run = 0;
    if (c0 > 0) {
      while (unif_run < num_parts && (unif_run + 1) * c0 <= kMergeCap &&
             cnt_arr[(first_slot + unif_run) * kDecodeSegQ + q] == c0) {
        ++unif_run;
      }
    }
    if (unif_run >= 2) {
      const int64_t off0 =
          static_cast<int64_t>(first_slot) * slot_stride + q * target_k;
      __memcpy_async(pool_val,
                     pv_base + off0,
                     c0 * sizeof(float),
                     GDRAM2NRAM,
                     c0 * sizeof(float),
                     slot_stride * sizeof(float),
                     unif_run - 1);
      __memcpy_async(pool_idx,
                     pi_base + off0,
                     c0 * sizeof(int32_t),
                     GDRAM2NRAM,
                     c0 * sizeof(int32_t),
                     slot_stride * sizeof(int32_t),
                     unif_run - 1);
      mp.cnt = unif_run * c0;
      p_idx = unif_run;
      pending_dma = true;
    }
    for (; p_idx < num_parts; ++p_idx) {
      const int slot = first_slot + p_idx;
      const int c = cnt_arr[slot * kDecodeSegQ + q];
      if (c <= 0) continue;
      if (mp.cnt + c > kMergeCap) break;
      const int64_t off =
          static_cast<int64_t>(slot) * slot_stride + q * target_k;
      __memcpy_async(
          pool_val + mp.cnt, pv_base + off, c * sizeof(float), GDRAM2NRAM);
      __memcpy_async(
          pool_idx + mp.cnt, pi_base + off, c * sizeof(int32_t), GDRAM2NRAM);
      mp.cnt += c;
      pending_dma = true;
    }
    if (iota_built < kMergeCap && (mp.cnt > 4096 || p_idx < num_parts)) {
      __bang_add_scalar(iota + 4096, iota, 4096.0f, 4096);
      __sync_compute();
      iota_built = kMergeCap;
    }
    if (pending_dma) __sync_io();

    if (p_idx < num_parts) {
      if (mp.cnt > target_k) PoolCompact(mp, scratch, true);
      for (; p_idx < num_parts; ++p_idx) {
        const int slot = first_slot + p_idx;
        const int c = cnt_arr[slot * kDecodeSegQ + q];
        if (c <= 0) continue;
        const int c64 = (c + 63) / 64 * 64;
        if (c < c64) {
          __bang_write_value(chunk_val + (c & ~63), 64, -INFINITY);
          __bang_lt_scalar(valid_m, iota, static_cast<float>(c), c64);
          __sync_compute();
        }
        const int64_t off =
            static_cast<int64_t>(slot) * slot_stride + q * target_k;
        __memcpy_async(chunk_val, pv_base + off, c * sizeof(float), GDRAM2NRAM);
        __memcpy_async(
            chunk_idx, pi_base + off, c * sizeof(int32_t), GDRAM2NRAM);
        __sync_io();
        PoolOffer(mp,
                  chunk_val,
                  chunk_idx,
                  (c == c64) ? nullptr : valid_m,
                  c64,
                  mask_buf,
                  scratch);
        __sync_compute();
      }
    }

    if (mp.cnt > target_k) PoolCompact(mp, scratch, false);
    int32_t* g_out = (kind == 0)
                         ? (params.topk_indices + orig_row * kTopk)
                         : (params.candidate_ids_out + orig_row * kBlocks);
    if (mp.cnt == target_k) {
      __memcpy(g_out, mp.idx, target_k * sizeof(int32_t), NRAM2GDRAM);
      __sync_io();
      continue;
    }
    __bang_write_value(out32, target_k, -1);
    __sync_compute();
    if (mp.cnt > 0) {
      int32_t* dst = (kind == 0) ? (out32 + (kTopk - mp.cnt)) : out32;
      __memcpy(dst, mp.idx, mp.cnt * sizeof(int32_t), NRAM2NRAM);
      __sync();
    }
    __memcpy(g_out, out32, target_k * sizeof(int32_t), NRAM2GDRAM);
    __sync_io();
  }
}

#undef CARVE_FROM

int64_t DecodeWorkspaceBytes(int64_t ncap,
                             int64_t bcap,
                             int mode,
                             int cores,
                             int sched_override,
                             int logits_dtype) {
  (void)logits_dtype;
  return MakeDecodePlan(ncap, bcap, mode, cores, sched_override).bytes;
}

void LaunchPagedDecodeIndexScoreSelect(cnrtQueue_t queue,
                                       const DecodeParams& params,
                                       int clusters,
                                       int cores) {
  if (params.ncap <= 0) return;
  cnrtDim3_t dim_all{
      static_cast<unsigned>(cores), static_cast<unsigned>(clusters), 1};

  if (params.bcap <= 0) {
    DecodeFillNegOneKernel<<<dim_all, cnrtFuncTypeUnion1, queue>>>(params);
    return;
  }

  DecodeParams lp = params;
  const int64_t max_possible_n = lp.max_pages * lp.page.rows;

  if (lp.mode == kFilter) {
    const bool prefer_row_filter = (lp.plan.sched_override == 0 &&
                                    max_possible_n <= 1536 && lp.ncap <= 16);
    if (!lp.plan.funion || prefer_row_filter || lp.ncap > kDecodeRowCacheCap) {
      if (lp.plan.do_split &&
          (max_possible_n <= 1792 || lp.ncap > kDecodeRowCacheCap)) {
        lp.plan.do_split = 0;
      }
      DecodeFilterRowKernel<<<dim_all, cnrtFuncTypeUnion1, queue>>>(lp);
      if (lp.plan.do_split == 1) {
        DecodeMergeKernel<<<dim_all, cnrtFuncTypeUnion1, queue>>>(lp);
      }
      return;
    }
    if (lp.plan.do_split && lp.plan.sched_override == 0 &&
        (max_possible_n <= 1536 ||
         (max_possible_n <= 3072 && lp.ncap <= 24 && lp.plan.cores >= 32))) {
      lp.plan.do_split = 2;
    }
    DecodeFilterUnionKernel<<<dim_all, cnrtFuncTypeUnion1, queue>>>(lp);
    if (lp.plan.do_split == 1) {
      DecodeMergeKernel<<<dim_all, cnrtFuncTypeUnion1, queue>>>(lp);
    }
    return;
  }

  if (lp.plan.do_split &&
      (max_possible_n <= kTileSlots ||
       (max_possible_n <= kTopk &&
        (lp.bcap * 2 >= lp.plan.cores ||
         (lp.mode == kNone && lp.plan.sched_override == 0))) ||
       (lp.mode == kNone && lp.plan.sched_override == 0 && lp.ncap <= 4 &&
        max_possible_n <= 1024) ||
       (lp.mode == kSource && lp.plan.sched_override == 0 &&
        max_possible_n <= 1024 &&
        (lp.ncap <= 4 || (lp.ncap >= 8 && lp.ncap <= lp.bcap))))) {
    lp.plan.do_split = 0;
  }
  DecodeDenseScoreKernel<<<dim_all, cnrtFuncTypeUnion1, queue>>>(lp);
  if (lp.plan.do_split == 1) {
    DecodeMergeKernel<<<dim_all, cnrtFuncTypeUnion1, queue>>>(lp);
  }
}

}  // namespace xllm::kernel::mlu::bangc::score_select
